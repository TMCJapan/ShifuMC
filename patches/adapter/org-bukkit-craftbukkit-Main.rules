# アダプタ層の書き換え。vanilla の行ではない。
#
# 1.19.4 では tools/apply_classic_by_file.py が `--server-name` の受け口を
# preloadClasses の末尾へ当ててしまうので、無名の OptionParser の中へ移していた。
# 1.18.2 ではそのハンクが正しい位置(OptionParser の中、Main.java:157)に当たっているので
# 移す 2 規則は消した。**消さずに残すと、消す側の規則だけが当たって
# `--server-name` の受け口が丸ごと落ちる。**

# vanilla の Main は String[] を自分で解析する。Bukkit の Main が解析済みの
# OptionSet から、vanilla が受け付ける名前だけを引数列へ戻す。
file: org/bukkit/craftbukkit/Main.java
replace:
                net.minecraft.server.Main.main(options);
with:
                // Shifu - vanilla の Main は String[] を受ける
                final java.util.List<String> vanillaArgs = new java.util.ArrayList<>();
                for (final String flag : java.util.List.of("nogui", "initSettings", "demo", "bonusChest", "forceUpgrade", "eraseCache", "recreateRegionFiles", "safeMode", "jfrProfile")) {
                    if (options.has(flag)) {
                        vanillaArgs.add("--" + flag);
                    }
                }
                for (final String valued : java.util.List.of("universe", "world", "port", "serverId", "pidFile")) {
                    if (options.has(valued)) {
                        vanillaArgs.add("--" + valued);
                        vanillaArgs.add(String.valueOf(options.valueOf(valued)));
                    }
                }
                dev.shifu.event.ShifuBootstrap.options = options; // Shifu - 構築子の引数を増やせないので static で渡す
                net.minecraft.server.Main.main(vanillaArgs.toArray(new String[0]));
