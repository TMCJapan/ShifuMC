# アダプタ層の書き換え。vanilla の行ではない。

file: org/bukkit/craftbukkit/entity/CraftHumanEntity.java

count: 2
replace:
    nextContainerCounter()
with:
    shifuNextContainerCounter()

replace:
            if (!(this.getHandle() instanceof ServerPlayer player)) return false;
            boolean success = player.drop(dropAll);
with:
            if (!(this.getHandle() instanceof ServerPlayer player)) return false;
            // vanilla の ServerPlayer.drop(boolean) は void。Paper は「実際に落ちたか」を返す。
            // vanilla は removeFromSelected した stack を LivingEntity.drop へ渡すだけで、
            // その戻りが null になるのは stack が空のときだけ(createItemStackToDrop の
            // null 分岐も itemStack.isEmpty() のみ)。落とす前に選択枠を見れば同じ答えになる。
            final boolean success = !player.getInventory().getSelectedItem().isEmpty();
            player.drop(dropAll);
