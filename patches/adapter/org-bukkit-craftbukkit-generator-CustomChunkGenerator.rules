# アダプタ層の書き換え。vanilla の行ではない。

file: org/bukkit/craftbukkit/generator/CustomChunkGenerator.java

replace:
            random.setSeed(Mth.getSeed(x, "should-decoration".hashCode(), z) ^ level.getSeed());
            super.applyBiomeDecoration(level, chunk, structureManager, this.generator.shouldGenerateDecorations(this.world.getWorld(), new RandomSourceWrapper.RandomWrapper(random), x, z));
with:
            random.setSeed(Mth.getSeed(x, "should-decoration".hashCode(), z) ^ level.getSeed());
            // vanilla の applyBiomeDecoration は 3 引数。Paper は vanilla の中身を
            // addVanillaDecorations へ改名して、4 引数の版で「vanilla の装飾を出すか」を選び、
            // その後に BlockPopulator を回す形にしている。改名はできないので、
            // 出さない指定のときは vanilla の版を呼ばないことで同じにする。
            // super. で呼ぶので、この override へ戻ってくることはない。
            if (this.generator.shouldGenerateDecorations(this.world.getWorld(), new RandomSourceWrapper.RandomWrapper(random), x, z)) {
                super.applyBiomeDecoration(level, chunk, structureManager);
            }
            // Paper が 4 引数の版の後半でやっている BlockPopulator の呼び出し。
            // vanilla の 3 引数の版は回さないので、同じ順でここに書く。
            final org.bukkit.World bukkitWorld = level.getMinecraftWorld().getWorld();
            if (!bukkitWorld.getPopulators().isEmpty()) {
                final CraftLimitedRegion limitedRegion = new CraftLimitedRegion(level, chunk.getPos());
                for (final org.bukkit.generator.BlockPopulator populator : bukkitWorld.getPopulators()) {
                    final WorldgenRandom populatorRandom = new WorldgenRandom(new LegacyRandomSource(level.getSeed()));
                    populatorRandom.setDecorationSeed(level.getSeed(), x, z);
                    populator.populate(bukkitWorld, new RandomSourceWrapper.RandomWrapper(populatorRandom), x, z, limitedRegion);
                }
                limitedRegion.saveEntities();
                limitedRegion.breakLink();
            }
