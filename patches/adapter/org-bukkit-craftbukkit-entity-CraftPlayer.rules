# アダプタ層の書き換え。vanilla の行ではない。

file: org/bukkit/craftbukkit/entity/CraftPlayer.java

# vanilla の DiscardedPayload は成分が Identifier 1 つで、record の成分は足せない。
# 送る側は Shifu の payload に載せ替える。本文は
# patches/wire/net-minecraft-network-protocol-common-custom-CustomPacketPayload.rules が書く。
# sendPluginMessage と sendSupportedChannels(minecraft:register)は両方ここを通る。
replace:
    new DiscardedPayload(id, message)
with:
    new dev.shifu.event.PluginMessages.Outgoing(id, message)

# ServerPlayer.shifuClientWorldBorder(patches/hand)を、仮想の境界(Player.setWorldBorder)の
# 入れ外しと同じところで書く。ServerPlayer.tick は Paper の hasClientWorldBorder() の代わりに
# この欄を見て境界を進める(patches/events/generated の ServerPlayer)。
# clientWorldBorder を書き換えるのは setWorldBorder の 2 か所だけ。
# 読んだ位置: paper-server HEAD src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java:1150,1153
replace:
            this.clientWorldBorder = null;
with:
            this.clientWorldBorder = null;
            this.getHandle().shifuClientWorldBorder = false;

replace:
            this.clientWorldBorder = craftBorder;
with:
            this.clientWorldBorder = craftBorder;
            this.getHandle().shifuClientWorldBorder = true;

# リスポーンでは ShifuEvents.playerRespawned がこの CraftPlayer を新しい ServerPlayer へ
# 付け替える(craft.setHandle(fresh))。clientWorldBorder は CraftPlayer に残るので、新しい方の欄にも写す。
# 写さないと、仮想の境界を入れたまま死んだプレイヤーの境界がリスポーン後に進まなくなる。
# CraftPlayer は setHandle を持たず、CraftHumanEntity.setHandle(Player) が呼ばれる。
# 読んだ位置: paper-server HEAD src/main/java/org/bukkit/craftbukkit/entity/CraftHumanEntity.java:98
replace:
    @Override
    public WorldBorder getWorldBorder() {
with:
    @Override
    public void setHandle(final net.minecraft.world.entity.player.Player entity) {
        super.setHandle(entity);
        ((ServerPlayer) entity).shifuClientWorldBorder = this.clientWorldBorder != null;
    }
    @Override
    public WorldBorder getWorldBorder() {

# 隠したことを PlayerList.shifuVisibilityChanged(hand)に残す。立っているときだけ vanilla のチャットの配り方が
# Paper の版(見えない viewer には署名の無い文)へ回る(patches/wire/net-minecraft-server-players-PlayerList.rules)。
# addInvertedVisibility は、表示の既定が見える実体を隠すときと、見えない実体を見せるときの両方で通る。
# 読んだ位置: D:/.pw11/paper-server/src/main/java HEAD:org/bukkit/craftbukkit/entity/CraftPlayer.java:1865,2059
file: org/bukkit/craftbukkit/entity/CraftPlayer.java
replace:
        this.invertedVisibilityEntities.put(entity.getUniqueId(), invertedPlugins);
with:
        this.invertedVisibilityEntities.put(entity.getUniqueId(), invertedPlugins);
        net.minecraft.server.players.PlayerList.shifuVisibilityChanged = true; // Shifu
