# アダプタ層の書き換え。vanilla の行ではない。

file: org/bukkit/craftbukkit/CraftWorld.java

# 1.20.6 から写した STANDARD → BLOCK の置き換えは入れない。1.19.4 の CraftWorld.createExplosion は
# explosionType の変数を持たず、`breakBlocks ? MOB : NONE` を直に渡している(STANDARD を使わない)ので、
# 当たる行が無く、--report 無しの patch_adapter が止まっていた。
# 読んだ位置: D:/.pw194/Paper-Server の HEAD:src/main/java/org/bukkit/craftbukkit/CraftWorld.java:909,914

# vanilla の ServerLevel.serverLevelData は ServerLevelData 型。Paper は PrimaryLevelData に
# 狭めているので、worldGenOptions と settings は素の型では見えない。呼ぶ側で戻す。
# vanilla の nether / end は DerivedLevelData を持つ(Multiverse-Core が canGenerateStructures で
# ClassCastException)。PrimaryLevelData でなければサーバーの WorldData(3 次元で 1 つ)を読む。
# Bukkit の createWorld で作った世界は CraftServer が PrimaryLevelData を持たせるのでそのまま。
count: 1
replace:
    world.serverLevelData.worldGenOptions()
with:
    ((world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) ? (net.minecraft.world.level.storage.PrimaryLevelData) world.serverLevelData : (net.minecraft.world.level.storage.PrimaryLevelData) world.getServer().getWorldData()).worldGenOptions()

# 同上。1.21.11 の vanilla は LevelSettings.hardcore が public な欄なので、そのまま書ける
replace:
    world.serverLevelData.settings.hardcore = hardcore;
with:
    ((world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) ? (net.minecraft.world.level.storage.PrimaryLevelData) world.serverLevelData : (net.minecraft.world.level.storage.PrimaryLevelData) world.getServer().getWorldData()).settings.hardcore = hardcore;

# vanilla の PrimaryLevelData は 3 つの次元で 1 つなので、getLevelName() は 3 つとも同じ。
# Bukkit の世界は名前で引くので、次元ごとに分けた名前を返す(ServerLevel.bukkitName)。
# 1.19.4 の CraftWorld.getName() は this. 無しで書いてある。this. 付きの規則は当たらず、3 つの次元が全部
# level-name で登録されて最後(the_end)だけが Bukkit.getWorld("world") で返っていた(HuskHomes の /home が
# the_end へ飛び、cross-world の respawn で落ちる。Multiverse の "WorldConfig ... already exists" も同じ原因)。
replace:
        return world.serverLevelData.getLevelName();
with:
        return world.bukkitName; // Shifu - vanilla は次元でフォルダを分けないので、名前は ServerLevel が持つ

# 世界ごとのスポーン。vanilla の nether / end の serverLevelData は DerivedLevelData で、setSpawn / getSharedSpawnPos が
# 主世界のものへ通る。主世界以外は ServerLevel の次元別ファイルに保存して読む。
replace:
        BlockPos spawn = this.world.getSharedSpawnPos();
with:
        BlockPos spawn = this.world.shifuGetSpawn() != null ? this.world.shifuGetSpawn() : this.world.getSharedSpawnPos(); // Shifu

replace:
        float yaw = this.world.getSharedSpawnAngle();
with:
        float yaw = this.world.shifuGetSpawn() != null ? this.world.shifuGetSpawnAngle() : this.world.getSharedSpawnAngle(); // Shifu

replace:
            world.setDefaultSpawnPos(new BlockPos(x, y, z), angle); // Paper - use ServerLevel#setDefaultSpawnPos
with:
            if (world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) { world.setDefaultSpawnPos(new BlockPos(x, y, z), angle); } else { final Location shifuBefore = dev.shifu.event.PlayerEvents.spawnBefore(world); world.shifuSetSpawn(new BlockPos(x, y, z), angle); dev.shifu.event.PlayerEvents.spawnChanged(world, shifuBefore); } // Shifu - 主世界以外は次元フォルダへ永続化。SpawnChangeEvent は主世界なら vanilla の setDefaultSpawnPos に差し込んだ所で出るので、こちらでも同じ 2 つを呼ぶ

# setKeepSpawnInMemory も世界のスポーンから ticket を立てる。同じく主世界以外は ServerLevel の
# 次元別ファイルの方を見る(見ないと、地獄の spawn を動かしたあとの外し方が主世界の座標になる)。
replace:
        BlockPos chunkcoordinates = this.world.getSharedSpawnPos();
with:
        BlockPos chunkcoordinates = this.world.shifuGetSpawn() != null ? this.world.shifuGetSpawn() : this.world.getSharedSpawnPos(); // Shifu

# regenerateChunk は最後に ThreadedLevelLightEngine.relight(Starlight)で周りの 9 チャンクの光を計算し直す。
# vanilla の ThreadedLevelLightEngine に relight は無く、ブロックを消して生成し直したあとで
# NoSuchMethodError になっていた(チャンクは作り直され、光は古いまま残る)。
# この版の World.regenerateChunk の javadoc は「@return Whether the chunk was actually regenerated」なので、
# 何もせずに false を返す。新しい Paper は UnsupportedOperationException を投げるが、この版の API には書かれていない。
# 読んだ位置: /d/.pw194/Paper-API/src/main/java/org/bukkit/World.java の regenerateChunk、
# /d/.pw194/Paper-Server(HEAD)src/main/java/org/bukkit/craftbukkit/CraftWorld.java の regenerateChunk
replace:
        // Paper start - implement regenerateChunk method
with:
        if (true) return false; // Shifu - vanilla の光のエンジンに relight が無い
        // Paper start - implement regenerateChunk method

# loadChunk(x, z, generate=false) の「ディスクにあるか」の下見。Paper は ChunkMap.regionFileCache(RegionFileStorage)から
# RegionFile を取って hasChunk を見るが、Shifu の ChunkStorage.regionFileCache は宣言(shim)だけで誰も入れないので null で、
# 読み込まれていないチャンクでここに来ると NullPointerException で落ちていた。入れたとしても、vanilla の RegionFileStorage は
# IOWorker の糸だけが触る前提で鍵が無く、main から regionCache を触ると IOWorker と重なる(Paper は自分の版を synchronized にしている)。
# 下見は外し、すぐ下の getChunk(x, z, EMPTY, true) の結果で決める。vanilla の EMPTY の段はディスクから読むだけで
# (無ければ空の ProtoChunk)、ImposterProtoChunk / LevelChunk でなければ false を返すところは Paper の行のまま残る。
# 読んだ位置: D:/.pw194/Paper-Server HEAD src/main/java/org/bukkit/craftbukkit/CraftWorld.java:564
file: org/bukkit/craftbukkit/CraftWorld.java
replace:
            net.minecraft.world.level.chunk.storage.RegionFile file;
            try {
                file = world.getChunkSource().chunkMap.regionFileCache.getRegionFile(chunkPos, false);
            } catch (java.io.IOException ex) {
                throw new RuntimeException(ex);
            }

            ChunkStatus status = file.getStatusIfCached(x, z);
            if (!file.hasChunk(chunkPos) || (status != null && status != ChunkStatus.FULL)) {
                return false;
            }
with:
            // Shifu - RegionFile の下見は外す(regionFileCache は null。下の EMPTY の読み込みで決まる)
