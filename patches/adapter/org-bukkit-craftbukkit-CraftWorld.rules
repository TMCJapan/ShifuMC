# アダプタ層の書き換え。vanilla の行ではない。

file: org/bukkit/craftbukkit/CraftWorld.java

# 中身は元案の通りだが、**replace を 2 行に広げた**
replace:
            net.minecraft.world.entity.Entity entity = (source == null) ? null : ((CraftEntity) source).getHandle();
            return !this.world.explode0(entity, Explosion.getDefaultDamageSource(this.world, entity), null, x, y, z, power, setFire, explosionType, ParticleTypes.EXPLOSION, ParticleTypes.EXPLOSION_EMITTER, Level.DEFAULT_EXPLOSION_BLOCK_PARTICLES, SoundEvents.GENERIC_EXPLODE, configurator).wasCanceled; // Paper - expand explosion API
with:
            net.minecraft.world.entity.Entity entity = (source == null) ? null : ((CraftEntity) source).getHandle();
            // vanilla の explode は void で爆発を返さない。ServerExplosion を返す explode0 と wasCanceled は Paper の追加。
            // vanilla の ServerLevel.explode と同じ手順(BlockInteraction を決める、ServerExplosion.explode、近くの
            // プレイヤーへの packet)をここで組む。ServerLevel.explode を通らないので、そこに差し込んだ
            // explosionCancelled もここで読み、取り消されたら packet を送らず false を返す(Paper と同じ戻り値)。
            // BLOCK は上の STANDARD の置き換えからだけ来る(発生源が無く、壊す)。CraftBukkit の STANDARD は常に DESTROY で、
            // vanilla の BLOCK は blockExplosionDropDecay で DESTROY_WITH_DECAY になり、ドロップが減っていた。
            // ほかの場合は vanilla の switch と getDestroyType と同じ。
            // configurator が書き換える excludeSourceFromDamage は Paper の追加で、vanilla は常に発生源を除く。
            // 読んだ位置: <PW>/paper-server/src/minecraft/java の Mache コミットの net/minecraft/server/level/ServerLevel.java の explode と getDestroyType
            final Explosion.BlockInteraction blockInteraction = switch (explosionType) {
                case NONE -> Explosion.BlockInteraction.KEEP;
                case BLOCK -> Explosion.BlockInteraction.DESTROY;
                case MOB -> this.world.getGameRules().get(net.minecraft.world.level.gamerules.GameRules.MOB_GRIEFING)
                    ? (this.world.getGameRules().get(net.minecraft.world.level.gamerules.GameRules.MOB_EXPLOSION_DROP_DECAY) ? Explosion.BlockInteraction.DESTROY_WITH_DECAY : Explosion.BlockInteraction.DESTROY)
                    : Explosion.BlockInteraction.KEEP;
                case TNT -> this.world.getGameRules().get(net.minecraft.world.level.gamerules.GameRules.TNT_EXPLOSION_DROP_DECAY) ? Explosion.BlockInteraction.DESTROY_WITH_DECAY : Explosion.BlockInteraction.DESTROY;
                case TRIGGER -> Explosion.BlockInteraction.TRIGGER_BLOCK;
            };
            final Vec3 center = new Vec3(x, y, z);
            final net.minecraft.world.level.ServerExplosion explosion = new net.minecraft.world.level.ServerExplosion(this.world, entity, Explosion.getDefaultDamageSource(this.world, entity), null, center, power, setFire, blockInteraction);
            final int blockCount = explosion.explode();
            if (dev.shifu.event.ShifuEvents.explosionCancelled(explosion)) {
                return false;
            }
            final net.minecraft.core.particles.ParticleOptions particle = explosion.isSmall() ? ParticleTypes.EXPLOSION : ParticleTypes.EXPLOSION_EMITTER;
            for (net.minecraft.server.level.ServerPlayer player : this.world.players()) {
                if (player.distanceToSqr(center) < 4096.0) {
                    player.connection.send(new net.minecraft.network.protocol.game.ClientboundExplodePacket(center, power, blockCount, java.util.Optional.ofNullable(explosion.getHitPlayers().get(player)), particle, SoundEvents.GENERIC_EXPLODE, Level.DEFAULT_EXPLOSION_BLOCK_PARTICLES));
                }
            }
            return true;

# STANDARD は CraftBukkit が足した定数で、enum に定数は足さない。BLOCK に置き換え、上の switch で DESTROY に写す
replace:
                explosionType = net.minecraft.world.level.Level.ExplosionInteraction.STANDARD; // Break blocks, don't decay drops
with:
                explosionType = net.minecraft.world.level.Level.ExplosionInteraction.BLOCK; // Shifu - STANDARD の代わり。下の switch で DESTROY にする

# 元案から 2 点直した
replace:
            Vec3 endPos = startPos.add(dir.getX(), dir.getY(), dir.getZ());
            HitResult hitResult = this.getHandle().clip(new ClipContext(startPos, endPos, ClipContext.Block.values()[blockCollisionMode.ordinal()], CraftFluidCollisionMode.toFluid(fluidCollisionMode), CollisionContext.empty()), canCollide);
with:
            Vec3 endPos = startPos.add(dir.getX(), dir.getY(), dir.getZ());
            // canCollide を取る clip は Paper が BlockGetter に足したもの。vanilla の clip(ClipContext) の走査を写して述語だけ足す。
            final ClipContext clipContext = new ClipContext(startPos, endPos, ClipContext.Block.values()[blockCollisionMode.ordinal()], CraftFluidCollisionMode.toFluid(fluidCollisionMode), CollisionContext.empty());
            final HitResult hitResult;
            if (canCollide == null) {
                hitResult = this.getHandle().clip(clipContext);
            } else {
                hitResult = net.minecraft.world.level.BlockGetter.<net.minecraft.world.phys.BlockHitResult, ClipContext>traverseBlocks(startPos, endPos, clipContext, (context, pos) -> {
                    if (!canCollide.test(org.bukkit.craftbukkit.block.CraftBlock.at(this.getHandle(), pos))) {
                        return null;
                    }
                    final net.minecraft.world.level.block.state.BlockState blockState = this.getHandle().getBlockState(pos);
                    final Vec3 from = context.getFrom();
                    final Vec3 to = context.getTo();
                    final net.minecraft.world.phys.BlockHitResult blockResult = this.getHandle().clipWithInteractionOverride(from, to, pos, context.getBlockShape(blockState, this.getHandle(), pos), blockState);
                    final net.minecraft.world.phys.BlockHitResult liquidResult = context.getFluidShape(this.getHandle().getFluidState(pos), this.getHandle(), pos).clip(from, to, pos);
                    final double blockDistanceSquared = blockResult == null ? Double.MAX_VALUE : from.distanceToSqr(blockResult.getLocation());
                    final double liquidDistanceSquared = liquidResult == null ? Double.MAX_VALUE : from.distanceToSqr(liquidResult.getLocation());
                    return blockDistanceSquared <= liquidDistanceSquared ? blockResult : liquidResult;
                }, context -> {
                    final Vec3 delta = context.getFrom().subtract(context.getTo());
                    return net.minecraft.world.phys.BlockHitResult.miss(context.getTo(), net.minecraft.core.Direction.getApproximateNearest(delta.x, delta.y, delta.z), BlockPos.containing(context.getTo()));
                });
            }

# CraftWorld の構築子が this.world.paperConfig() を 4 回読む
replace:
            // Paper start - per world spawn limits
            for (SpawnCategory spawnCategory : SpawnCategory.values()) {
                if (CraftSpawnCategory.isValidForLimits(spawnCategory)) {
                    setSpawnLimit(spawnCategory, this.world.paperConfig().entities.spawning.spawnLimits.getInt(CraftSpawnCategory.toNMS(spawnCategory)));
                }
            }
            // Paper end - per world spawn limits

            // Paper start - per world void damage height
            this.voidDamageEnabled = this.world.paperConfig().environment.voidDamageAmount.enabled();
            this.voidDamageMinBuildHeightOffset = this.world.paperConfig().environment.voidDamageMinBuildHeightOffset;
            this.voidDamageAmount = (float) this.world.paperConfig().environment.voidDamageAmount.or(0);
            // Paper end - per world void damage height
with:
            // Shifu - paperConfig() を読む 2 ブロックを落とした。Level.paperConfig は Shifu では null。
            // 湧き上限は spawnCategoryLimit を空のままにすると getSpawnLimitUnsafe が server 側の値へ落ちる。
            // voidDamage の 3 つは Paper の World API 用で、vanilla の奈落ダメージは Entity 側にある。

# vanilla の ServerLevel.serverLevelData は ServerLevelData 型。Paper は PrimaryLevelData に
# 狭めているので、worldGenOptions と settings は素の型では見えない。呼ぶ側で戻す。
# vanilla の nether / end は DerivedLevelData を持つ(Multiverse-Core が canGenerateStructures で
# ClassCastException)。PrimaryLevelData でなければサーバーの WorldData(3 次元で 1 つ)を読む。
# Bukkit の createWorld で作った世界は CraftServer が PrimaryLevelData を持たせるのでそのまま。
count: 2
replace:
    this.world.serverLevelData.worldGenOptions()
with:
    ((this.world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) ? (net.minecraft.world.level.storage.PrimaryLevelData) this.world.serverLevelData : (net.minecraft.world.level.storage.PrimaryLevelData) this.world.getServer().getWorldData()).worldGenOptions()

# 同上。1.21.11 の vanilla は LevelSettings.hardcore が public な欄なので、そのまま書ける
replace:
    this.world.serverLevelData.settings.hardcore = hardcore;
with:
    ((this.world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) ? (net.minecraft.world.level.storage.PrimaryLevelData) this.world.serverLevelData : (net.minecraft.world.level.storage.PrimaryLevelData) this.world.getServer().getWorldData()).settings.hardcore = hardcore;

# vanilla の PrimaryLevelData は 3 つの次元で 1 つなので、getLevelName() は 3 つとも同じ。
# Bukkit の世界は名前で引くので、次元ごとに分けた名前を返す(ServerLevel.bukkitName)。
replace:
        return this.world.serverLevelData.getLevelName();
with:
        return this.world.bukkitName; // Shifu - vanilla は次元でフォルダを分けないので、名前は ServerLevel が持つ

# 世界ごとのスポーン。vanilla の nether / end の serverLevelData は DerivedLevelData で、setSpawn / getRespawnData が
# 主世界のものへ通る(次元ごと書き換わり、新しいプレイヤーが nether に参加した)。主世界以外は次元別ファイルへ保存する。
replace:
        final LevelData.RespawnData respawnData = this.world.serverLevelData.getRespawnData();
with:
        final LevelData.RespawnData respawnData = this.world.shifuGetSpawn() != null ? this.world.shifuGetSpawn() : this.world.serverLevelData.getRespawnData(); // Shifu

replace:
            this.world.serverLevelData.setSpawn(LevelData.RespawnData.of(this.world.dimension(), new BlockPos(x, y, z), yaw, pitch));
with:
            if (this.world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) { this.world.serverLevelData.setSpawn(LevelData.RespawnData.of(this.world.dimension(), new BlockPos(x, y, z), yaw, pitch)); } else { this.world.shifuSetSpawn(LevelData.RespawnData.of(this.world.dimension(), new BlockPos(x, y, z), yaw, pitch)); } // Shifu - 主世界以外は次元フォルダへ永続化
