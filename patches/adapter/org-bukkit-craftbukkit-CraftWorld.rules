# アダプタ層の書き換え。vanilla の行ではない。

file: org/bukkit/craftbukkit/CraftWorld.java

# STANDARD は CraftBukkit が足した定数で、enum に定数は足さない。BLOCK に置き換え、下の規則で DESTROY に写す
replace:
                explosionType = net.minecraft.world.level.Level.ExplosionInteraction.STANDARD; // Break blocks, don't decay drops
with:
                explosionType = net.minecraft.world.level.Level.ExplosionInteraction.BLOCK; // Shifu - STANDARD の代わり。下で DESTROY にする

# 発生源が無く壊す爆発(上の BLOCK)。CraftBukkit の STANDARD は常に DESTROY だが、vanilla の Level.explode は
# BLOCK を blockExplosionDropDecay で DESTROY_WITH_DECAY にするので、ドロップが減っていた。
# vanilla の Level.explode(13 引数)と ServerLevel.explode と同じ手順(Explosion を作る、explode、
# finalizeExplosion(false)、近くのプレイヤーへの packet)を DESTROY で組む。DESTROY は interactsWithBlocks が
# true なので clearToBlow は通らない。取り消しは Shifu が Explosion.finalizeExplosion に差し込んだ
# ShifuEvents.explode が wasCanceled に書く。
# 読んだ位置: D:/.pw206/vanilla-src/minecraft/java/net/minecraft/world/level/Level.java:641-671、
#            net/minecraft/server/level/ServerLevel.java:1126-1166
replace:
        return !this.world.explode(source == null ? null : ((CraftEntity) source).getHandle(), x, y, z, power, setFire, explosionType).wasCanceled;
with:
        if (explosionType == net.minecraft.world.level.Level.ExplosionInteraction.BLOCK) {
            final net.minecraft.world.entity.Entity entity = source == null ? null : ((CraftEntity) source).getHandle();
            final net.minecraft.world.level.Explosion explosion = new net.minecraft.world.level.Explosion(this.world, entity, net.minecraft.world.level.Explosion.getDefaultDamageSource(this.world, entity), null, x, y, z, power, setFire, net.minecraft.world.level.Explosion.BlockInteraction.DESTROY, net.minecraft.core.particles.ParticleTypes.EXPLOSION, net.minecraft.core.particles.ParticleTypes.EXPLOSION_EMITTER, net.minecraft.sounds.SoundEvents.GENERIC_EXPLODE);
            explosion.explode();
            explosion.finalizeExplosion(false);
            for (ServerPlayer player : this.world.players()) {
                if (player.distanceToSqr(x, y, z) < 4096.0) {
                    player.connection.send(new net.minecraft.network.protocol.game.ClientboundExplodePacket(x, y, z, power, explosion.getToBlow(), explosion.getHitPlayers().get(player), explosion.getBlockInteraction(), explosion.getSmallExplosionParticles(), explosion.getLargeExplosionParticles(), explosion.getExplosionSound()));
                }
            }
            return !explosion.wasCanceled;
        }
        return !this.world.explode(source == null ? null : ((CraftEntity) source).getHandle(), x, y, z, power, setFire, explosionType).wasCanceled;

# vanilla の ServerLevel.serverLevelData は ServerLevelData 型。Paper は PrimaryLevelData に
# 狭めているので、worldGenOptions と settings は素の型では見えない。呼ぶ側で戻す。
# vanilla の nether / end は DerivedLevelData を持つ(Multiverse-Core が canGenerateStructures で
# ClassCastException)。PrimaryLevelData でなければサーバーの WorldData(3 次元で 1 つ)を読む。
# Bukkit の createWorld で作った世界は CraftServer が PrimaryLevelData を持たせるのでそのまま。
count: 1
replace:
    this.world.serverLevelData.worldGenOptions()
with:
    ((this.world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) ? (net.minecraft.world.level.storage.PrimaryLevelData) this.world.serverLevelData : (net.minecraft.world.level.storage.PrimaryLevelData) this.world.getServer().getWorldData()).worldGenOptions()

# 同上。1.21.11 の vanilla は LevelSettings.hardcore が public な欄なので、そのまま書ける
replace:
    this.world.serverLevelData.settings.hardcore = hardcore;
with:
    ((this.world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) ? (net.minecraft.world.level.storage.PrimaryLevelData) this.world.serverLevelData : (net.minecraft.world.level.storage.PrimaryLevelData) this.world.getServer().getWorldData()).settings.hardcore = hardcore;

# vanilla の PrimaryLevelData は 3 つの次元で 1 つなので、getLevelName() は 3 つとも同じ。
# Bukkit の世界は名前で引くので、次元ごとに分けた名前を返す(ServerLevel.bukkitName)。
replace:
        return this.world.serverLevelData.getLevelName();
with:
        return this.world.bukkitName; // Shifu - vanilla は次元でフォルダを分けないので、名前は ServerLevel が持つ

# 世界ごとのスポーン。vanilla の nether / end の serverLevelData は DerivedLevelData で、setSpawn / getSharedSpawnPos が
# 主世界のものへ通る。主世界以外は ServerLevel の次元別ファイルに保存して読む。
replace:
        BlockPos spawn = this.world.getSharedSpawnPos();
with:
        BlockPos spawn = this.world.shifuGetSpawn() != null ? this.world.shifuGetSpawn() : this.world.getSharedSpawnPos(); // Shifu

replace:
        float yaw = this.world.getSharedSpawnAngle();
with:
        float yaw = this.world.shifuGetSpawn() != null ? this.world.shifuGetSpawnAngle() : this.world.getSharedSpawnAngle(); // Shifu

replace:
            this.world.setDefaultSpawnPos(new BlockPos(x, y, z), angle); // Paper - use ServerLevel#setDefaultSpawnPos
with:
            if (this.world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) { this.world.setDefaultSpawnPos(new BlockPos(x, y, z), angle); } else { final Location shifuBefore = dev.shifu.event.PlayerEvents.spawnBefore(this.world); this.world.shifuSetSpawn(new BlockPos(x, y, z), angle); dev.shifu.event.PlayerEvents.spawnChanged(this.world, shifuBefore); } // Shifu - 主世界以外は次元フォルダへ永続化。SpawnChangeEvent は主世界なら vanilla の setDefaultSpawnPos に差し込んだ所で出るので、こちらでも同じ 2 つを呼ぶ

# loadChunk(x, z, generate=false) の「ディスクにあるか」の下見。Paper は ChunkMap.regionFileCache(RegionFileStorage)から
# RegionFile を取って hasChunk を見るが、Shifu の ChunkStorage.regionFileCache は宣言(shim)だけで誰も入れないので null で、
# 読み込まれていないチャンクでここに来ると NullPointerException で落ちていた。入れたとしても、vanilla の RegionFileStorage は
# IOWorker の糸だけが触る前提で鍵が無く、main から regionCache を触ると IOWorker と重なる(Paper は自分の版を synchronized にしている)。
# 下見は外し、すぐ下の getChunk(x, z, EMPTY, true) の結果で決める。vanilla の EMPTY の段はディスクから読むだけで
# (無ければ空の ProtoChunk)、ImposterProtoChunk / LevelChunk でなければ false を返すところは Paper の行のまま残る。
# 読んだ位置: D:/.pw206/Paper-Server HEAD src/main/java/org/bukkit/craftbukkit/CraftWorld.java:612
file: org/bukkit/craftbukkit/CraftWorld.java
replace:
            net.minecraft.world.level.chunk.storage.RegionFile file;
            try {
                file = world.getChunkSource().chunkMap.regionFileCache.getRegionFile(chunkPos, false);
            } catch (java.io.IOException ex) {
                throw new RuntimeException(ex);
            }

            ChunkStatus status = file.getStatusIfCached(x, z);
            if (!file.hasChunk(chunkPos) || (status != null && status != ChunkStatus.FULL)) {
                return false;
            }
with:
            // Shifu - RegionFile の下見は外す(regionFileCache は null。下の EMPTY の読み込みで決まる)
