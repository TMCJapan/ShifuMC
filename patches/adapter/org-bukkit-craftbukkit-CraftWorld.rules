# アダプタ層の書き換え。vanilla の行ではない。
#
# 1.19.4 から消した規則:
#   Level.ExplosionInteraction.STANDARD の置き換え — 1.18.2 の CraftWorld.createExplosion は
#   vanilla の Explosion.BlockInteraction.BREAK / NONE を渡していて、CraftBukkit が足した
#   定数を使っていない。

file: org/bukkit/craftbukkit/CraftWorld.java

# vanilla の ServerLevel.serverLevelData は ServerLevelData 型。Paper は PrimaryLevelData に
# 狭めているので、worldGenSettings と settings は素の型では見えない。呼ぶ側で戻す。
count: 1
replace:
    world.serverLevelData.worldGenSettings()
with:
    ((net.minecraft.world.level.storage.PrimaryLevelData) world.serverLevelData).worldGenSettings()

# 同上
replace:
    world.serverLevelData.settings.hardcore = hardcore;
with:
    ((net.minecraft.world.level.storage.PrimaryLevelData) world.serverLevelData).settings.hardcore = hardcore;

# vanilla の PrimaryLevelData は 3 つの次元で 1 つなので、getLevelName() は 3 つとも同じ。
# Bukkit の世界は名前で引くので、次元ごとに分けた名前を返す(ServerLevel.bukkitName)。
replace:
        return world.serverLevelData.getLevelName();
with:
        return world.bukkitName; // Shifu - vanilla は次元でフォルダを分けないので、名前は ServerLevel が持つ
