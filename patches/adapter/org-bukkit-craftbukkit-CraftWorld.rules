# アダプタ層の書き換え。vanilla の行ではない。

file: org/bukkit/craftbukkit/CraftWorld.java

# 元案の通りで通す
replace:
                explosionType = net.minecraft.world.level.Level.ExplosionInteraction.STANDARD; // Break blocks, don't decay drops
with:
                explosionType = net.minecraft.world.level.Level.ExplosionInteraction.BLOCK; // Shifu - STANDARD は CraftBukkit が足した定数。enum に定数は足さないので vanilla の BLOCK を使う

# vanilla の ServerLevel.serverLevelData は ServerLevelData 型。Paper は PrimaryLevelData に
# 狭めているので、worldGenOptions と settings は素の型では見えない。呼ぶ側で戻す。
# vanilla の nether / end は DerivedLevelData を持つ(Multiverse-Core が canGenerateStructures で
# ClassCastException)。PrimaryLevelData でなければサーバーの WorldData(3 次元で 1 つ)を読む。
# Bukkit の createWorld で作った世界は CraftServer が PrimaryLevelData を持たせるのでそのまま。
count: 1
replace:
    world.serverLevelData.worldGenOptions()
with:
    ((world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) ? (net.minecraft.world.level.storage.PrimaryLevelData) world.serverLevelData : (net.minecraft.world.level.storage.PrimaryLevelData) world.getServer().getWorldData()).worldGenOptions()

# 同上。1.21.11 の vanilla は LevelSettings.hardcore が public な欄なので、そのまま書ける
replace:
    world.serverLevelData.settings.hardcore = hardcore;
with:
    ((world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) ? (net.minecraft.world.level.storage.PrimaryLevelData) world.serverLevelData : (net.minecraft.world.level.storage.PrimaryLevelData) world.getServer().getWorldData()).settings.hardcore = hardcore;

# vanilla の PrimaryLevelData は 3 つの次元で 1 つなので、getLevelName() は 3 つとも同じ。
# Bukkit の世界は名前で引くので、次元ごとに分けた名前を返す(ServerLevel.bukkitName)。
# 1.19.4 の CraftWorld.getName() は this. 無しで書いてある。this. 付きの規則は当たらず、3 つの次元が全部
# level-name で登録されて最後(the_end)だけが Bukkit.getWorld("world") で返っていた(HuskHomes の /home が
# the_end へ飛び、cross-world の respawn で落ちる。Multiverse の "WorldConfig ... already exists" も同じ原因)。
replace:
        return world.serverLevelData.getLevelName();
with:
        return world.bukkitName; // Shifu - vanilla は次元でフォルダを分けないので、名前は ServerLevel が持つ

# 世界ごとのスポーン。vanilla の nether / end の serverLevelData は DerivedLevelData で、setSpawn / getSharedSpawnPos が
# 主世界のものへ通る。主世界以外は ServerLevel.shifuSpawn(hand)に置いて読む。
replace:
        BlockPos spawn = this.world.getSharedSpawnPos();
with:
        BlockPos spawn = this.world.shifuSpawn != null ? this.world.shifuSpawn : this.world.getSharedSpawnPos(); // Shifu

replace:
        float yaw = this.world.getSharedSpawnAngle();
with:
        float yaw = this.world.shifuSpawn != null ? this.world.shifuSpawnAngle : this.world.getSharedSpawnAngle(); // Shifu

replace:
            world.setDefaultSpawnPos(new BlockPos(x, y, z), angle); // Paper - use ServerLevel#setDefaultSpawnPos
with:
            if (world.serverLevelData instanceof net.minecraft.world.level.storage.PrimaryLevelData) { world.setDefaultSpawnPos(new BlockPos(x, y, z), angle); } else { world.shifuSpawn = new BlockPos(x, y, z); world.shifuSpawnAngle = angle; } // Shifu - 主世界以外は世界ごとの欄へ
