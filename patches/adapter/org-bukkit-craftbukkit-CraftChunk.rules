# アダプタ層の書き換え。vanilla の行ではない。

file: org/bukkit/craftbukkit/CraftChunk.java

# LevelChunk.level の型は vanilla では Level。Paper は ServerLevel に狭めている。
# 宣言の型の変更は追加では届かないので、読む側で降ろす。
replace:
        this.level = chunk.level;
with:
        this.level = (net.minecraft.server.level.ServerLevel) chunk.level; // Shifu - 欄の型は vanilla のまま
