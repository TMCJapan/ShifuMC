# アダプタ層の書き換え。vanilla の行ではない。
#
# Spigot 向けに組んだプラグイン(NMS を EntityPlayer の名前、欄とメソッドを難読化名で呼ぶ)を
# 読み込むときに mojang 名へ写す(dev.shifu.remap.PluginRemapper、表は
# tools/make_plugin_mappings.py)。Paper 1.18.2 / 1.19.4 はプラグインを写さないので、
# 写さなければ ClassNotFoundException / NoSuchMethodError になる。

# クラスを定義する直前。Commodore(古い API の書き換え)より前に写す。
file: org/bukkit/craftbukkit/util/CraftMagicNumbers.java
replace:
            clazz = Commodore.convert(clazz, !CraftMagicNumbers.isLegacy(pdf));
with:
            clazz = dev.shifu.remap.PluginRemapper.remap(pdf, path, clazz); // Shifu - spigot 名 -> mojang 名
            clazz = Commodore.convert(clazz, !CraftMagicNumbers.isLegacy(pdf));

# 継承関係の控え。CraftServer.loadPlugins では遅い: paper-plugin.yml のプラグインの
# bootstrapper は Bootstrap.bootStrap の中の LaunchEntryPointHandler.enterBootstrappers で
# PaperSimplePluginClassLoader が定義するので、そこまでに控えが無いと親を辿れないまま写る
# (読んだ位置: Paper-Server src/main/java/net/minecraft/server/Bootstrap.java の
# BuiltInRegistries.bootStrap のラムダ)。
# PluginInitializerManager.load は Main が bootStrap より先に呼ぶ。update フォルダの入れ替えは
# registerProvidersFromSource の中の FileProviderSource.checkUpdate が済ませているので、
# plugins フォルダの jar が実際に読まれる jar になっている。
file: io/papermc/paper/plugin/PluginInitializerManager.java
replace:
        io.papermc.paper.plugin.util.EntrypointUtil.registerProvidersFromSource(io.papermc.paper.plugin.provider.source.PluginFlagProviderSource.INSTANCE, files);
with:
        io.papermc.paper.plugin.util.EntrypointUtil.registerProvidersFromSource(io.papermc.paper.plugin.provider.source.PluginFlagProviderSource.INSTANCE, files);
        dev.shifu.remap.PluginRemapper.index(pluginSystem.pluginDirectoryPath().toFile(), null, files); // Shifu

# Paper のプラグイン(paper-plugin.yml。FancyNpcs / FancyHolograms)は PaperSimplePluginClassLoader が
# 定義する。processClass を通らないので、同じ場所で写す。
file: io/papermc/paper/plugin/entrypoint/classloader/PaperSimplePluginClassLoader.java
replace:
        classBytes = ClassloaderBytecodeModifier.bytecodeModifier().modify(this.configuration, classBytes);
with:
        classBytes = dev.shifu.remap.PluginRemapper.remap(this.configuration.getName(), path, classBytes); // Shifu - spigot 名 -> mojang 名
        classBytes = ClassloaderBytecodeModifier.bytecodeModifier().modify(this.configuration, classBytes);
