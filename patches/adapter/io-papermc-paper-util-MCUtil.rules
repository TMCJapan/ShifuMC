# MOD が同梱する Paper のクラスが呼ぶ、今の Paper に無いメソッドを足す。
#
# Shifu の game jar には Paper と Bukkit が入っている。Knot のクラスパスでは
# game jar が MOD より先に来るようにしてあるので(ShifuGameProvider.initialize)、
# io.papermc.paper.util.MCUtil はサーバーの側が使われる。
#
# VeryManyPlayers は MCUtil と Delayed8WayDistancePropagator2D を同梱していて、
# 後者から MCUtil.getCoordinateKey / getCoordinateX / getCoordinateZ を呼ぶ。
# 今の Paper の MCUtil にはこの 3 つが無いので、足さないと NoSuchMethodError になる。
#
# 読んだ位置: vmp-fabric-0.2.0+beta.7.236+26.2.jar io/papermc/paper/util/MCUtil.class
#   getCoordinateKey(II)J  -> ((long) chunkZ << 32) | (chunkX & 0xFFFFFFFFL)
#   getCoordinateX(J)I     -> (int) key
#   getCoordinateZ(J)I     -> (int) (key >>> 32)

file: io/papermc/paper/util/MCUtil.java
replace:
    public static boolean isMainThread() {
        return MinecraftServer.getServer().isSameThread();
with:
    // Shifu - MOD が同梱する Paper のクラスが呼ぶ
    public static long getCoordinateKey(final int chunkX, final int chunkZ) {
        return ((long) chunkZ << 32) | (chunkX & 0xFFFFFFFFL);
    }
    public static int getCoordinateX(final long key) {
        return (int) key;
    }
    public static int getCoordinateZ(final long key) {
        return (int) (key >>> 32);
    }
    // Shifu end
    public static boolean isMainThread() {
        return MinecraftServer.getServer().isSameThread();
