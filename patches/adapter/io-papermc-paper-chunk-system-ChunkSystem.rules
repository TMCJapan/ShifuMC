# vanilla のチャンク供給に載せる本体。
# 公開の getChunkFuture は main で managedBlock するので、非同期の要求に使うと
# main が止まる。止まらない getChunkFutureMainThread を main の上で呼ぶ
# (patches/access で公開にしてある)。
file: io/papermc/paper/chunk/system/ChunkSystem.java
replace:
    public static void scheduleChunkTask(final ServerLevel level, final int chunkX, final int chunkZ, final Runnable run) {
with:
// Shifu - vanilla のチャンク供給に載せる
private static void shifuScheduleLoad(final ServerLevel level, final int chunkX, final int chunkZ,
                                      final boolean gen, final ChunkStatus toStatus, final boolean addTicket,
                                      final Consumer<ChunkAccess> onComplete) {
    level.getServer().execute(() -> {
        final CompletableFuture<net.minecraft.server.level.ChunkResult<ChunkAccess>> future =
                level.chunkSource.getChunkFutureMainThread(chunkX, chunkZ, toStatus, gen || addTicket);

        future.whenComplete((result, throwable) -> level.getServer().execute(() -> {
            if (throwable != null) {
                LOGGER.error("Failed to load chunk " + chunkX + "," + chunkZ, throwable);
                onComplete.accept(null);

                return;
            }

            onComplete.accept(result == null ? null : result.orElse(null));
        }));
    });
}

public static void scheduleChunkTask(final ServerLevel level, final int chunkX, final int chunkZ, final Runnable run) {
