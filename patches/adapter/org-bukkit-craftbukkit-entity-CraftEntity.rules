# アダプタ層の書き換え。vanilla の行ではない。

file: org/bukkit/craftbukkit/entity/CraftEntity.java

replace:
                TeleportTransition.DO_NOTHING,
                cause
with:
                TeleportTransition.DO_NOTHING

# テレポートの理由。Paper は TeleportTransition に cause を持たせて渡すが、
# vanilla の record には無い。発火層に呼ぶ直前で置いておく。
replace:
        return this.entity.teleport(new TeleportTransition(
            ((CraftWorld) location.getWorld()).getHandle(),
with:
        dev.shifu.event.ShifuEvents.teleportCause(this.entity, cause); // Shifu - vanilla の TeleportTransition は理由を運べない
        return this.entity.teleport(new TeleportTransition(
            ((CraftWorld) location.getWorld()).getHandle(),

# 表示の既定を見えないにした実体は、invertedVisibilityEntities に無くても canSee が false になる。
# 同じく PlayerList.shifuVisibilityChanged を立てる(CraftPlayer.rules の同じ旗の説明を参照)。
# 読んだ位置: D:/.pw11/paper-server/src/main/java HEAD:org/bukkit/craftbukkit/entity/CraftEntity.java:722
file: org/bukkit/craftbukkit/entity/CraftEntity.java
replace:
            this.getHandle().visibleByDefault = visible;
with:
            this.getHandle().visibleByDefault = visible;
            if (!visible) net.minecraft.server.players.PlayerList.shifuVisibilityChanged = true; // Shifu
