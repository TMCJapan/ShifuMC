# アダプタ層の書き換え。vanilla の行ではない。

file: org/bukkit/craftbukkit/CraftServer.java

replace:
    new DedicatedServerSettings(this.console.options)
with:
    new DedicatedServerSettings(java.nio.file.Paths.get("server.properties")) /* Shifu - vanilla の Main と同じ場所を読む */

count: 4
replace:
    io.papermc.paper.configuration.GlobalConfiguration.get().misc.loadPermissionsYmlBeforePlugins
with:
    true /* Shifu - Paper の設定は読まないので既定値を書く */

# respawnDimension は Paper が PrimaryLevelData に足した欄。ServerLevel.serverLevelData の
# 宣言の型は vanilla では ServerLevelData なので、読む側で降ろす。
replace:
        this.console.overworld().serverLevelData.respawnDimension = ((CraftWorld) world).getHandle().dimension();
with:
        ((net.minecraft.world.level.storage.PrimaryLevelData) this.console.overworld().serverLevelData).respawnDimension = ((CraftWorld) world).getHandle().dimension(); // Shifu - 欄の型は vanilla のまま

# データパックの読み直しのあとに MinecraftServer が syncCommands を呼ぶ(patches/wire)。
# vanilla は読み直しでコマンドの木を送り直さない(sendCommands の呼び手は参加時と op の変更だけ)ので、
# プラグインが 1 つも無いときは送らない。
replace:
        Commands dispatcher = this.getHandle().getServer().getCommands(); // Paper - We now register directly to the dispatcher.
with:
        if (this.getPluginManager().getPlugins().length == 0) { return; } // Shifu - vanilla は読み直しで送り直さない
        Commands dispatcher = this.getHandle().getServer().getCommands(); // Paper - We now register directly to the dispatcher.
