# アダプタ層の書き換え。vanilla の行ではない。

file: com/destroystokyo/paper/entity/ai/PaperCustomGoal.java

# 原案どおり
replace:
            this.setFlags(MobGoalHelper.paperToVanilla(handle.getTypes()));
            if (this.getFlags().size() == 0) {
                this.addFlag(Flag.UNKNOWN_BEHAVIOR);
            }
with:
            this.setFlags(MobGoalHelper.paperToVanilla(handle.getTypes()));
            // Shifu - vanilla の Goal.Flag に UNKNOWN_BEHAVIOR が無い。
            // 種類を宣言しない目標は旗なしのままにする。vanilla の旗なしの目標と同じ扱いになる。
