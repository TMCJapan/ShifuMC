# エンティティが世界に入るときのイベント。手で書いたもの。
#
# CreatureSpawnEvent / ItemSpawnEvent / ProjectileLaunchEvent /
# VehicleCreateEvent / LightningStrikeEvent / EntitySpawnEvent は全部
# CraftEventFactory.doEntityAddEventCalling が中で振り分ける。
# 呼ぶ場所は 1 つでよい。
#
# Paper は addFreshEntity から addEntity までの経路に SpawnReason の引数を
# 足して回している。Shifu は vanilla の署名を変えないので、その代わりに
# Entity.spawnReason(Paper が足した欄)を見る。
# vanilla が湧かせた分は誰も代入していないので DEFAULT になる。
#
# 位置は vanilla の `return this.entityManager.addNewEntity(entity);` の直前。
# isRemoved の判定が済んだあと、実際に登録する直前で、Paper と同じ場所。
# 落とし物の控え(catchDrop)はメソッドの頭で見ている(patches/wire)。
#
# 取り消されたときは false を返す。vanilla の addEntity が false を返すのは
# 「isRemoved で登録しなかった」ときなので、呼び手の扱いは変わらない。
# doEntityAddEventCalling が中で entity.discard も済ませる。
#
# 登録が無ければ呼ばない。doEntityAddEventCalling は分類に関わらずイベントを
# 組み立てるので、エンティティが 1 つ増えるたびに仕事が増える。
file: net/minecraft/server/level/ServerLevel.java
anchor:
    return this.entityManager.addNewEntity(entity);
insert:
    if (dev.shifu.event.ShifuEvents.entityAddListening()
            && !org.bukkit.craftbukkit.event.CraftEventFactory.doEntityAddEventCalling(
            this, entity,
            entity.spawnReason != null
                    ? entity.spawnReason
                    : org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.DEFAULT)) {
        return false;
    }
