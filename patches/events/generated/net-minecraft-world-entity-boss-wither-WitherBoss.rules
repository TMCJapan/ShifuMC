# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityTargetLivingEvent
file: net/minecraft/world/entity/boss/wither/WitherBoss.java
anchor:
    this.setAlternativeTarget(i, selected.getId());
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityTargetLivingEntityEvent.class)) { // Shifu - 登録が無ければ組み立てない
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callEntityTargetLivingEvent(this, selected, org.bukkit.event.entity.EntityTargetEvent.TargetReason.CLOSEST_ENTITY).isCancelled()) continue; // CraftBukkit
    }

# callEntityChangeBlockEvent
file: net/minecraft/world/entity/boss/wither/WitherBoss.java
anchor:
    destroyed = level.destroyBlock(blockPos, true, this) || destroyed;
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityChangeBlockEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(this, blockPos, state.getFluidState().createLegacyBlock())) { // Paper - fix wrong block state
            continue;
        }
        // CraftBukkit end
    }
