# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityTargetLivingEvent
file: net/minecraft/world/entity/boss/wither/WitherBoss.java
anchor:
    this.setAlternativeTarget(j, livingEntity2.getId());
insert:
    if (org.bukkit.craftbukkit.event.CraftEventFactory.callEntityTargetLivingEvent(this, livingEntity2, org.bukkit.event.entity.EntityTargetEvent.TargetReason.CLOSEST_ENTITY).isCancelled()) continue; // CraftBukkit
