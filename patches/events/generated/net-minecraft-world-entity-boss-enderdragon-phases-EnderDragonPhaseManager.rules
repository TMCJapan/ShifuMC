# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# EnderDragonChangePhaseEvent
file: net/minecraft/world/entity/boss/enderdragon/phases/EnderDragonPhaseManager.java
anchor:
    this.currentPhase = this.getPhase((EnderDragonPhase<DragonPhaseInstance>)type);
insert:
    // CraftBukkit start - Call EnderDragonChangePhaseEvent
    org.bukkit.event.entity.EnderDragonChangePhaseEvent event = new org.bukkit.event.entity.EnderDragonChangePhaseEvent(
        (org.bukkit.craftbukkit.entity.CraftEnderDragon) this.dragon.getBukkitEntity(),
        (this.currentPhase == null) ? null : org.bukkit.craftbukkit.entity.CraftEnderDragon.getBukkitPhase(this.currentPhase.getPhase()),
        org.bukkit.craftbukkit.entity.CraftEnderDragon.getBukkitPhase(type)
    );
    if (!event.callEvent()) {
        return;
    }
    type = org.bukkit.craftbukkit.entity.CraftEnderDragon.getMinecraftPhase(event.getNewPhase());
    // CraftBukkit end

