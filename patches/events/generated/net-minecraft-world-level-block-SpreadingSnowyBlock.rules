# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callBlockFadeEvent
file: net/minecraft/world/level/block/SpreadingSnowyBlock.java
anchor:
    level.setBlockAndUpdate(pos, baseBlock.get().defaultBlockState());
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockFadeEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockFadeEvent(level, pos, baseBlock.get().defaultBlockState()).isCancelled()) {
            return;
        }
        // CraftBukkit end
    }
