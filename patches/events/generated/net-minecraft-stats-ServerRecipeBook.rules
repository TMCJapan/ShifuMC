# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callPlayerRecipeListUpdateEvent
file: net/minecraft/stats/ServerRecipeBook.java
anchor:
    this.add(resourceLocation);
insert:
    // Paper start - PlayerRecipeDiscoverEvent event
    // 1.20.6 の CraftEventFactory は鍵を受けて真偽値を返す
    // Shifu - 登録が無ければ組み立てない
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.player.PlayerRecipeDiscoverEvent.class)
            && !org.bukkit.craftbukkit.event.CraftEventFactory.handlePlayerRecipeListUpdateEvent(player, resourceLocation)) continue;
    // Paper end - PlayerRecipeDiscoverEvent event
