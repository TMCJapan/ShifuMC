    if (dev.shifu.event.AnimalEvents.tameableDeathListening()) {
        net.minecraft.network.chat.Component shifuDeath =
                dev.shifu.event.AnimalEvents.tameableDeathMessage(this, this.getCombatTracker().getDeathMessage());
        if (shifuDeath != null) {
            this.getOwner().sendMessage(shifuDeath, Util.NIL_UUID);
        }
    } else {
