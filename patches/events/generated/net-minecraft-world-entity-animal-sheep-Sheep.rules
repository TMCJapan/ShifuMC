# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# SheepRegrowWoolEvent
file: net/minecraft/world/entity/animal/sheep/Sheep.java
anchor:
    super.ate();
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.SheepRegrowWoolEvent.class)) { // Shifu - 登録が無ければ組み立てない
        if (!new org.bukkit.event.entity.SheepRegrowWoolEvent((org.bukkit.entity.Sheep) this.getBukkitEntity()).callEvent()) return; // CraftBukkit
    }
