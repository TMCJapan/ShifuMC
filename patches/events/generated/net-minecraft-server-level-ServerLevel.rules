# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# WorldSaveEvent
file: net/minecraft/server/level/ServerLevel.java
anchor:
    if (progressListener != null) {
    progressListener.progressStartNoAbort(Component.translatable("menu.savingLevel"));
insert:
    org.bukkit.Bukkit.getPluginManager().callEvent(new org.bukkit.event.world.WorldSaveEvent(this.getWorld())); // CraftBukkit

# MapInitializeEvent
file: net/minecraft/server/level/ServerLevel.java
anchor:
    this.getServer().overworld().getDataStorage().set(MapItemSavedData.type(mapId), data);
insert:
    // CraftBukkit start
    data.id = mapId;
    org.bukkit.event.server.MapInitializeEvent event = new org.bukkit.event.server.MapInitializeEvent(data.mapView);
    event.callEvent();
    // CraftBukkit end
