# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# MapInitializeEvent
file: net/minecraft/server/level/ServerLevel.java
anchor:
    this.getServer().overworld().getDataStorage().set(id.key(), state);
insert:
    // CraftBukkit start
    org.bukkit.event.server.MapInitializeEvent event = new org.bukkit.event.server.MapInitializeEvent(state.mapView);
    event.callEvent();
    // CraftBukkit end
