# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callHorseJumpEvent
file: net/minecraft/world/entity/animal/equine/AbstractHorse.java
anchor:
    this.allowStandSliding = true;
    this.standIfPossible();
    this.playJumpSound();
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.HorseJumpEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        float power;
        if (jumpScale >= 90) {
            power = 1.0F;
        } else {
            power = 0.4F + 0.4F * (float) jumpScale / 90.0F;
        }
        if (!org.bukkit.craftbukkit.event.CraftEventFactory.callHorseJumpEvent(this, power)) {
            return;
        }
        // CraftBukkit end
    }
