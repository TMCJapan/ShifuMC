# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callBlockFadeEvent
file: net/minecraft/world/level/block/CoralPlantBlock.java
anchor:
    level.setBlock(pos, this.deadBlock.defaultBlockState().setValue(WATERLOGGED, false), Block.UPDATE_CLIENTS);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockFadeEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockFadeEvent(level, pos, this.deadBlock.defaultBlockState().setValue(CoralPlantBlock.WATERLOGGED, false)).isCancelled()) {
            return;
        }
        // CraftBukkit end
    }
