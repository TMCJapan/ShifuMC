insert:
    org.bukkit.event.player.PlayerSwapHandItemsEvent shifuSwap =
            dev.shifu.event.PlayerEvents.swapHandItems(this.player);
    if (shifuSwap != null && shifuSwap.isCancelled()) {
        return;
    }
insert-after:
    dev.shifu.event.PlayerEvents.swapHandItemsApply(this.player, shifuSwap);
