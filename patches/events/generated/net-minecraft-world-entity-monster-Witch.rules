# main(26.2)の規則を reanchor.py で局所変数の名前だけ当て直したもの。

# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# WitchConsumePotionEvent
# 1.19.4 は PotionContents が無く、効果は PotionUtils.getMobEffects(mainHandItem) で引く。
# 差し替えと取り消しは、その引き元になる mainHandItem を入れ替えて表す。
file: net/minecraft/world/entity/monster/Witch.java
anchor:
    if (mainHandItem.is(Items.POTION)) {
insert:
    // Paper start - WitchConsumePotionEvent
    if (mainHandItem.is(Items.POTION)) {
        com.destroystokyo.paper.event.entity.WitchConsumePotionEvent event = new com.destroystokyo.paper.event.entity.WitchConsumePotionEvent((org.bukkit.entity.Witch) this.getBukkitEntity(), org.bukkit.craftbukkit.inventory.CraftItemStack.asCraftMirror(mainHandItem));
        mainHandItem = event.callEvent() ? org.bukkit.craftbukkit.inventory.CraftItemStack.asNMSCopy(event.getPotion()) : ItemStack.EMPTY;
    }
    // Paper end - WitchConsumePotionEvent
