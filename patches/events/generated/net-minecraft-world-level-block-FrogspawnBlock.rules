# callBlockFadeEvent
file: net/minecraft/world/level/block/FrogspawnBlock.java
anchor:
    this.destroyBlock(world, pos);
    world.playSound(null, pos, SoundEvents.FROGSPAWN_HATCH, SoundSource.BLOCKS, 1.0F, 1.0F);
insert:
