# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callCrafterCraftEvent
file: net/minecraft/world/level/block/CrafterBlock.java
anchor:
    if (results.isEmpty()) {
insert:
    // CraftBukkit start
    org.bukkit.event.block.CrafterCraftEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callCrafterCraftEvent(pos, level, results, pickedRecipe);
    if (event.isCancelled()) {
        return;
    }
    results = org.bukkit.craftbukkit.inventory.CraftItemStack.asNMSCopy(event.getResult());
    // CraftBukkit end
