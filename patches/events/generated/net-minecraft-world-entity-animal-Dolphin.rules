# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityPickupItemEvent
file: net/minecraft/world/entity/animal/Dolphin.java
anchor:
    this.onItemPickup(item);
insert:
    // CraftBukkit start - call EntityPickupItemEvent
    if (org.bukkit.craftbukkit.event.CraftEventFactory.callEntityPickupItemEvent(this, item, 0).isCancelled()) return;
    item = item.getItem(); // CraftBukkit- update ItemStack from event
    // CraftBukkit end
