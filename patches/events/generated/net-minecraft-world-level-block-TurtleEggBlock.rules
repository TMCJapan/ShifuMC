# main(26.2)の規則を reanchor.py で局所変数の名前だけ当て直したもの。

# callBlockFadeEvent
file: net/minecraft/world/level/block/TurtleEggBlock.java
anchor:
                world.playSound(null, pos, SoundEvents.TURTLE_EGG_HATCH, SoundSource.BLOCKS, 0.7F, 0.9F + random.nextFloat() * 0.2F);
insert:
    // CraftBukkit start - Call BlockFadeEvent
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockFadeEvent.class)
            && org.bukkit.craftbukkit.event.CraftEventFactory.callBlockFadeEvent(world, pos, Blocks.AIR.defaultBlockState()).isCancelled()) {
        return;
    }
    // CraftBukkit end
