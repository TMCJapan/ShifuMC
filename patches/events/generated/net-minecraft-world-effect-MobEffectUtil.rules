# ElderGuardianAppearanceEvent。エルダーガーディアンの幻を見せる直前。
# 相手がエルダーガーディアンでなければ何もしない。

file: net/minecraft/world/effect/MobEffectUtil.java
anchor:
    players.forEach(player -> player.addEffect(new MobEffectInstance(statusEffectInstance), entity));
insert:
    // removeIf にラムダを渡すと、このメソッドの vanilla のラムダが 1 つ先へずれる
    // (公式の lambda$addEffectToPlayersAround$1 が $2 になる)。繰り返しで書く。
    if (dev.shifu.event.EntityEvents.elderGuardianListening()) {
        final java.util.Iterator<ServerPlayer> shifuSeen = players.iterator();

        while (shifuSeen.hasNext()) {
            if (!dev.shifu.event.EntityEvents.elderGuardianAppearance(entity, shifuSeen.next())) {
                shifuSeen.remove();
            }
        }
    }
