# BlockRedstoneEvent
file: net/minecraft/world/level/block/DetectorRailBlock.java
anchor:
    if (flag && !poweredValue) {
insert:
    // CraftBukkit start
    if (poweredValue != flag) {
        org.bukkit.block.Block block = org.bukkit.craftbukkit.block.CraftBlock.at(world, pos);

        org.bukkit.event.block.BlockRedstoneEvent eventRedstone = new org.bukkit.event.block.BlockRedstoneEvent(block, poweredValue ? 15 : 0, flag ? 15 : 0);
        world.getCraftServer().getPluginManager().callEvent(eventRedstone);

        flag = eventRedstone.getNewCurrent() > 0;
    }
    // CraftBukkit end
