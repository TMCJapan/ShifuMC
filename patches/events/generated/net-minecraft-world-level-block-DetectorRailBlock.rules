# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# EntityInsideBlockEvent
file: net/minecraft/world/level/block/DetectorRailBlock.java
anchor:
    public void entityInside(BlockState state, Level world, BlockPos pos, Entity entity) {
insert-after:
    if (dev.shifu.event.EventGuard.listening(io.papermc.paper.event.entity.EntityInsideBlockEvent.class)
            && !new io.papermc.paper.event.entity.EntityInsideBlockEvent(entity.getBukkitEntity(), org.bukkit.craftbukkit.block.CraftBlock.at(world, pos)).callEvent()) { return; } // Paper - Add EntityInsideBlockEvent

# BlockRedstoneEvent
file: net/minecraft/world/level/block/DetectorRailBlock.java
anchor:
    if (flag && !poweredValue) {
insert:
    // CraftBukkit start
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockRedstoneEvent.class)
            && poweredValue != flag) {
        org.bukkit.block.Block block = org.bukkit.craftbukkit.block.CraftBlock.at(world, pos);

        org.bukkit.event.block.BlockRedstoneEvent eventRedstone = new org.bukkit.event.block.BlockRedstoneEvent(block, poweredValue ? 15 : 0, flag ? 15 : 0);
        world.getCraftServer().getPluginManager().callEvent(eventRedstone);

        flag = eventRedstone.getNewCurrent() > 0;
    }
    // CraftBukkit end
