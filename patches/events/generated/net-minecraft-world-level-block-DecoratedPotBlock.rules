# callEntityChangeBlockEvent
file: net/minecraft/world/level/block/DecoratedPotBlock.java
anchor:
    level.setBlock(pos, state.setValue(CRACKED, true), Block.UPDATE_NONE);
insert:
    // CraftBukkit start - call EntityChangeBlockEvent
    if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(projectile, pos, this.getFluidState(state).createLegacyBlock())) {
        return;
