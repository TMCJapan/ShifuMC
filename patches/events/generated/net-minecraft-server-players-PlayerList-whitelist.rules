# ProfileWhitelistVerifyEvent。ホワイトリストを見るとき。
# 登録があるときだけ vanilla の判定を組み直す。

file: net/minecraft/server/players/PlayerList.java
anchor:
    public boolean isWhiteListed(GameProfile var1) {
insert-after:
    if (dev.shifu.event.PlayerEvents.whitelistVerifyListening()) {
        return dev.shifu.event.PlayerEvents.whitelistVerify(var1, this.doWhiteList,
                !this.doWhiteList || this.ops.contains(var1) || this.whitelist.contains(var1),
                this.ops.contains(var1));
    }
