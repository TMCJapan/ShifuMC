# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityChangeBlockEvent
file: net/minecraft/world/entity/monster/Ravager.java
anchor:
    destroyedBlock = serverLevel.destroyBlock(pos, true, this) || destroyedBlock;
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityChangeBlockEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(this, pos, state.getFluidState().createLegacyBlock())) { // Paper - fix wrong block state
            continue;
        }
        // CraftBukkit end
    }

# EntityJumpEvent
file: net/minecraft/world/entity/monster/Ravager.java
anchor:
    this.jumpFromGround();
insert:
    if (!dev.shifu.event.EventGuard.listening(com.destroystokyo.paper.event.entity.EntityJumpEvent.class) || (new com.destroystokyo.paper.event.entity.EntityJumpEvent(getBukkitLivingEntity()).callEvent())) { // Paper - Entity Jump API
insert-after:
    } else { this.setJumping(false); } // Paper - Entity Jump API; setJumping(false) stops a potential loop
