# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityPlaceEvent
file: net/minecraft/world/item/ArmorStandItem.java
anchor:
    serverLevel.addFreshEntityWithPassengers(armorStand);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityPlaceEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callEntityPlaceEvent(context, armorStand).isCancelled()) {
            if (context.getPlayer() != null) context.getPlayer().containerMenu.sendAllDataToRemote(); // Paper - Fix inventory desync
            return InteractionResult.FAIL;
        }
        // CraftBukkit end
    }
