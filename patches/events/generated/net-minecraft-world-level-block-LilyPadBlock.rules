# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# EntityInsideBlockEvent
file: net/minecraft/world/level/block/LilyPadBlock.java
anchor:
    super.entityInside(state, level, pos, entity, effectApplier, isPrecise);
insert:
    if (!new io.papermc.paper.event.entity.EntityInsideBlockEvent(entity.getBukkitEntity(), org.bukkit.craftbukkit.block.CraftBlock.at(level, pos)).callEvent()) { return; } // Paper - Add EntityInsideBlockEvent

# callEntityChangeBlockEvent
file: net/minecraft/world/level/block/LilyPadBlock.java
anchor:
    level.destroyBlock(new BlockPos(pos), true, entity);
insert:
    // CraftBukkit start
    if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(entity, pos, state.getFluidState().createLegacyBlock())) { // Paper - fix wrong block state
        return;
    }
    // CraftBukkit end
