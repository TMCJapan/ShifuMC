# main(26.2)の規則を 1.20.6 の行に当て直したもの。

# main(26.2)の規則を reanchor.py で局所変数の名前だけ当て直したもの。

# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityTargetEvent
file: net/minecraft/world/entity/ai/behavior/GoToWantedItem.java
anchor:
    WalkTarget walkTargetx = new WalkTarget(new EntityTracker(itemEntity, false), speed, 0);
insert:
    // CraftBukkit start
    if (entity instanceof net.minecraft.world.entity.animal.allay.Allay) {
        org.bukkit.event.entity.EntityTargetEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callEntityTargetEvent(entity, itemEntity, org.bukkit.event.entity.EntityTargetEvent.TargetReason.CLOSEST_ENTITY);

        if (event.isCancelled()) {
            return false;
        }
        if (!(event.getTarget() instanceof org.bukkit.craftbukkit.entity.CraftItem targetItem)) { // Paper - only erase allay memory on non-itemEntity targets
            nearestVisibleWantedItem.erase();
            return false; // Paper - only erase allay memory on non-itemEntity targets
        }

        itemEntity = targetItem.getHandle();
    }
    // CraftBukkit end
