# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callPlayerItemBreakEvent
file: net/minecraft/world/item/ItemStack.java
anchor:
    this.shrink(1);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.player.PlayerItemBreakEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start - Check for item breaking
        // Shifu - 型の変数を作らずに cast する。公式にも ServerPlayer の局所変数があり、足すと @Local ServerPlayer の候補が増える
        if (this.getCount() == 1 && player instanceof ServerPlayer) { // Paper - Add EntityDamageItemEvent
            org.bukkit.craftbukkit.event.CraftEventFactory.callPlayerItemBreakEvent((ServerPlayer) player, this); // Paper - Add EntityDamageItemEvent
        }
        // CraftBukkit end
    }
