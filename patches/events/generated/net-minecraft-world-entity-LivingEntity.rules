# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityPotionEffectChangeEvent
file: net/minecraft/world/entity/LivingEntity.java
anchor:
    iterator.remove();
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityPotionEffectEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        EntityPotionEffectEvent event = CraftEventFactory.callEntityPotionEffectChangeEvent(this, mobEffectInstance, null, org.bukkit.event.entity.EntityPotionEffectEvent.Cause.EXPIRATION);
        if (event.isCancelled()) {
            continue;
        }
        // CraftBukkit end
    }

