# main(26.2)の同名の規則を 1.20.6 の行に当て直したもの。

# PigZapEvent。vanilla が作った ZombifiedPiglin をそのままイベントへ渡す
file: net/minecraft/world/entity/animal/Pig.java
anchor:
    zombifiedPiglin.setItemSlot(EquipmentSlot.MAINHAND, new ItemStack(Items.GOLDEN_SWORD));
insert:
    if (!dev.shifu.event.AnimalEvents.pigZap(this, lightning, zombifiedPiglin)) {
        return;
    }
