# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# handleBellRingEvent
file: net/minecraft/world/level/block/BellBlock.java
anchor:
    ((BellBlockEntity)blockEntity).onHit(direction);
insert:
    if (dev.shifu.event.EventGuard.listening(io.papermc.paper.event.block.BellRingEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        if (!org.bukkit.craftbukkit.event.CraftEventFactory.handleBellRingEvent(level, pos, direction, entity)) {
            return false;
        }
        // CraftBukkit end
    }
