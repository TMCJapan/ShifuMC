# AnvilDamagedEvent。金床が傷む直前。登録があるときだけ組み直す。
# 手で書いた規則。組み直した状態は vanilla の局所変数に書き戻す(別の BlockState に受けると、公式の
# lambda にもある BlockState の局所変数が増え、MixinExtras の @Local BlockState が当たらない)。

file: net/minecraft/world/inventory/AnvilMenu.java
anchor:
                BlockState blockState2 = AnvilBlock.damage(blockState);
insert-after:
    if (dev.shifu.event.ItemEvents.anvilDamagedListening()) {
        blockState2 = dev.shifu.event.ItemEvents.anvilDamaged(this, blockState, blockState2);
        if (blockState2 == blockState) {
            return;
        }
    }
