# AnvilDamagedEvent
file: net/minecraft/world/inventory/AnvilMenu.java
anchor:
    if (blockState2 == null) {
insert:
    // Paper start - AnvilDamageEvent
    com.destroystokyo.paper.event.block.AnvilDamagedEvent event = new com.destroystokyo.paper.event.block.AnvilDamagedEvent(getBukkitView(), blockState2 != null ? org.bukkit.craftbukkit.block.data.CraftBlockData.fromData(blockState2) : null);
    if (!event.callEvent()) {
        return;
    } else if (event.getDamageState() == com.destroystokyo.paper.event.block.AnvilDamagedEvent.DamageState.BROKEN) {
        blockState2 = null;
    } else {
        blockState2 = ((org.bukkit.craftbukkit.block.data.CraftBlockData) event.getDamageState().getMaterial().createBlockData()).getState().setValue(AnvilBlock.FACING, blockState.getValue(AnvilBlock.FACING));
    }
    // Paper end - AnvilDamageEvent

