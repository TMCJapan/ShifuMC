    // CraftBukkit start - Ignition by explosion
    if (!dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockIgniteEvent.class)
            || !org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(this.level, blockPos2.getX(), blockPos2.getY(), blockPos2.getZ(), this).isCancelled()) {
insert-after:
    }
    // CraftBukkit end
