# main(26.2)の同名の規則を 1.20.6 の行に当て直したもの。

# EntityRegainHealthEvent。vanilla の setHealth を囲む。

# 登録が無ければ null が返り、vanilla の行がそのまま走る。
file: net/minecraft/world/entity/LivingEntity.java
anchor:
    this.setHealth(f + amount);
insert:
    final org.bukkit.event.entity.EntityRegainHealthEvent shifuRegain =
            dev.shifu.event.ShifuEvents.entityRegainHealth(this, amount);
    if (shifuRegain == null) {
insert-after:
    } else if (!shifuRegain.isCancelled()) {
        this.setHealth((float) (this.getHealth() + shifuRegain.getAmount()));
    }
