# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# EntityEffectTickEvent
file: net/minecraft/world/effect/MobEffect.java
anchor:
    this.applyEffectTick(level, mob, amplification);
insert:
    if (dev.shifu.event.EventGuard.listening(io.papermc.paper.event.entity.EntityEffectTickEvent.class)) { // Shifu - 登録が無ければ組み立てない
        if (!new io.papermc.paper.event.entity.EntityEffectTickEvent(mob.getBukkitLivingEntity(), org.bukkit.craftbukkit.potion.CraftPotionEffectType.minecraftToBukkit(this), amplification).callEvent()) { return; } // Paper - Add EntityEffectTickEvent
    }
