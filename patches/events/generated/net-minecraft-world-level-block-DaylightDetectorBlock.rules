# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callRedstoneChange
file: net/minecraft/world/level/block/DaylightDetectorBlock.java
anchor:
    level.setBlock(pos, state.setValue(POWER, target), Block.UPDATE_ALL);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockRedstoneEvent.class)) { // Shifu - 登録が無ければ組み立てない
        target = org.bukkit.craftbukkit.event.CraftEventFactory.callRedstoneChange(level, pos, state.getValue(POWER), target).getNewCurrent(); // Paper - Call BlockRedstoneEvent
    }
