# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# StructuresLocateEvent
file: net/minecraft/world/level/chunk/ChunkGenerator.java
anchor:
    ChunkGeneratorStructureState generatorState = level.getChunkSource().getGeneratorState();
insert:
    if (dev.shifu.event.EventGuard.listening(io.papermc.paper.event.world.StructuresLocateEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // Paper start - StructuresLocateEvent
        // Paper は Stream.map と HolderSet.direct(Function, ...) にメソッド参照を渡している。数え上げで書く
        final org.bukkit.World bukkitWorld = level.getWorld();
        final org.bukkit.Location origin = org.bukkit.craftbukkit.util.CraftLocation.toBukkit(pos, level);
        final List<org.bukkit.generator.structure.Structure> apiStructures = new java.util.ArrayList<>();
        for (final net.minecraft.core.Holder<net.minecraft.world.level.levelgen.structure.Structure> shifuHolder : structure) {
            apiStructures.add(org.bukkit.craftbukkit.generator.structure.CraftStructure.minecraftHolderToBukkit(shifuHolder));
        }
        if (!apiStructures.isEmpty()) {
            final io.papermc.paper.event.world.StructuresLocateEvent event = new io.papermc.paper.event.world.StructuresLocateEvent(bukkitWorld, origin, apiStructures, radius, skipKnownStructures);
            if (!event.callEvent()) {
                return null;
            }
            if (event.getResult() != null) {
                return Pair.of(io.papermc.paper.util.MCUtil.toBlockPos(event.getResult().pos()), org.bukkit.craftbukkit.generator.structure.CraftStructure.bukkitToMinecraftHolder(event.getResult().structure()));
            }
            pos = org.bukkit.craftbukkit.util.CraftLocation.toBlockPosition(event.getOrigin());
            radius = event.getRadius();
            skipKnownStructures = event.shouldFindUnexplored();
            final List<net.minecraft.core.Holder<net.minecraft.world.level.levelgen.structure.Structure>> shifuHolders = new java.util.ArrayList<>();
            for (final org.bukkit.generator.structure.Structure shifuStructure : event.getStructures()) {
                shifuHolders.add(org.bukkit.craftbukkit.generator.structure.CraftStructure.bukkitToMinecraftHolder(shifuStructure));
            }
            structure = HolderSet.direct(shifuHolders);
        }
        // Paper end
    }

# AsyncStructureSpawnEvent
file: net/minecraft/world/level/chunk/ChunkGenerator.java
anchor:
    structureManager.setStartForStructure(sectionPos, structure, structureStart, chunk);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.world.AsyncStructureSpawnEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        BoundingBox box = structureStart.getBoundingBox();
        org.bukkit.event.world.AsyncStructureSpawnEvent event = new org.bukkit.event.world.AsyncStructureSpawnEvent(structureManager.level.getMinecraftWorld().getWorld(), org.bukkit.craftbukkit.generator.structure.CraftStructure.minecraftToBukkit(structure), new org.bukkit.util.BoundingBox(box.minX(), box.minY(), box.minZ(), box.maxX(), box.maxY(), box.maxZ()), chunkPos.x, chunkPos.z);
        org.bukkit.Bukkit.getPluginManager().callEvent(event);
        if (event.isCancelled()) {
            return true;
        }
        // CraftBukkit end
    }
