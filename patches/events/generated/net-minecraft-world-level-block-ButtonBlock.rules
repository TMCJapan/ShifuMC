# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# BlockRedstoneEvent
file: net/minecraft/world/level/block/ButtonBlock.java
anchor:
    this.press(state, level, pos, player);
insert:
    // CraftBukkit start
    boolean powered = state.getValue(ButtonBlock.POWERED);
    org.bukkit.block.Block block = org.bukkit.craftbukkit.block.CraftBlock.at(world, pos);
    int old = (powered) ? 15 : 0;
    int current = (!powered) ? 15 : 0;

    org.bukkit.event.block.BlockRedstoneEvent eventRedstone = new org.bukkit.event.block.BlockRedstoneEvent(block, old, current);
    level.getCraftServer().getPluginManager().callEvent(eventRedstone);

    if ((eventRedstone.getNewCurrent() > 0) != (!powered)) {
        return InteractionResult.SUCCESS;
    }
    // CraftBukkit end

