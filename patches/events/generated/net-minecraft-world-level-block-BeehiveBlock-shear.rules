# PlayerShearBlockEvent。ハサミで蜂の巣を切る直前。
file: net/minecraft/world/level/block/BeehiveBlock.java
anchor:
                dropHoneycomb(world, pos);
insert:
    if (!dev.shifu.event.PlayerEvents.shearBlock(world, pos, player, hand, itemInHand,
            new ItemStack(Items.HONEYCOMB, 3))) {
        return InteractionResult.PASS;
    }
