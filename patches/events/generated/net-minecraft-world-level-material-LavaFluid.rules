# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callBlockIgniteEvent
file: net/minecraft/world/level/material/LavaFluid.java
anchor:
    level.setBlockAndUpdate(blockPos, BaseFireBlock.getState(level, blockPos));
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockIgniteEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start - Prevent lava putting something on fire
        if (!level.getBlockState(blockPos).is(Blocks.FIRE)) {
            if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(level, blockPos, pos).isCancelled()) {
                continue;
            }
        }
        // CraftBukkit end
    }

# callBlockIgniteEvent
file: net/minecraft/world/level/material/LavaFluid.java
anchor:
    level.setBlockAndUpdate(blockPos1.above(), BaseFireBlock.getState(level, blockPos1));
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockIgniteEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start - Prevent lava putting something on fire
        // Shifu - 局所変数にしない。公式にも BlockPos があると @Local BlockPos の候補が増えて mixin が当たらない
        if (!level.getBlockState(blockPos1.above()).is(Blocks.FIRE)) {
            if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(level, blockPos1.above(), pos).isCancelled()) {
                continue;
            }
        }
        // CraftBukkit end - Prevent lava putting something on fire
    }
