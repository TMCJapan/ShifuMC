# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callBlockIgniteEvent
file: net/minecraft/world/level/material/LavaFluid.java
anchor:
    level.setBlockAndUpdate(testPos, BaseFireBlock.getState(level, testPos));
insert:
    // CraftBukkit start - Prevent lava putting something on fire
    if (!level.getBlockState(testPos).is(Blocks.FIRE)) {
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(level, testPos, pos).isCancelled()) {
            continue;
        }
    }
    // CraftBukkit end

# callBlockIgniteEvent
file: net/minecraft/world/level/material/LavaFluid.java
anchor:
    level.setBlockAndUpdate(testPos.above(), BaseFireBlock.getState(level, testPos));
insert:
    // CraftBukkit start - Prevent lava putting something on fire
    BlockPos up = testPos.above();
    if (!level.getBlockState(up).is(Blocks.FIRE)) {
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(level, up, pos).isCancelled()) {
            continue;
        }
    }
    // CraftBukkit end - Prevent lava putting something on fire
