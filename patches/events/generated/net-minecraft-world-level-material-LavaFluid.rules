# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callBlockIgniteEvent
file: net/minecraft/world/level/material/LavaFluid.java
anchor:
    world.setBlockAndUpdate(blockPos, BaseFireBlock.getState(world, blockPos));
insert:
    // CraftBukkit start - Prevent lava putting something on fire
    if (!world.getBlockState(blockPos).is(Blocks.FIRE)) {
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(world, blockPos, pos).isCancelled()) {
            continue;
        }
    }
    // CraftBukkit end

# callBlockIgniteEvent
file: net/minecraft/world/level/material/LavaFluid.java
anchor:
    world.setBlockAndUpdate(blockPos2.above(), BaseFireBlock.getState(world, blockPos2));
insert:
    // CraftBukkit start - Prevent lava putting something on fire
    BlockPos up = blockPos2.above();
    if (!world.getBlockState(up).is(Blocks.FIRE)) {
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(world, up, pos).isCancelled()) {
            continue;
        }
    }
    // CraftBukkit end - Prevent lava putting something on fire
