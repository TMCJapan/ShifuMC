        int sectionPosCoord = SectionPos.blockToSectionCoord(pos.getX() - range);
insert:
    if (this instanceof net.minecraft.server.level.ServerLevel shifuLevel
            && !dev.shifu.event.BlockEvents.genericGameEvent(shifuLevel, gameEvent, pos, entity, range)) {
        return;
