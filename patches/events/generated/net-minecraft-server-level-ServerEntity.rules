
# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# PlayerVelocityEvent
file: net/minecraft/server/level/ServerEntity.java
anchor:
            this.broadcastAndSend(new ClientboundSetEntityMotionPacket(this.entity));
insert:
    // CraftBukkit start - Create PlayerVelocity event
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.player.PlayerVelocityEvent.class)) {
        boolean cancelled = false;

        if (this.entity instanceof ServerPlayer) {
            org.bukkit.entity.Player player = (org.bukkit.entity.Player) this.entity.getBukkitEntity();
            org.bukkit.util.Vector velocity = player.getVelocity();

            org.bukkit.event.player.PlayerVelocityEvent event = new org.bukkit.event.player.PlayerVelocityEvent(player, velocity.clone());
            if (!event.callEvent()) {
                cancelled = true;
            } else if (!velocity.equals(event.getVelocity())) {
                player.setVelocity(event.getVelocity());
            }
        }

        if (cancelled) {
            return;
        }
    }
    // CraftBukkit end
