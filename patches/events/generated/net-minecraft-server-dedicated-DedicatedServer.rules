# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# WhitelistToggleEvent
file: net/minecraft/server/dedicated/DedicatedServer.java
anchor:
    this.settings.update(serverPropertiesHandler -> serverPropertiesHandler.whiteList.update(this.registryAccess(), useWhitelist));
insert:
