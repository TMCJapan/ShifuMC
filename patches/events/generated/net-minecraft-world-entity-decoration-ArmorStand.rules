file: net/minecraft/world/entity/decoration/ArmorStand.java
anchor:
    if (this.isOnFire()) {
insert:
    // CraftBukkit start
    if (org.bukkit.craftbukkit.event.CraftEventFactory.handleNonLivingEntityDamageEvent(this, source, damage, true, this.invisible)) {
        return false;
    }
    // CraftBukkit end

