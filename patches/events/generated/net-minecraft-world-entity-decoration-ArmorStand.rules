# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# handleNonLivingEntityDamageEvent
file: net/minecraft/world/entity/decoration/ArmorStand.java
anchor:
    if (this.isOnFire()) {
insert:
    // CraftBukkit start
    if (org.bukkit.craftbukkit.event.CraftEventFactory.handleNonLivingEntityDamageEvent(this, damageSource, amount, true, this.invisible)) {
        return false;
    }
    // CraftBukkit end

