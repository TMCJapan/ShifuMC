# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityChangeBlockEvent
file: net/minecraft/world/item/HoneycombItem.java
anchor:
    if (player instanceof ServerPlayer serverPlayer) {
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityChangeBlockEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // Paper start - EntityChangeBlockEvent
        if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(player, pos, waxedState)) {
            if (!player.isCreative()) {
                player.containerMenu.forceHeldSlot(context.getHand());
            }
            return InteractionResult.PASS;
        }
        // Paper end
    }
