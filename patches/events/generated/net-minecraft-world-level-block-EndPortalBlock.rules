# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# EntityInsideBlockEvent
file: net/minecraft/world/level/block/EndPortalBlock.java
anchor:
    if (entity.canUsePortal(false)) {
insert:
    if (dev.shifu.event.EventGuard.listening(io.papermc.paper.event.entity.EntityInsideBlockEvent.class)) { // Shifu - 登録が無ければ組み立てない
        if (!new io.papermc.paper.event.entity.EntityInsideBlockEvent(entity.getBukkitEntity(), org.bukkit.craftbukkit.block.CraftBlock.at(level, pos)).callEvent()) { return; } // Paper - Add EntityInsideBlockEvent
    }

# EntityPortalEnterEvent
file: net/minecraft/world/level/block/EndPortalBlock.java
anchor:
    if (!level.isClientSide() && level.dimension() == Level.END && entity instanceof ServerPlayer player && !player.seenCredits) {
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityPortalEnterEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start - Entity in portal
        org.bukkit.event.entity.EntityPortalEnterEvent event = new org.bukkit.event.entity.EntityPortalEnterEvent(entity.getBukkitEntity(), org.bukkit.craftbukkit.util.CraftLocation.toBukkit(pos, level), org.bukkit.PortalType.ENDER); // Paper - add portal type
        if (!event.callEvent()) return; // Paper - make cancellable
        // CraftBukkit end
    }

# handlePortalEvents
file: net/minecraft/world/level/block/EndPortalBlock.java
anchor:
    return new TeleportTransition(
insert:
    if ((dev.shifu.event.EventGuard.listening(org.bukkit.event.player.PlayerPortalEvent.class) || dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityPortalEvent.class))) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        relatives.removeAll(Relative.ROTATION); // remove relative rotation flags to simplify event mutation
        // Shifu - 向きを局所変数にしない。公式にも float の局所変数があり、足すと @Local float の候補が増える
        org.bukkit.craftbukkit.event.PortalEventResult result = org.bukkit.craftbukkit.event.CraftEventFactory.handlePortalEvents(entity, org.bukkit.craftbukkit.util.CraftLocation.toBukkit(spawnPos, newLevel, !fromEnd ? yRot : entity.getYRot() + yRot, entity.getXRot() + xRot), org.bukkit.PortalType.ENDER, 0, 0);
        if (result == null) {
            return null;
        }
        org.bukkit.Location to = result.to();
        // Shifu - Paper は vanilla の return を to から作り直している。ここでは同じものを作って抜ける
        // (向きの相対の旗は上で外したので、to の向きがそのまま絶対の向きになる)。
        // Paper の withCause(END_PORTAL) の代わりに、テレポートの理由は ShifuEvents が portalProcess から出す
        return new TeleportTransition(
            ((org.bukkit.craftbukkit.CraftWorld) to.getWorld()).getHandle(),
            org.bukkit.craftbukkit.util.CraftLocation.toVec3(to),
            Vec3.ZERO,
            to.getYaw(),
            to.getPitch(),
            relatives,
            TeleportTransition.PLAY_PORTAL_SOUND.then(TeleportTransition.PLACE_PORTAL_TICKET)
        );
    }
