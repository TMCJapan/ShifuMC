# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# FishHookStateChangeEvent
file: net/minecraft/world/entity/projectile/FishingHook.java
anchor:
    this.currentState = FishingHook.FishHookState.HOOKED_IN_ENTITY;
insert:
    if (dev.shifu.event.EventGuard.listening(io.papermc.paper.event.entity.FishHookStateChangeEvent.class)) { // Shifu - 登録が無ければ組み立てない
        new io.papermc.paper.event.entity.FishHookStateChangeEvent((org.bukkit.entity.FishHook) getBukkitEntity(), org.bukkit.entity.FishHook.HookState.HOOKED_ENTITY).callEvent(); // Paper - Add FishHookStateChangeEvent. #HOOKED_ENTITY
    }

