# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityIgniteEvent
file: net/minecraft/world/entity/monster/cubemob/SulfurCube.java
anchor:
    this.setInvulnerable(true);
insert:
    if (dev.shifu.event.EventGuard.listening(io.papermc.paper.event.entity.EntityIgniteEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // Paper start - call EntityIgniteEvent
        fuseTime = org.bukkit.craftbukkit.event.CraftEventFactory.callEntityIgniteEvent(this, fuseTime);
        if (fuseTime == PrimedTnt.NO_FUSE) {
            return false;
        }
        // Paper end - call EntityIgniteEvent
    }
