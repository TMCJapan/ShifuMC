# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityChangeBlockEvent
file: net/minecraft/world/entity/ai/behavior/TryLaySpawnOnWaterNearLand.java
anchor:
    level.setBlock(blockPos2, blockState, Block.UPDATE_ALL);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityChangeBlockEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(entity, blockPos2, blockState)) {
            isPregnant.erase();
            return true;
        }
        // CraftBukkit end
    }
