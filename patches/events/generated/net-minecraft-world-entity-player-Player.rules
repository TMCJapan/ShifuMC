
# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# PlayerDeepSleepEvent
file: net/minecraft/world/entity/player/Player.java
anchor:
    if (this.sleepCounter > 100) {
insert:
    // Paper start - Add PlayerDeepSleepEvent
    if (dev.shifu.event.EventGuard.listening(io.papermc.paper.event.player.PlayerDeepSleepEvent.class)
            && this.sleepCounter == SLEEP_DURATION) {
        if (!new io.papermc.paper.event.player.PlayerDeepSleepEvent((org.bukkit.entity.Player) getBukkitEntity()).callEvent()) {
            this.sleepCounter = Integer.MIN_VALUE;
        }
    }
    // Paper end - Add PlayerDeepSleepEvent
