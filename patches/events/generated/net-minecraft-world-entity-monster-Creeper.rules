# main(26.2)の同名の規則を 1.20.6 の行に当て直したもの。
# 1.20.6 の thunderHit の引数は lightning。
# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callCreeperPowerEvent
file: net/minecraft/world/entity/monster/Creeper.java
anchor:
    this.entityData.set(DATA_IS_POWERED, true);
insert:
    // CraftBukkit start
    if (org.bukkit.craftbukkit.event.CraftEventFactory.callCreeperPowerEvent(this, lightning, org.bukkit.event.entity.CreeperPowerEvent.PowerCause.LIGHTNING).isCancelled()) {
        return;
    }
    // CraftBukkit end
