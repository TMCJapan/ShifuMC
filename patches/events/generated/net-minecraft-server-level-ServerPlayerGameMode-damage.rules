# main(26.2)の同名の規則を 1.20.6 の行に当て直したもの。

# BlockDamageEvent。attack が済んで壊す速さが決まったあと(Paper と同じ位置)
file: net/minecraft/server/level/ServerPlayerGameMode.java
anchor:
                if (!blockState.isAir() && f >= 1.0F) {
insert:
    org.bukkit.event.block.BlockDamageEvent shifuDamage =
            dev.shifu.event.PlayerEvents.blockDamage(this.player, pos, direction, f >= 1.0F);
    if (shifuDamage != null) {
        if (shifuDamage.isCancelled()) {
            return;
        }

        if (shifuDamage.getInstaBreak()) {
            f = 2.0F;
        }
    }

