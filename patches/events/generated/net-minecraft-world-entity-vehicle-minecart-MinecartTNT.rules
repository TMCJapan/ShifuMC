# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# ExplosionPrimeEvent
file: net/minecraft/world/entity/vehicle/minecart/MinecartTNT.java
anchor:
    serverLevel.explode(
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.ExplosionPrimeEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        org.bukkit.event.entity.ExplosionPrimeEvent event = new org.bukkit.event.entity.ExplosionPrimeEvent(
            this.getBukkitEntity(),
            (float) (this.explosionPowerBase + this.explosionSpeedFactor * this.random.nextDouble() * 1.5 * min),
            this.isIncendiary
        );
        if (!event.callEvent()) {
            this.fuse = -1;
            return;
        }
        // CraftBukkit end
    }
