# PlayerOpenSignEvent。看板を開く直前。
# 1.19.4 の SignBlock に openTextEdit は無く、ServerPlayer が持つ。
# 表裏も無いので front には true を渡す。
file: net/minecraft/server/level/ServerPlayer.java
anchor:
    public void openTextEdit(SignBlockEntity var1) {
insert-after:
    if (!dev.shifu.event.PlayerEvents.signOpen(this, var1, true)) {
        return;
    }
