# EntityInsideBlockEvent
file: net/minecraft/world/level/block/BasePressurePlateBlock.java
anchor:
    public void entityInside(BlockState state, Level world, BlockPos pos, Entity entity) {
insert-after:
    if (dev.shifu.event.EventGuard.listening(io.papermc.paper.event.entity.EntityInsideBlockEvent.class)
            && !new io.papermc.paper.event.entity.EntityInsideBlockEvent(entity.getBukkitEntity(), org.bukkit.craftbukkit.block.CraftBlock.at(world, pos)).callEvent()) { return; } // Paper - Add EntityInsideBlockEvent

# BlockRedstoneEvent
file: net/minecraft/world/level/block/BasePressurePlateBlock.java
anchor:
    if (output != signalStrength) {
insert:
    // CraftBukkit start - Interact Pressure Plate
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockRedstoneEvent.class)
            && flag != flag1) {
        org.bukkit.event.block.BlockRedstoneEvent eventRedstone = new org.bukkit.event.block.BlockRedstoneEvent(org.bukkit.craftbukkit.block.CraftBlock.at(world, pos), output, signalStrength);
        eventRedstone.callEvent();

        flag1 = eventRedstone.getNewCurrent() > 0;
        signalStrength = eventRedstone.getNewCurrent();
    }
    // CraftBukkit end
