# BlockRedstoneEvent
file: net/minecraft/world/level/block/BasePressurePlateBlock.java
anchor:
    if (output != signalStrength) {
insert:
    // CraftBukkit start - Interact Pressure Plate
    if (flag != flag1) {
        org.bukkit.event.block.BlockRedstoneEvent eventRedstone = new org.bukkit.event.block.BlockRedstoneEvent(org.bukkit.craftbukkit.block.CraftBlock.at(world, pos), output, signalStrength);
        eventRedstone.callEvent();

        flag1 = eventRedstone.getNewCurrent() > 0;
        signalStrength = eventRedstone.getNewCurrent();
    }
    // CraftBukkit end
