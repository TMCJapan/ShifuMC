# BlockRedstoneEvent
file: net/minecraft/world/level/block/BasePressurePlateBlock.java
anchor:
    if (output != i) {
insert:
    // CraftBukkit start - Interact Pressure Plate
    if (bl != bl2) {
        org.bukkit.event.block.BlockRedstoneEvent eventRedstone = new org.bukkit.event.block.BlockRedstoneEvent(org.bukkit.craftbukkit.block.CraftBlock.at(world, pos), output, i);
        eventRedstone.callEvent();

        bl2 = eventRedstone.getNewCurrent() > 0;
        i = eventRedstone.getNewCurrent();
    }
    // CraftBukkit end
