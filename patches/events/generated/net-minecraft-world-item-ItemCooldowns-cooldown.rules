# PlayerItemCooldownEvent。クールダウンを入れる直前。

file: net/minecraft/world/item/ItemCooldowns.java
anchor:
    public void addCooldown(Item item, int duration) {
insert-after:
    Integer shifuCooldown = dev.shifu.event.PlayerEvents.itemCooldown(this, item, duration);
    if (shifuCooldown == null) {
        return;
    }
    duration = shifuCooldown;
