# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityKnockbackEvent
file: net/minecraft/world/level/ServerExplosion.java
anchor:
    entity.push(vec32);
insert:
    if ((dev.shifu.event.EventGuard.listening(com.destroystokyo.paper.event.entity.EntityKnockbackByEntityEvent.class) || dev.shifu.event.EventGuard.listening(io.papermc.paper.event.entity.EntityKnockbackEvent.class) || dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityKnockbackByEntityEvent.class) || dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityKnockbackEvent.class))) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start - Call EntityKnockbackEvent
        if (entity instanceof LivingEntity) {
            // Paper start - knockback events
            io.papermc.paper.event.entity.EntityKnockbackEvent event = CraftEventFactory.callEntityKnockbackEvent((org.bukkit.craftbukkit.entity.CraftLivingEntity) entity.getBukkitEntity(), this.source, this.damageSource.getEntity() != null ? this.damageSource.getEntity() : this.source, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.EXPLOSION, d2, vec32);
            vec32 = event.isCancelled() ? Vec3.ZERO : org.bukkit.craftbukkit.util.CraftVector.toVec3(event.getKnockback());
            // Paper end - knockback events
        }
        // CraftBukkit end
    }

# callTNTPrimeEvent
file: net/minecraft/world/level/ServerExplosion.java
anchor:
    this.level
insert:
    // CraftBukkit start - TNTPrimeEvent
    // 登録の判定と、ゲームルール・ブロックを見るのは ShifuEvents.tntPrimeByExplosion がやる。
    // Paper の形のままだと、登録が無くても壊れる位置ごとに getBlockState とゲームルールを引いていた
    if (!dev.shifu.event.ShifuEvents.tntPrimeByExplosion(this.level, blockPos, this)) {
        continue;
    }
    // CraftBukkit end

# callBlockIgniteEvent
file: net/minecraft/world/level/ServerExplosion.java
anchor:
    this.level.setBlockAndUpdate(blockPos, BaseFireBlock.getState(this.level, blockPos));
insert:
    // CraftBukkit start - Ignition by explosion
    if (!dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockIgniteEvent.class) || (!org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(this.level, blockPos, this).isCancelled())) { // Shifu - 登録が無ければ組み立てない
insert-after:
    }
    // CraftBukkit end
