# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callRedstoneChange
file: net/minecraft/world/level/block/PoweredRailBlock.java
anchor:
    level.setBlock(pos, state.setValue(POWERED, flag), Block.UPDATE_ALL);
insert:
    // CraftBukkit start
    int power = flag ? 15 : 0;
    int newPower = org.bukkit.craftbukkit.event.CraftEventFactory.callRedstoneChange(level, pos, power, 15 - power).getNewCurrent();
    if (newPower == power) {
        return;
    }
    // CraftBukkit end
