# callRedstoneChange
file: net/minecraft/world/level/block/entity/ContainerOpenersCounter.java
anchor:
    boolean isOpen = openCount != 0;
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockRedstoneEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // Paper start - Call BlockRedstoneEvent
        if (blockState.is(net.minecraft.world.level.block.Blocks.TRAPPED_CHEST)) {
            // Shifu - 局所変数にしない。公式にも int があると @Local int の候補が増えて mixin が当たらない
            if (Math.clamp(prevCount, 0, 15) != Math.clamp(openCount, 0, 15)) {
                org.bukkit.craftbukkit.event.CraftEventFactory.callRedstoneChange(level, pos, Math.clamp(prevCount, 0, 15), Math.clamp(openCount, 0, 15));
            }
        }
        // Paper end - Call BlockRedstoneEvent
