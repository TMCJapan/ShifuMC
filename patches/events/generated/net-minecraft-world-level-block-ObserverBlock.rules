# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callRedstoneChange
file: net/minecraft/world/level/block/ObserverBlock.java
anchor:
    level.setBlock(pos, state.setValue(POWERED, false), Block.UPDATE_CLIENTS);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockRedstoneEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callRedstoneChange(level, pos, 15, 0).getNewCurrent() != 0) {
            return;
        }
        // CraftBukkit end
    }

# callRedstoneChange
file: net/minecraft/world/level/block/ObserverBlock.java
anchor:
    level.setBlock(pos, state.setValue(POWERED, true), Block.UPDATE_CLIENTS);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockRedstoneEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callRedstoneChange(level, pos, 0, 15).getNewCurrent() != 15) {
            return;
        }
        // CraftBukkit end
    }
