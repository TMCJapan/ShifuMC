# Paper のパッチから作った発火。tools/make_events.py が出したもの。
# 1.20.6 のトロッコは Old/NewMinecartBehavior に分かれておらず、AbstractMinecart が持つ。

# VehicleMoveEvent の前の位置
file: net/minecraft/world/entity/vehicle/AbstractMinecart.java
anchor:
    public void tick() {
insert-after:
        // CraftBukkit start
        double shifuPrevX = this.getX();
        double shifuPrevY = this.getY();
        double shifuPrevZ = this.getZ();
        float shifuPrevYaw = this.getYRot();
        float shifuPrevPitch = this.getXRot();
        // CraftBukkit end

# VehicleUpdateEvent, VehicleMoveEvent
file: net/minecraft/world/entity/vehicle/AbstractMinecart.java
anchor:
    this.setRot(this.getYRot(), this.getXRot());
    if (this.getMinecartType() == AbstractMinecart.Type.RIDEABLE && this.getDeltaMovement().horizontalDistanceSqr() > 0.01) {
insert:
            // CraftBukkit start
            org.bukkit.World shifuWorld = this.level().getWorld();
            org.bukkit.Location shifuFrom = new org.bukkit.Location(shifuWorld, shifuPrevX, shifuPrevY, shifuPrevZ, shifuPrevYaw, shifuPrevPitch);
            org.bukkit.Location shifuTo = org.bukkit.craftbukkit.util.CraftLocation.toBukkit(this.position(), shifuWorld, this.getYRot(), this.getXRot());
            org.bukkit.entity.Vehicle shifuVehicle = (org.bukkit.entity.Vehicle) this.getBukkitEntity();

            this.level().getCraftServer().getPluginManager().callEvent(new org.bukkit.event.vehicle.VehicleUpdateEvent(shifuVehicle));

            if (!shifuFrom.equals(shifuTo)) {
                this.level().getCraftServer().getPluginManager().callEvent(new org.bukkit.event.vehicle.VehicleMoveEvent(shifuVehicle, shifuFrom, shifuTo));
            }
            // CraftBukkit end

# VehicleEntityCollisionEvent(乗せる)
file: net/minecraft/world/entity/vehicle/AbstractMinecart.java
anchor:
    entity.startRiding(this);
insert:
                            // CraftBukkit start
                            org.bukkit.event.vehicle.VehicleEntityCollisionEvent shifuCollision = new org.bukkit.event.vehicle.VehicleEntityCollisionEvent(shifuVehicle, entity.getBukkitEntity());
                            this.level().getCraftServer().getPluginManager().callEvent(shifuCollision);

                            if (shifuCollision.isCancelled()) {
                                continue;
                            }
                            // CraftBukkit end

# VehicleEntityCollisionEvent(押す)
file: net/minecraft/world/entity/vehicle/AbstractMinecart.java
anchor:
    entity.push(this);
insert:
                            // CraftBukkit start
                            if (!this.isPassengerOfSameVehicle(entity)) {
                                org.bukkit.event.vehicle.VehicleEntityCollisionEvent shifuCollision = new org.bukkit.event.vehicle.VehicleEntityCollisionEvent(shifuVehicle, entity.getBukkitEntity());
                                this.level().getCraftServer().getPluginManager().callEvent(shifuCollision);

                                if (shifuCollision.isCancelled()) {
                                    continue;
                                }
                            }
                            // CraftBukkit end

