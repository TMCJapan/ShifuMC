# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callNotePlayEvent
file: net/minecraft/world/level/block/NoteBlock.java
anchor:
    float pitchFromNote;
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.NotePlayEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // Paper start - move NotePlayEvent call to fix instrument/note changes
        org.bukkit.event.block.NotePlayEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callNotePlayEvent(level, pos, noteBlockInstrument, state.getValue(NOTE));
        if (event.isCancelled()) return false;
        // Paper end - move NotePlayEvent call to fix instrument/note changes
    }
