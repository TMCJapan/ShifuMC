# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# handleStatisticsIncrease
file: net/minecraft/stats/StatsCounter.java
anchor:
    this.setValue(player, stat, result);
insert:
    // CraftBukkit start - fire Statistic events
    org.bukkit.event.Cancellable cancellable = org.bukkit.craftbukkit.event.CraftEventFactory.handleStatisticsIncrease(player, stat, this.getValue(stat), result);
    if (cancellable != null && cancellable.isCancelled()) {
        return;
    }
    // CraftBukkit end
