# main(26.2)の規則を reanchor.py で局所変数の名前だけ当て直したもの。

# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# handleStatisticsIncrease
file: net/minecraft/stats/StatsCounter.java
anchor:
    this.setValue(player, stat, i);
insert:
    // CraftBukkit start - fire Statistic events
    // Shifu - 登録が無ければ組み立てない(Bukkit の統計の種類へ引き直すのも、知らない統計を
    // System.err へ書くのも handleStatisticsIncrease の中)
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.player.PlayerStatisticIncrementEvent.class)) {
        org.bukkit.event.Cancellable cancellable = org.bukkit.craftbukkit.event.CraftEventFactory.handleStatisticsIncrease(player, stat, this.getValue(stat), i);
        if (cancellable != null && cancellable.isCancelled()) {
            return;
        }
    }
    // CraftBukkit end
