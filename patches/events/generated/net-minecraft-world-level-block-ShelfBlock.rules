# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callBinaryRedstoneChange
file: net/minecraft/world/level/block/ShelfBlock.java
anchor:
    BlockState newState = state.setValue(POWERED, signal);
insert:
    // Paper start - Call BlockRedstoneEvent
    if (!org.bukkit.craftbukkit.event.CraftEventFactory.callBinaryRedstoneChange(level, pos, signal)) {
        return;
    }
    // Paper end - Call BlockRedstoneEvent
