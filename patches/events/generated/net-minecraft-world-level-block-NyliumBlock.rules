# main(26.2)の規則を reanchor.py で局所変数の名前だけ当て直したもの。

# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callBlockFadeEvent
file: net/minecraft/world/level/block/NyliumBlock.java
anchor:
    world.setBlockAndUpdate(pos, Blocks.NETHERRACK.defaultBlockState());
insert:
    // CraftBukkit start
    if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockFadeEvent(world, pos, Blocks.NETHERRACK.defaultBlockState()).isCancelled()) {
        return;
    }
    // CraftBukkit end
