# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# EntityInsideBlockEvent
file: net/minecraft/world/level/block/EndGatewayBlock.java
anchor:
    if (entity.canUsePortal(false)
insert:
    if (dev.shifu.event.EventGuard.listening(io.papermc.paper.event.entity.EntityInsideBlockEvent.class)) { // Shifu - 登録が無ければ組み立てない
        if (!new io.papermc.paper.event.entity.EntityInsideBlockEvent(entity.getBukkitEntity(), org.bukkit.craftbukkit.block.CraftBlock.at(level, pos)).callEvent()) { return; } // Paper - Add EntityInsideBlockEvent
    }

# EntityPortalEnterEvent
file: net/minecraft/world/level/block/EndGatewayBlock.java
anchor:
    entity.setAsInsidePortal(this, pos);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityPortalEnterEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // Paper start - call EntityPortalEnterEvent
        org.bukkit.event.entity.EntityPortalEnterEvent event = new org.bukkit.event.entity.EntityPortalEnterEvent(entity.getBukkitEntity(), org.bukkit.craftbukkit.util.CraftLocation.toBukkit(pos, level), org.bukkit.PortalType.END_GATEWAY); // Paper - add portal type
        if (!event.callEvent()) return;
        // Paper end - call EntityPortalEnterEvent
    }
