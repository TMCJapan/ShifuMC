# Paper のパッチから作った発火。tools/make_events.py が出したもの。
# callEntityChangeBlockEvent
# 1.19.4 の callEntityChangeBlockEvent は EntityChangeBlockEvent を返す。
file: net/minecraft/world/entity/animal/Fox.java
anchor:
            int i = 1 + Fox.this.level.random.nextInt(2) + (ageValue == 3 ? 1 : 0);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityChangeBlockEvent.class)
            && org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(Fox.this, this.blockPos, state.setValue(SweetBerryBushBlock.AGE, 1)).isCancelled()) return; // CraftBukkit - call EntityChangeBlockEvent
