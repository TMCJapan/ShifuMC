# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callBlockFadeEvent
file: net/minecraft/world/level/block/SpreadingSnowyDirtBlock.java
anchor:
    world.setBlockAndUpdate(pos, Blocks.DIRT.defaultBlockState());
insert:
    // CraftBukkit start
    if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockFadeEvent(world, pos, Blocks.DIRT.defaultBlockState()).isCancelled()) {
        return;
    }
    // CraftBukkit end
