
# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityBreakDoorEvent
file: net/minecraft/world/entity/ai/goal/BreakDoorGoal.java
anchor:
    this.mob.level().removeBlock(this.doorPos, false);
insert:
    // CraftBukkit start
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityBreakDoorEvent.class)
            && org.bukkit.craftbukkit.event.CraftEventFactory.callEntityBreakDoorEvent(this.mob, this.doorPos, this.mob.level().getFluidState(this.doorPos).createLegacyBlock()).isCancelled()) { // Paper - fix wrong block state
        this.start();
        return;
    }
    // CraftBukkit end
    // Shifu - Paper はここで oldState(MC-263999 の直し)を控えて levelEvent の行を書き換えるが、
    // vanilla の行は変えないので使い道が無い。登録が無くても getBlockState が 1 回増えていたので置かない
