# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callBlockPhysicsEvent
file: net/minecraft/world/level/block/DoublePlantBlock.java
anchor:
    DoubleBlockHalf part = state.getValue(HALF);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockPhysicsEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        if (((net.minecraft.server.level.ServerLevel)level).hasPhysicsEvent && org.bukkit.craftbukkit.event.CraftEventFactory.callBlockPhysicsEvent(level, pos).isCancelled()) { // Paper
            return;
        }
        // CraftBukkit end
    }
