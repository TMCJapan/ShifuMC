# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityPickupItemEvent
file: net/minecraft/world/entity/raid/Raider.java
anchor:
    EquipmentSlot equipmentSlot = EquipmentSlot.HEAD;
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityPickupItemEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // Paper start - EntityPickupItemEvent fixes
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callEntityPickupItemEvent(this, entity, 0).isCancelled()) {
            return;
        }
        // Paper end - EntityPickupItemEvent fixes
    }
