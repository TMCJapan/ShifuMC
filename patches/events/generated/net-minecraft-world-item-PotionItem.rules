# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityChangeBlockEvent
file: net/minecraft/world/item/PotionItem.java
anchor:
    level.playSound(null, pos, SoundEvents.GENERIC_SPLASH, SoundSource.BLOCKS, 1.0F, 1.0F);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityChangeBlockEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // Paper start
        if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(player, pos, Blocks.MUD.defaultBlockState())) {
            if (itemStack.getCount() > 1 || player.hasInfiniteMaterials()) {
                player.containerMenu.sendAllDataToRemote();
            } else {
                player.containerMenu.forceHeldSlot(context.getHand());
            }
            return InteractionResult.PASS;
        }
        // Paper end
    }
