# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# EnderDragonShootFireballEvent
file: net/minecraft/world/entity/boss/enderdragon/phases/DragonStrafePlayerPhase.java
anchor:
    level.addFreshEntity(dragonFireball);
insert:
    if (!dev.shifu.event.EventGuard.listening(com.destroystokyo.paper.event.entity.EnderDragonShootFireballEvent.class) || (new com.destroystokyo.paper.event.entity.EnderDragonShootFireballEvent((org.bukkit.entity.EnderDragon) this.dragon.getBukkitEntity(), (org.bukkit.entity.DragonFireball) dragonFireball.getBukkitEntity()).callEvent())) { // Paper - EnderDragon Events
insert-after:
    } else dragonFireball.discard(null); // Paper - EnderDragon Events
