# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# EntityDropItemEvent
file: net/minecraft/world/entity/animal/sniffer/Sniffer.java
anchor:
    serverLevel1.addFreshEntity(itemEntity);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityDropItemEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start - handle EntityDropItemEvent
        org.bukkit.event.entity.EntityDropItemEvent event = new org.bukkit.event.entity.EntityDropItemEvent(this.getBukkitEntity(), (org.bukkit.entity.Item) itemEntity.getBukkitEntity());
        org.bukkit.Bukkit.getPluginManager().callEvent(event);
        if (event.isCancelled()) {
            return;
        }
        // CraftBukkit end
    }

# callEntityFertilizeEggEvent
file: net/minecraft/world/entity/animal/sniffer/Sniffer.java
anchor:
    ItemStack itemStack = new ItemStack(Items.SNIFFER_EGG);
insert:
    if (dev.shifu.event.EventGuard.listening(io.papermc.paper.event.entity.EntityFertilizeEggEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // Paper start - Add EntityFertilizeEggEvent event
        final io.papermc.paper.event.entity.EntityFertilizeEggEvent result = org.bukkit.craftbukkit.event.CraftEventFactory.callEntityFertilizeEggEvent(this, partner);
        if (result.isCancelled()) return;
        // Paper end - Add EntityFertilizeEggEvent event
    }
