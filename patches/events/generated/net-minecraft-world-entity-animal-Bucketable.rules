# PlayerBucketEntityEvent(魚なら PlayerBucketFishEvent)。バケツに入れる直前。

file: net/minecraft/world/entity/animal/Bucketable.java
anchor:
    ItemStack itemStack = ItemUtils.createFilledResult(itemInHand, player, bucketItemStack, false);
insert:
    if (!dev.shifu.event.PlayerEvents.bucketEntity(entity, player, itemInHand, bucketItemStack, hand)) {
        return Optional.of(InteractionResult.sidedSuccess(entity.level.isClientSide));
    }
