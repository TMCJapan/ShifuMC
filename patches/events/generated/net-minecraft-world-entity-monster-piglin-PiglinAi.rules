# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityPickupItemEvent
file: net/minecraft/world/entity/monster/piglin/PiglinAi.java
anchor:
    ItemStack item;
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityPickupItemEvent.class)) { // Shifu - 登録が無ければ組み立てない
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callEntityPickupItemEvent(piglin, itemEntity, itemEntity.getItem().is(Items.GOLD_NUGGET) ? 0 : itemEntity.getItem().getCount() - 1).isCancelled()) return; // Paper
    }
