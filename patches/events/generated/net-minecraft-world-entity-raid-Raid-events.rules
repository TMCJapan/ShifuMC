# RaidFinishEvent と RaidSpawnWaveEvent。

file: net/minecraft/world/entity/raid/Raid.java
anchor:
                        this.status = Raid.RaidStatus.LOSS;
insert-after:
    dev.shifu.event.EntityEvents.raidFinish(this, java.util.Collections.emptyList());

file: net/minecraft/world/entity/raid/Raid.java
anchor:
                        this.status = Raid.RaidStatus.VICTORY;
