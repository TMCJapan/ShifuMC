# main(26.2)の規則を reanchor.py で局所変数の名前だけ当て直したもの。

# callEntityChangeBlockEvent
file: net/minecraft/world/level/block/ChorusFlowerBlock.java
anchor:
    world.destroyBlock(blockPos, true, projectile);
insert:
    // CraftBukkit start
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityChangeBlockEvent.class)
            && !org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(projectile, blockPos, state.getFluidState().createLegacyBlock())) { // Paper - fix wrong block state
        return;
    }
    // CraftBukkit end
