# PlayerElytraBoostEvent。エリトラ中に花火を使う直前。

file: net/minecraft/world/item/FireworkRocketItem.java
anchor:
                world.addFreshEntity(fireworkRocketEntity);
insert:
    if (!dev.shifu.event.PlayerEvents.elytraBoost(user, itemStack, fireworkRocketEntity, hand)) {
        return InteractionResultHolder.pass(user.getItemInHand(hand));
    }
