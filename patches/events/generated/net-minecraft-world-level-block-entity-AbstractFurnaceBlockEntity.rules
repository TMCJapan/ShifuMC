# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# FurnaceStartSmeltEvent
file: net/minecraft/world/level/block/entity/AbstractFurnaceBlockEntity.java
anchor:
    blockEntity.cookingProgress++;
insert:
    // CraftBukkit start
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.inventory.FurnaceStartSmeltEvent.class)
            && recipe != null && blockEntity.cookingProgress == 0) {
        org.bukkit.craftbukkit.inventory.CraftItemStack source = org.bukkit.craftbukkit.inventory.CraftItemStack.asCraftMirror(blockEntity.items.get(0));
        org.bukkit.inventory.CookingRecipe<?> shifuRecipe = (org.bukkit.inventory.CookingRecipe<?>) recipe.toBukkitRecipe();

        org.bukkit.event.inventory.FurnaceStartSmeltEvent event = new org.bukkit.event.inventory.FurnaceStartSmeltEvent(
            org.bukkit.craftbukkit.block.CraftBlock.at(world, pos),
            source,
            shifuRecipe,
            getTotalCookTime(world, blockEntity)
        );
        event.callEvent();

        blockEntity.cookingTotalTime = event.getTotalCookTime();
    }
    // CraftBukkit end

