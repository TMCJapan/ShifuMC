# 爆発で壊す位置が決まったあと。EntityExplodeEvent と BlockExplodeEvent。
# Paper は Explosion.finalizeExplosion の shuffle の直後で出している。
# 1.18.2 は Util.shuffle ではなく Collections.shuffle。
# 1.18.2 の BlockInteraction は NONE / BREAK / DESTROY の 3 つで、
# 落とし物を減らすのは DESTROY(DESTROY_WITH_DECAY は無い)。

file: net/minecraft/world/level/Explosion.java
anchor:
            Collections.shuffle(this.toBlow, this.level.random);
insert-after:
    if (!dev.shifu.event.ShifuEvents.explode(this, this.level,
            new net.minecraft.world.phys.Vec3(this.x, this.y, this.z), this.toBlow,
            this.blockInteraction == Explosion.BlockInteraction.DESTROY ? 1.0F / this.radius : 1.0F)) {
        this.wasCanceled = true;
        return;
    }
