# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callPreCraftEvent
file: net/minecraft/world/inventory/CraftingMenu.java
anchor:
    resultInventory.setItem(0, itemStack);
insert:
    itemStack = org.bukkit.craftbukkit.event.CraftEventFactory.callPreCraftEvent(craftSlots, resultInventory, itemStack, menu.getBukkitView(), recipeFor.map(RecipeHolder::value).orElse(null) instanceof net.minecraft.world.item.crafting.RepairItemRecipe); // CraftBukkit
