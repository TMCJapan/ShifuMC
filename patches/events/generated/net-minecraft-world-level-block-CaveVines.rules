#     if (org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(picker, pos, state.setValue(CaveVines.BERRIES, false)).isCancelled()) {
#         return InteractionResult.sidedSuccess(world.isClientSide);
#     }
#     // CraftBukkit end - call entity change block event
