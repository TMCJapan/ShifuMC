# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityChangeBlockEvent
file: net/minecraft/world/level/block/CaveVines.java
anchor:
    Block.dropFromBlockInteractLootTable(
insert:
    // CraftBukkit start - call entity change block event
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityChangeBlockEvent.class)
            && !org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(entity, pos, state.setValue(CaveVines.BERRIES, false))) { // Shifu - 登録が無ければ組み立てない
        return InteractionResult.SUCCESS;
    }
    // CraftBukkit end - call entity change block event

# callPlayerHarvestBlockEvent
# Paper はルートテーブルの落とし物を drops に集めてからイベントに渡す。Shifu は vanilla の
# dropFromBlockInteractLootTable のラムダがそのまま落とすので、渡す drops は空で、集めた先の局所変数も置かない
# (置くと登録が無くても List.of() が走る)。
file: net/minecraft/world/level/block/CaveVines.java
anchor:
    float f = Mth.randomBetween(serverLevel.random, 0.8F, 1.2F);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.player.PlayerHarvestBlockEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // Paper start - call player harvest block event
        if (entity instanceof net.minecraft.world.entity.player.Player player) {
            org.bukkit.event.player.PlayerHarvestBlockEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callPlayerHarvestBlockEvent(
                level, pos, player, net.minecraft.world.InteractionHand.MAIN_HAND, java.util.List.of()
            );
            if (event.isCancelled()) {
                return InteractionResult.SUCCESS; // We need to return a success either way, because making it PASS or FAIL will result in a bug where cancelling while harvesting w/ block in hand places block
            }
            for (org.bukkit.inventory.ItemStack itemStack : event.getItemsHarvested()) {
                Block.popResource(level, pos, org.bukkit.craftbukkit.inventory.CraftItemStack.asNMSCopy(itemStack));
            }
        }
        // Paper end - call player harvest block event
    }
