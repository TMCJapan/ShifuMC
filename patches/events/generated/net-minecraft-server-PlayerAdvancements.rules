# main(26.2)の規則を reanchor.py で局所変数の名前だけ当て直したもの。

# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# PlayerAdvancementDoneEvent
# 1.19.4 の Advancement は getDisplay() が DisplayInfo か null を返す。
# grant は checkForAutomaticTriggers にも同じ行があるので、
# 続く if までアンカーに入れて award の方だけを狙う。
file: net/minecraft/server/PlayerAdvancements.java
anchor:
    advancement.getRewards().grant(this.player);
    if (advancement.getDisplay() != null
insert:
    // Paper start - Add Adventure message to PlayerAdvancementDoneEvent
    net.kyori.adventure.text.Component message = null;
    if (advancement.getDisplay() != null && advancement.getDisplay().shouldAnnounceChat()) {
        message = io.papermc.paper.adventure.PaperAdventure.asAdventure(new net.minecraft.network.chat.TranslatableComponent(
                "chat.type.advancement." + advancement.getDisplay().getFrame().getName(),
                this.player.getDisplayName(),
                advancement.getChatComponent()));
    }
    final org.bukkit.event.player.PlayerAdvancementDoneEvent event = new org.bukkit.event.player.PlayerAdvancementDoneEvent(this.player.getBukkitEntity(), advancement.bukkit, message);
    this.player.level.getCraftServer().getPluginManager().callEvent(event); // CraftBukkit
    // Paper end
