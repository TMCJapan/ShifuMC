insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityChangeBlockEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        // Shifu - 局所変数にしない。公式にも BlockState があると @Local BlockState の候補が増えて mixin が当たらない
        if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(this.silverfish, testPos, getServerLevel(level).getGameRules().get(GameRules.MOB_GRIEFING) ? blockState.getFluidState().createLegacyBlock() : infestedBlock.hostStateByInfested(level.getBlockState(testPos)))) { // Paper - fix wrong block state
            continue;
        }
        // CraftBukkit end
    }
