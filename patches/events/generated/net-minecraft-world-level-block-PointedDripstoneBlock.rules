# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callEntityChangeBlockEvent
file: net/minecraft/world/level/block/PointedDripstoneBlock.java
anchor:
    level.destroyBlock(blockPos, true);
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.entity.EntityChangeBlockEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start
        if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(projectile, blockPos, state.getFluidState().createLegacyBlock())) { // Paper - fix wrong block state
            return;
        }
        // CraftBukkit end
    }
