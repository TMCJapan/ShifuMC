# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# BlockRedstoneEvent
file: net/minecraft/world/level/block/CommandBlock.java
anchor:
    boolean bl2 = commandBlockEntity.isPowered();
insert-after:
    // CraftBukkit start
    org.bukkit.block.Block bukkitBlock = org.bukkit.craftbukkit.block.CraftBlock.at(world, pos);
    int old = bl2 ? 15 : 0;
    int current = bl ? 15 : 0;

    org.bukkit.event.block.BlockRedstoneEvent eventRedstone = new org.bukkit.event.block.BlockRedstoneEvent(bukkitBlock, old, current);
    world.getCraftServer().getPluginManager().callEvent(eventRedstone);
    bl = eventRedstone.getNewCurrent() > 0;
    // CraftBukkit end
