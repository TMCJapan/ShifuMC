# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callBlockIgniteEvent
file: net/minecraft/world/item/FireChargeItem.java
anchor:
    this.playSound(level, pos);
    level.setBlockAndUpdate(pos, BaseFireBlock.getState(level, pos));
insert:
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.block.BlockIgniteEvent.class)) { // Shifu - 登録が無ければ組み立てない
        // CraftBukkit start - fire BlockIgniteEvent
        if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(level, pos, org.bukkit.event.block.BlockIgniteEvent.IgniteCause.FIREBALL, context.getPlayer()).isCancelled()) {
            if (!context.getPlayer().getAbilities().instabuild) {
                context.getItemInHand().shrink(1);
            }
            return InteractionResult.PASS;
        }
        // CraftBukkit end
    }

