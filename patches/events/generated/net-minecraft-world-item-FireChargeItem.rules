# Paper のパッチから作った発火。tools/make_events.py が出したもの。

# callBlockIgniteEvent
file: net/minecraft/world/item/FireChargeItem.java
anchor:
    this.playSound(level, blockPos);
    level.setBlockAndUpdate(blockPos, BaseFireBlock.getState(level, blockPos));
insert:
    // CraftBukkit start - fire BlockIgniteEvent
    if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(level, blockPos, org.bukkit.event.block.BlockIgniteEvent.IgniteCause.FIREBALL, context.getPlayer()).isCancelled()) {
        if (!context.getPlayer().getAbilities().instabuild) {
            context.getItemInHand().shrink(1);
        }
        return InteractionResult.PASS;
    }
    // CraftBukkit end

