    world.removeBlock(pos, false);
count: 2
insert:
    if (!dev.shifu.event.ShifuEvents.tntPrime(world, pos,
            org.bukkit.event.block.TNTPrimeEvent.PrimeCause.REDSTONE, null)) {
        return;
    }

