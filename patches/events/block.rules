
# ブロックのイベント。
#
# アンカーは vanilla のソースそのまま。Minecraft が更新されて行が変わったら
# apply_events.py が失敗するので、発火が黙って消えることはない。

# BlockBreakEvent
#
# vanilla の権限判定(冒険モード・保護・GameMasterBlock・blockActionRestricted)が
# 全て終わったあと、最初の書き換えである playerWillDestroy の直前で発火する。
# 取り消されなければ、以降は vanilla のまま。
file: net/minecraft/server/level/ServerPlayerGameMode.java
anchor:
    block.playerWillDestroy(this.level, pos, blockState, this.player);
insert:
    if (!dev.shifu.event.ShifuEvents.blockBreak(this.player, pos)) {
        return false;
    }

# onPlace と neighborChanged。同じ行が 2 箇所にあり、どちらもレッドストーン
file: net/minecraft/world/level/block/TntBlock.java
anchor:
    if (world.hasNeighborSignal(pos)) {
count: 2
insert:
    dev.shifu.event.ShifuEvents.tntPrimeCause(org.bukkit.event.block.TNTPrimeEvent.PrimeCause.REDSTONE, null, null);

