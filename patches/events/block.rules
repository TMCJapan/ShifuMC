# ブロックのイベント。
#
# アンカーは vanilla のソースそのまま。Minecraft が更新されて行が変わったら
# apply_events.py が失敗するので、発火が黙って消えることはない。

# BlockBreakEvent
#
# vanilla の権限判定(冒険モード・保護・GameMasterBlock・blockActionRestricted)が
# 全て終わったあと、最初の書き換えである playerWillDestroy の直前で発火する。
# 取り消されなければ、以降は vanilla のまま。
file: net/minecraft/server/level/ServerPlayerGameMode.java
anchor:
    BlockState blockState2 = block.playerWillDestroy(this.level, pos, blockState, this.player);
insert:
    if (!dev.shifu.event.ShifuEvents.blockBreak(this.player, pos)) {
        return false;
    }

# BlockBreakEvent#setDropItems(false)
#
# Paper は playerDestroy に引数を足して落とし物を出さない。Shifu は vanilla の playerDestroy を
# そのまま呼び、そのあいだに出た ItemEntity を ShifuEvents.addEntityGoesOn(addEntity の頭)で
# 世界に入れずに捨てる。登録が無ければ blockDropsBegin は何も捨てない。
#
# 読んだ位置: Paper-Server src/main/java/net/minecraft/server/level/ServerPlayerGameMode.java(destroyBlock、isDropItems)
file: net/minecraft/server/level/ServerPlayerGameMode.java
anchor:
    if (bl && bl2) {
    block.playerDestroy(this.level, this.player, pos, blockState2, blockEntity, itemStack2);
    }
insert:
    dev.shifu.event.ShifuEvents.blockDropsBegin(this.player, pos);
insert-after:
    dev.shifu.event.ShifuEvents.blockDropsEnd();

# TNTPrimeEvent
#
# 1.20.6 の TntBlock.explode は真偽値を返さない。中で発火して取り消すと、
# 呼び手の removeBlock / setBlock(AIR) はそのまま走るので、TNT が何も残さずに消えた。
# 呼び手ごとに、まだ止められる位置で発火する。原因も呼び手の側で渡す。
#
# 誘爆は vanilla が setBlock(AIR) のあとに wasExploded を呼ぶので、そこでは止められない。
# Paper と同じく Explosion.finalizeExplosion の中で見る。
#
# 読んだ位置: Paper-Server src/main/java/net/minecraft/world/level/block/TntBlock.java:52,68,83,128,163
#             Paper-Server src/main/java/net/minecraft/world/level/Explosion.java:723-733

