# ブロックのイベント。
#
# アンカーは vanilla のソースそのまま。Minecraft が更新されて行が変わったら
# apply_events.py が失敗するので、発火が黙って消えることはない。

# BlockBreakEvent
#
# vanilla の権限判定(canDestroyBlock / GameMasterBlock / blockActionRestricted)が
# 全て終わったあと、最初の書き換えである playerWillDestroy の直前で発火する。
# 取り消されなければ、以降は vanilla のまま。
file: net/minecraft/server/level/ServerPlayerGameMode.java
anchor:
    BlockState adjustedState = block.playerWillDestroy(this.level, pos, state, this.player);
insert:
    if (!dev.shifu.event.ShifuEvents.blockBreak(this.player, pos)) {
        return false;
    }

# BlockBreakEvent#setDropItems(false)
#
# Paper は playerDestroy に引数を足して落とし物を出さない。Shifu は vanilla の playerDestroy を
# そのまま呼び、そのあいだに出た ItemEntity を ShifuEvents.addEntityGoesOn(addEntity の頭)で
# 世界に入れずに捨てる。登録が無ければ blockDropsBegin は何も捨てない。
#
# 読んだ位置: Paper-Server src/main/java/net/minecraft/server/level/ServerPlayerGameMode.java(destroyBlock、isDropItems)
file: net/minecraft/server/level/ServerPlayerGameMode.java
anchor:
    if (changed && canDestroy) {
    block.playerDestroy(this.level, this.player, pos, adjustedState, blockEntity, destroyedWith);
    }
insert:
    dev.shifu.event.ShifuEvents.blockDropsBegin(this.player, pos);
insert-after:
    dev.shifu.event.ShifuEvents.blockDropsEnd();

# TNTPrimeEvent
#
# 発火は TntBlock.prime の中(ゲームルールの判定を通ったあと、PrimedTnt を作る前)。
# 理由は Paper が prime の署名に足した Supplier で運ぶが、Shifu は呼ぶ直前に置く
# (tntPrimeCause)。爆発による誘爆は vanilla が prime を通らないので、爆発の側で別に発火する。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/level/block/TntBlock.java.patch
file: net/minecraft/world/level/block/TntBlock.java
anchor:
    if (level instanceof ServerLevel serverLevel && serverLevel.getGameRules().get(GameRules.TNT_EXPLODES)) {
insert-after:
    if (!dev.shifu.event.ShifuEvents.tntPrime(level, pos, source)) {
        return false;
    }

