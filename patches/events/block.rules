
# ブロックのイベント。
#
# アンカーは vanilla のソースそのまま。Minecraft が更新されて行が変わったら
# apply_events.py が失敗するので、発火が黙って消えることはない。

# BlockBreakEvent
#
# vanilla の権限判定(冒険モード・保護・GameMasterBlock・blockActionRestricted)が
# 全て終わったあと、最初の書き換えである playerWillDestroy の直前で発火する。
# 取り消されなければ、以降は vanilla のまま。
file: net/minecraft/server/level/ServerPlayerGameMode.java
anchor:
    block.playerWillDestroy(this.level, pos, blockState, this.player);
insert:
    if (!dev.shifu.event.ShifuEvents.blockBreak(this.player, pos)) {
        return false;
    }

# BlockBreakEvent#setDropItems(false)
#
# Paper は playerDestroy に引数を足して落とし物を出さない。Shifu は vanilla の playerDestroy を
# そのまま呼び、そのあいだに出た ItemEntity を ShifuEvents.addEntityGoesOn(addEntity の頭)で
# 世界に入れずに捨てる。登録が無ければ blockDropsBegin は何も捨てない。
#
# 読んだ位置: Paper-Server src/main/java/net/minecraft/server/level/ServerPlayerGameMode.java(destroyBlock、isDropItems)
file: net/minecraft/server/level/ServerPlayerGameMode.java
anchor:
    if (flag && hasCorrectToolForDrops) {
    block.playerDestroy(this.level, this.player, pos, blockState, blockEntity, itemStack);
    }
insert:
    dev.shifu.event.ShifuEvents.blockDropsBegin(this.player, pos);
insert-after:
    dev.shifu.event.ShifuEvents.blockDropsEnd();

# TNTPrimeEvent
#
# 1.18.2 の TntBlock.explode は真偽値を返さない。中で発火して取り消すと、
# 呼び手の removeBlock / setBlock(AIR) はそのまま走るので、TNT が何も残さずに消えた。
# 呼び手ごとに、まだ止められる位置で発火する。理由も呼び手の側で渡す。
#
# 誘爆は vanilla が setBlock(AIR) のあとに wasExploded を呼ぶので、そこでは止められない。
# Explosion.finalizeExplosion の中で、壊す手前に見る。
#
# 1.18.2 のイベントは com.destroystokyo.paper.event.block.TNTPrimeEvent で、
# 理由は EXPLOSION / FIRE / ITEM / PROJECTILE / REDSTONE の 5 つ。
# playerWillDestroy とディスペンサーに当たる理由が無いので、Paper と同じくそこでは出さない。
#
# 読んだ位置: Paper-Server src/main/java/net/minecraft/world/level/block/TntBlock.java:40,54,78,113,150

# onPlace と neighborChanged(レッドストーン)。同じ 2 行が 2 箇所にある
file: net/minecraft/world/level/block/TntBlock.java
anchor:
    explode(world, pos);
    world.removeBlock(pos, false);
count: 2
insert:
    if (!dev.shifu.event.ShifuEvents.tntPrime(world, pos,
            com.destroystokyo.paper.event.block.TNTPrimeEvent.PrimeReason.REDSTONE, null)) {
        return;
    }

# use(火打ち石・ファイヤーチャージ)
file: net/minecraft/world/level/block/TntBlock.java
anchor:
    explode(world, pos, player);
insert:
    if (!dev.shifu.event.ShifuEvents.tntPrime(world, pos,
            com.destroystokyo.paper.event.block.TNTPrimeEvent.PrimeReason.ITEM, player)) {
        return InteractionResult.FAIL;
    }

# onProjectileHit(燃えている矢など)
file: net/minecraft/world/level/block/TntBlock.java
anchor:
    explode(world, blockPos, owner instanceof LivingEntity ? (LivingEntity)owner : null);
    world.removeBlock(blockPos, false);
insert:
    if (!dev.shifu.event.ShifuEvents.tntPrime(world, blockPos,
            com.destroystokyo.paper.event.block.TNTPrimeEvent.PrimeReason.PROJECTILE, projectile)) {
        return;
    }

# 誘爆。TNT 以外の位置でも通るので、登録を見てからブロックを見る
file: net/minecraft/world/level/Explosion.java
anchor:
    if (!blockState.isAir()) {
insert:
    if (!dev.shifu.event.ShifuEvents.tntPrimeByExplosion(this.level, blockPos, this)) {
        continue;
    }

