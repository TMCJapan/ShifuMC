insert:
    final java.util.Map<Slot, ItemStack[]> shifuDragBefore = dev.shifu.event.ItemEvents.dragBefore(this.quickcraftSlots);
    final ItemStack shifuDragCarried = shifuDragBefore == null ? null : this.getCarried().copy();

file: net/minecraft/world/inventory/AbstractContainerMenu.java
