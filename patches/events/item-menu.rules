# ---------------------------------------------------------------- EntityShootBowEvent
#
# createProjectile / shootProjectile は protected なので、登録があるときはここで作って発射方向を付け、
# 発火と世界に足すのは ItemEvents.shootBow が行う。
# 読んだ位置: paper-server patches/sources/net/minecraft/world/item/ProjectileWeaponItem.java.patch
file: net/minecraft/world/item/ProjectileWeaponItem.java
anchor:
    Projectile.spawnProjectile(
        this.createProjectile(level, shooter, weapon, itemStack, isCrit),
        level,
        itemStack,
        projectile -> this.shootProjectile(shooter, projectile, i1, velocity, inaccuracy, f4, target)
    );
insert:
    if (dev.shifu.event.ItemEvents.shootBowListening()) {
        final Projectile shifuProjectile = this.createProjectile(level, shooter, weapon, itemStack, isCrit);
        this.shootProjectile(shooter, shifuProjectile, i1, velocity, inaccuracy, f4, target);
        if (!dev.shifu.event.ItemEvents.shootBow(level, shooter, weapon, itemStack, shifuProjectile, hand, velocity)) {
            return;
        }
    } else {
