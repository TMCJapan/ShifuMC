insert:
    final io.papermc.paper.event.player.PlayerChangeBeaconEffectEvent shifuBeacon =
            dev.shifu.event.ItemEvents.changeBeaconEffect(this.inventory.player, this.access,
                    primary.orElse(null), secondaryEffect.orElse(null));
    if (shifuBeacon != null) {
        if (shifuBeacon.isCancelled()) {
            return;
        }
        primary = java.util.Optional.ofNullable(dev.shifu.event.ItemEvents.effect(shifuBeacon.getPrimary()));
        secondaryEffect = java.util.Optional.ofNullable(dev.shifu.event.ItemEvents.effect(shifuBeacon.getSecondary()));
    }

