# ---------------------------------------------------------------- PlayerLecternPageChangeEvent
#
# ページを書き込む前。ページが差し替えられたときは自分で書いて抜ける(vanilla の 2 文と同じ)。
# 読んだ位置: paper-server patches/sources/net/minecraft/world/inventory/LecternMenu.java.patch
file: net/minecraft/world/inventory/LecternMenu.java
anchor:
    this.setData(0, k - 1);
insert:
    final int shifuPage = dev.shifu.event.ItemEvents.lecternPage(this, player,
            io.papermc.paper.event.player.PlayerLecternPageChangeEvent.PageChangeDirection.LEFT, k, k - 1);
    if (shifuPage == dev.shifu.event.ItemEvents.CANCELLED) {
        return false;
    }
    if (shifuPage != k - 1) {
        this.setData(0, shifuPage);
        return true;
    }

file: net/minecraft/world/inventory/LecternMenu.java
anchor:
    this.setData(0, j + 1);
insert:
    final int shifuPage = dev.shifu.event.ItemEvents.lecternPage(this, player,
            io.papermc.paper.event.player.PlayerLecternPageChangeEvent.PageChangeDirection.RIGHT, j, j + 1);
    if (shifuPage == dev.shifu.event.ItemEvents.CANCELLED) {
        return false;
    }
    if (shifuPage != j + 1) {
        this.setData(0, shifuPage);
        return true;
    }

# ---------------------------------------------------------------- PlayerLoomPatternSelectEvent
#
# 模様を書き込む前。差し替えられたときは自分で書いて抜ける。取り消しは手元を送り直して false。
# 読んだ位置: paper-server patches/sources/net/minecraft/world/inventory/LoomMenu.java.patch(PlayerLoomPatternSelectEvent)
file: net/minecraft/world/inventory/LoomMenu.java
anchor:
    this.selectedBannerPatternIndex.set(id);
    this.setupResultSlot(this.selectablePatterns.get(id));
insert:
    final dev.shifu.event.ItemEvents.LoomChoice shifuLoom = dev.shifu.event.ItemEvents.loomPattern(
            this, player, this.selectablePatterns, id);
    if (shifuLoom != null) {
        if (shifuLoom.cancelled()) {
            player.containerMenu.sendAllDataToRemote();
            return false;
        }
        this.selectedBannerPatternIndex.set(shifuLoom.index());
        this.setupResultSlot(shifuLoom.pattern());
        return true;
    }

# ---------------------------------------------------------------- PlayerStonecutterRecipeSelectEvent
#
# vanilla が番号を書き込んだあと、結果を置く前(Paper と同じ)。
# 読んだ位置: paper-server patches/sources/net/minecraft/world/inventory/StonecutterMenu.java.patch
file: net/minecraft/world/inventory/StonecutterMenu.java
anchor:
    this.setupResultSlot(id);
insert:
    final int shifuRecipe = dev.shifu.event.ItemEvents.stonecutterRecipe(this, player, this.recipesForInput, id);
    if (shifuRecipe == dev.shifu.event.ItemEvents.CANCELLED) {
        player.containerMenu.sendAllDataToRemote();
        return false;
    }
    if (shifuRecipe != id) {
        this.selectedRecipeIndex.set(shifuRecipe);
        this.setupResultSlot(shifuRecipe);
        return true;
    }

# ---------------------------------------------------------------- BlockCanBuildEvent
#
# 登録があれば vanilla の判定の式を同じ形で評価して発火し、イベントの答えで抜ける。
