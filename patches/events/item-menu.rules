            || dev.shifu.event.ItemEvents.grindstoneExp((net.minecraft.server.level.ServerLevel) world, pos, this.getExperienceAmount(world))) {
insert-after:
    }

# ---------------------------------------------------------------- PlayerChangeBeaconEffectEvent
#
# 効果を書き込む前。取り消しは true で抜ける(Paper と同じ。切断させない)。差し替えは
# vanilla の局所変数に代入して vanilla の行に書き込ませる。消費は willConsumeItem で囲む。
# 読んだ位置: paper-server patches/sources/net/minecraft/world/inventory/BeaconMenu.java.patch
file: net/minecraft/world/inventory/BeaconMenu.java
