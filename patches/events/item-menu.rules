
# アイテム(world/item)とメニュー(world/inventory)のイベント。手で書いたもの。
# 発火層は src/event/java/dev/shifu/event/ItemEvents.java。
#
# Paper が vanilla のメソッドを作り変えているもの(投擲物・花火・釣り竿・弓)は、
# vanilla の行を残したまま「登録があれば Paper と同じ手順、無ければ vanilla の行」の
# 形で囲む。登録が無いときに実行される命令列は vanilla と同一。

# ---------------------------------------------------------------- InventoryDragEvent
#
# vanilla がスロットと手持ちを置いたあとに発火し、取り消されたら控えに戻す。
# 控えはドラッグの並びを置く直前に取る(登録が無ければ null で、真偽値 1 つ分の仕事)。
# 読んだ位置: paper-server patches/sources/net/minecraft/world/inventory/AbstractContainerMenu.java.patch(InventoryDragEvent)
file: net/minecraft/world/inventory/AbstractContainerMenu.java
anchor:
    for (Slot slot1 : this.quickcraftSlots) {
insert:
    dev.shifu.event.ItemEvents.dragBefore(this.quickcraftSlots, this);

file: net/minecraft/world/inventory/AbstractContainerMenu.java
anchor:
    itemStack.setCount(count);
    this.setCarried(itemStack);
insert-after:
    // quickcraftType の読みと比較は登録があるときだけ
    if (dev.shifu.event.EventGuard.listening(org.bukkit.event.inventory.InventoryDragEvent.class)) {
        dev.shifu.event.ItemEvents.drag(this, this.quickcraftType == QUICKCRAFT_TYPE_GREEDY, player);
    }

file: net/minecraft/world/inventory/GrindstoneMenu.java
anchor:
    ExperienceOrb.award((ServerLevel)world, Vec3.atCenterOf(pos), this.getExperienceAmount(world));
insert:
    if (!dev.shifu.event.ItemEvents.grindstoneExpListening()
            || dev.shifu.event.ItemEvents.grindstoneExp((net.minecraft.server.level.ServerLevel) world, pos, this.getExperienceAmount(world))) {
