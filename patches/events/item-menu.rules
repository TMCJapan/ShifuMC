    }

# ---------------------------------------------------------------- EnchantItemEvent
#
# 経験値を払う前(Paper と同じ)。取り消し(経験値不足・空も)なら抜ける。付けるエンチャントは
# vanilla の局所変数 newEnchantment に代入して vanilla のループに付けさせる。
# PrepareItemEnchantEvent は patches/events/generated にある。
# 読んだ位置: paper-server patches/sources/net/minecraft/world/inventory/EnchantmentMenu.java.patch(EnchantItemEvent)
file: net/minecraft/world/item/BoatItem.java
anchor:
    AbstractBoat boat = this.getBoat(level, playerPovHitResult, itemInHand, user);
insert:
    if (!dev.shifu.event.ItemEvents.boatInteract(user, (net.minecraft.world.phys.BlockHitResult) playerPovHitResult, itemInHand, hand)) {
        return InteractionResult.PASS;
    }

file: net/minecraft/world/item/BoatItem.java
anchor:
    world.addFreshEntity(boat);
insert:
    if (!dev.shifu.event.ItemEvents.entityPlace(world, ((net.minecraft.world.phys.BlockHitResult) playerPovHitResult).getBlockPos(),
            user.getDirection(), user, boat, hand)) {
        return InteractionResult.FAIL;
    }
    if (dev.shifu.event.ItemEvents.spawnCancelListening()) {
        if (!world.addFreshEntity(boat)) {
            return InteractionResult.PASS;
        }
    } else {
insert-after:
    }

# ---------------------------------------------------------------- トロッコ
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/item/MinecartItem.java.patch
file: net/minecraft/world/item/MinecartItem.java
anchor:
    serverLevel.addFreshEntity(abstractMinecart);
insert:
    if (!dev.shifu.event.ItemEvents.entityPlace(level, clickedPos, context.getClickedFace(), context.getPlayer(), abstractMinecart, context.getHand())) {
        if (context.getPlayer() != null) {
            context.getPlayer().containerMenu.forceHeldSlot(context.getHand());
        }
        return InteractionResult.FAIL;
    }
    if (dev.shifu.event.ItemEvents.spawnCancelListening()) {
        if (!serverLevel.addFreshEntity(abstractMinecart)) {
            return InteractionResult.PASS;
        }
    } else {
insert-after:
    }

