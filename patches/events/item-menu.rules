# ---------------------------------------------------------------- PlayerItemDamageEvent
#
# 減りが決まったあと。取り消しは 0 にして vanilla の「0 なら何もしない」に乗せる。
# 読んだ位置: paper-server patches/sources/net/minecraft/world/item/ItemStack.java.patch(PlayerItemDamageEvent)
file: net/minecraft/world/item/ItemStack.java
anchor:
    int i = this.processDurabilityChange(damage, level, player);
insert-after:
    if (i > 0 && player != null) {
        i = dev.shifu.event.ItemEvents.itemDamage(this, player, i, damage);
    }

file: net/minecraft/world/item/ItemStack.java
anchor:
    int min = Math.min(this.getDamageValue() + i, this.getMaxDamage() - 1);
insert-after:
    if (min - this.getDamageValue() > 0) {
        final int shifuDamage = dev.shifu.event.ItemEvents.itemDamage(this, serverPlayer, min - this.getDamageValue(), damage);
        if (shifuDamage == 0) {
            return;
        }
        min = Math.min(this.getDamageValue() + shifuDamage, this.getMaxDamage() - 1);
    }
