# ---------------------------------------------------------------- EntityAttemptSmashAttackEvent
#
# vanilla の判定の前。DENY なら何もせず抜ける(vanilla の if のあとには何も無い)。
# 読んだ位置: paper-server patches/sources/net/minecraft/world/item/MaceItem.java.patch

# ---------------------------------------------------------------- 投擲物の発射(登録があるとき)
#
# 上の if (!launchListening()) で飛ばした音・統計・消費を、取り消されなかったときに
# ItemEvents.launch が行う。飛ばしたままだったので、PlayerLaunchProjectileEvent に
# 登録があると投擲物が減らず、無限に投げられた。
#
# 読んだ位置: Paper-Server src/main/java/net/minecraft/world/item/SnowballItem.java(PlayerLaunchProjectileEvent)

file: net/minecraft/world/item/SnowballItem.java
anchor:
    world.addFreshEntity(snowball);
insert:
    if (dev.shifu.event.ItemEvents.launchListening()) {
        if (!dev.shifu.event.ItemEvents.launch(world, user, itemInHand, snowball,
                SoundEvents.SNOWBALL_THROW, SoundSource.NEUTRAL, 0)) {
            return InteractionResultHolder.fail(itemInHand);
        }
    } else {
insert-after:
    }

