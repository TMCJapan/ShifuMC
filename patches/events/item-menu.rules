file: net/minecraft/world/item/BlockItem.java
anchor:
    return (!this.mustSurvive() || state.canSurvive(context.getLevel(), context.getClickedPos()))
insert:
    if (dev.shifu.event.ItemEvents.canBuildListening()) {
        return dev.shifu.event.ItemEvents.canBuild(context.getLevel(), context.getClickedPos(), player, state,
                (!this.mustSurvive() || state.canSurvive(context.getLevel(), context.getClickedPos()))
                        && context.getLevel().isUnobstructed(state, context.getClickedPos(), CollisionContext.placementContext(player)),
                context.getHand());
    }

