# ---------------------------------------------------------------- 花火
#
# ブロックに向けて使う: PlayerLaunchProjectileEvent。取り消しは PASS、消費しないなら手元を送り直す。
# 読んだ位置: paper-server patches/sources/net/minecraft/world/item/FireworkRocketItem.java.patch
# 1.19.4 は itemStack.shrink(1) が use() にもあって 1 行では定まらないので、
# addFreshEntity と shrink の 2 行を 1 つの規則で囲む。消費しないときは
# 差し込みの側で同じ addFreshEntity を呼んで shrink だけを飛ばす。
file: net/minecraft/world/item/FireworkRocketItem.java
anchor:
    level.addFreshEntity(fireworkRocketEntity);
insert:
    final boolean shifuFireworkConsume;
    if (dev.shifu.event.ItemEvents.launchListening()) {
        final Boolean shifuLaunched = dev.shifu.event.ItemEvents.launchFirework(level, context.getPlayer(), context.getHand(),
                itemInHand, clickLocation, clickedFace);
        if (shifuLaunched == null) {
            return InteractionResult.PASS;
        }
        shifuFireworkConsume = shifuLaunched;
    } else {
        shifuFireworkConsume = true;
    }
    if (!shifuFireworkConsume) {
        level.addFreshEntity(fireworkRocketEntity);
        context.getPlayer().containerMenu.sendAllDataToRemote();
    } else {
insert-after:
    }

