        return dev.shifu.event.ItemEvents.canBuild(context.getLevel(), blockPos, context.getPlayer(), blockState2,
                levelReader.isUnobstructed(blockState2, blockPos, CollisionContext.empty()), context.getHand())
                ? blockState2 : null;
    }

