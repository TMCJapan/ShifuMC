    // 終わりまで slot を空けない)。
    {
        final Either<Player.BedSleepingProblem, Unit> shifuBed = dev.shifu.event.ShifuEvents.bedEnter(this, pos);
        if (shifuBed != null) {
            return shifuBed;
        }
    }

