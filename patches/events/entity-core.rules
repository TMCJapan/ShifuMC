# entity-core(Entity、LivingEntity、Mob、飛び道具、乗り物など)のイベント発火。
# 発火層は src/event/java/dev/shifu/event/EntityEvents.java。
#
# 形は player.rules と同じ。vanilla の行は残し、前後に差し込む。
# 「囲む」形では、アンカーの最初の行の前に `if (...) {`、最後の行の後に `}` を置く。
# 囲みたい文の直後が vanilla の `}` だけのときは、その `}` に自分の if を閉じさせ、
# insert-after で vanilla の塊を閉じ直す(Bat.hurtServer)。

# ============================================================ Entity

# PlayerUnleashEntityEvent(持ち主が手で外す)
#
# 1.20.6 は Mob.interact が外す(1.21.x の Leashable は無い)。
# 取り消されたら繋いだままにして、クライアントへ繋ぎ直しの packet を送る。
file: net/minecraft/world/entity/Mob.java
anchor:
    this.dropLeash(true, !player.hasInfiniteMaterials());
insert:
    final Boolean shifuDropLeash = dev.shifu.event.EntityEvents.unleashByPlayer(this, player, hand, !player.hasInfiniteMaterials());
    if (shifuDropLeash == null) {
        ((net.minecraft.server.level.ServerPlayer) player).connection.send(
                new net.minecraft.network.protocol.game.ClientboundSetEntityLinkPacket(this, this.getLeashHolder()));
        return InteractionResult.PASS;
    }
    if (shifuDropLeash != !player.hasInfiniteMaterials()) {
        this.dropLeash(true, shifuDropLeash);
    } else

