# handleCauldronLevelChangeEvent
# 1.18.2 は雨受けと鍾乳石の滴りの両方がこの 1 行なので、2 箇所に差し込む
file: net/minecraft/world/level/block/CauldronBlock.java
anchor:
    world.setBlockAndUpdate(pos, Blocks.WATER_CAULDRON.defaultBlockState());
count: 2
insert:
    final org.bukkit.craftbukkit.block.CraftBlockState shifuBlock13 = dev.shifu.event.ShifuEvents.blockChangeBefore(world, pos, org.bukkit.event.block.CauldronLevelChangeEvent.getHandlerList());
insert-after:
    dev.shifu.event.ShifuEvents.cauldronLevelChange(world, pos, shifuBlock13, null, org.bukkit.event.block.CauldronLevelChangeEvent.ChangeReason.NATURAL_FILL);

