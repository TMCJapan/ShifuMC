# Paper が setBlock を発火つきの版に置き換えた箇所。tools/make_block_events.py が出したもの。
#
#     python tools/make_block_events.py <patches/sources> <木> patches/events/block-change.rules
#
# vanilla の setBlock の行は残す。置く前に控えを取り(登録が無ければ null)、
# 置いたあとに発火して、取り消されたら控えに戻す。通る経路は vanilla のまま。
# アンカーが 2 行以上のものは、setBlock の行だけでは定まらないので直前の行を足してある。

# handleBlockFormEvent
#
# main(26.2)の 53 件のうち、reanchor.py で 1.20.6 の行に当たった分を写した。

# handleBlockFormEvent
file: net/minecraft/server/level/ServerLevel.java
anchor:
    this.setBlockAndUpdate(blockPos2, Blocks.ICE.defaultBlockState());
insert:
    final org.bukkit.craftbukkit.block.CraftBlockState shifuBlock5 = dev.shifu.event.ShifuEvents.blockChangeBefore(this, blockPos2, org.bukkit.event.block.BlockFormEvent.getHandlerList());
insert-after:
    dev.shifu.event.ShifuEvents.blockForm(this, blockPos2, shifuBlock5, net.minecraft.world.level.block.Block.UPDATE_ALL, null);

