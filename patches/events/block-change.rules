# Paper が setBlock を発火つきの版に置き換えた箇所。tools/make_block_events.py が出したもの。
#
#     python tools/make_block_events.py <patches/sources> <木> patches/events/block-change.rules
#
# vanilla の setBlock の行は残す。置く前に控えを取り(登録が無ければ null)、
# 置いたあとに発火して、取り消されたら控えに戻す。通る経路は vanilla のまま。
# アンカーが 2 行以上のものは、setBlock の行だけでは定まらないので直前の行を足してある。

# handleCauldronLevelChangeEvent
file: net/minecraft/core/cauldron/CauldronInteractions.java
anchor:
    level.setBlockAndUpdate(pos, Blocks.WATER_CAULDRON.defaultBlockState());
insert:
    final org.bukkit.craftbukkit.block.CraftBlockState shifuBlock1 = dev.shifu.event.ShifuEvents.blockChangeBefore(level, pos, org.bukkit.event.block.CauldronLevelChangeEvent.getHandlerList());
insert-after:
    dev.shifu.event.ShifuEvents.cauldronLevelChange(level, pos, shifuBlock1, player, org.bukkit.event.block.CauldronLevelChangeEvent.ChangeReason.BOTTLE_EMPTY);

