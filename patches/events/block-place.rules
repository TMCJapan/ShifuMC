# BlockPlaceEvent。手で書いたもの。
#
# Paper はブロックキャプチャを使って「置く前に発火し、通ってから置く」に
# 作り変える。あれは設置そのものを遅らせるので、周囲のブロックへ更新が届く
# 順番が変わる。条件 1(vanilla と完全に一致)を壊すので使わない。
#
# Shifu は vanilla の順のまま置き、置いたあとに発火する。取り消されたときだけ、
# 置く前に控えておいた状態へ戻して FAIL を返す。通る経路は vanilla のまま。
#
# 控えを取るのは placeBlock の直前。登録が無ければ控えも取らない(null)ので、
# プラグインを入れていないときに増える仕事は真偽値 1 つ分。
#
# 発火は placedState が確定したあと、音・gameEvent・手持ちの減りより前。
# 取り消したときにその 3 つが起きないのは、Paper と同じ。
#
# 戻すときの旗は UPDATE_CLIENTS | UPDATE_KNOWN_SHAPE。UPDATE_ALL で戻すと形の更新が
# 隣へ届き、まだ残っているもう片方(ベッドの頭、扉や背の高い花の上半分)が
# updateShape で空気になって、Block.updateOrDestroy の destroyBlock(pos, true) で
# ドロップまで出る。手持ちは FAIL のまま減らないので、取り消すたびにブロックが増えていた。
# 2 つ目以降の場所は ShifuEvents.revertPlace が同じ旗で戻す。
#
# 読んだ位置(Paper 26.2):
#   paper-server src/main/java/org/bukkit/craftbukkit/event/CraftEventFactory.java:519
#   vanilla      net/minecraft/world/item/BlockItem.java:67,86
#   paper-server src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java:193(戻すときの旗)

file: net/minecraft/world/item/BlockItem.java
anchor:
    BlockState placementState = this.getPlacementState(blockPlaceContext);
insert-after:
    final org.bukkit.block.BlockState shifuReplaced = dev.shifu.event.ShifuEvents.armPlace(blockPlaceContext);

# 置いたあとに発火する。取り消されたら控えへ戻して FAIL を返す。
# getBlockAgainst() に渡すのは当たったブロック(getHitResult)。getClickedPos は
# 置いた位置なので、置いた位置そのものが返っていた(main / 1.21.11 と同じ形にした)。
file: net/minecraft/world/item/BlockItem.java
anchor:
    SoundType soundType = blockState.getSoundType();
insert:
    if (shifuReplaced != null && level instanceof net.minecraft.server.level.ServerLevel shifuLevel
            && !dev.shifu.event.ShifuEvents.blockPlace(
                    shifuLevel, player, blockPlaceContext.getHand(), shifuReplaced,
                    blockPlaceContext.getHitResult().getBlockPos())) {
        dev.shifu.event.ShifuEvents.revertPlace(shifuLevel);
        shifuLevel.setBlock(clickedPos, ((org.bukkit.craftbukkit.block.CraftBlockState) shifuReplaced).getHandle(),
                net.minecraft.world.level.block.Block.UPDATE_CLIENTS
                        | net.minecraft.world.level.block.Block.UPDATE_KNOWN_SHAPE);
        return InteractionResult.FAIL;
    }
