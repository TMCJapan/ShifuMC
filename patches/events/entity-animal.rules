anchor:
    brain.setMemory(MemoryModuleType.TEMPTING_PLAYER, player);
insert:
    final int shifuTempt = dev.shifu.event.AnimalEvents.tempt(entity, player);
    if (shifuTempt == dev.shifu.event.AnimalEvents.CANCEL) {
        return;
    }
    if (shifuTempt == dev.shifu.event.AnimalEvents.KEEP) {
insert-after:
    } else if (shifuTempt == dev.shifu.event.AnimalEvents.ERASE) {
        brain.eraseMemory(MemoryModuleType.TEMPTING_PLAYER);
    } else {
        brain.setMemory(MemoryModuleType.TEMPTING_PLAYER, dev.shifu.event.AnimalEvents.temptTarget());
    }

