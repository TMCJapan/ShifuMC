# ============================================================ ポーション効果の理由(EntityPotionEffectEvent.Cause)
#
# Paper は addEffect / removeEffect に Cause の引数を足して呼び出し側から渡す。Shifu は
# 呼ぶ直前に置き、LivingEntity の中の発火(EntityEvents.effectAdd / effectRemove)が取り出す。
# 置くのは登録があるときだけ。1 つの文が何度も効果を付けるところ(ポーションの効果の並び、
# 周りのプレイヤー全員)は effectCauseUntilDone で置き、文のあとで effectCauseDone で外す。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/item/**/*.java.patch(EntityPotionEffectEvent.Cause)

# ゾンビ村人が治る途中(弱化を消して力を付ける)
# 弱化を消して力を付ける 2 つが続くので、その間だけ置く
file: net/minecraft/world/entity/monster/ZombieVillager.java
anchor:
    this.removeEffect(MobEffects.WEAKNESS);
    this.addEffect(new MobEffectInstance(MobEffects.DAMAGE_BOOST, delay, Math.min(this.level.getDifficulty().getId() - 1, 0)));
insert:
    dev.shifu.event.EntityEvents.effectCauseUntilDone(org.bukkit.event.entity.EntityPotionEffectEvent.Cause.CONVERSION);
insert-after:
    dev.shifu.event.EntityEvents.effectCauseDone();

