# PlayerCommandPreprocessEvent。コマンドを組み立てる直前。
# 差し替えられたら、差し替えた文で呼び直して vanilla の続きを飛ばす。
# 1.18.2 は handleCommand(String) の 1 経路。input は先頭に "/" が付いているので落として渡す
file: net/minecraft/server/network/ServerGamePacketListenerImpl.java
anchor:
    this.server.getCommands().performCommand(this.player.createCommandSourceStack(), input);
insert:
    if (!dev.shifu.event.PlayerEvents.commandPreprocess(this, input.substring(1))) {
        return;
    }

