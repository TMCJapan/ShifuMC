    }

# EntityDeathEvent
#
# Paper は die() の前半をまるごと Runnable に包み、dropAllDeathLoot を
# イベントより前に動かして、取り消されたら蘇生する。前半の入れ替えは
# vanilla の行の書き換えになるので入れられない。
#
# Shifu は vanilla の順のまま dropAllDeathLoot を走らせ、その間だけ
# 世界に入ろうとする ItemEntity を控えに移す。控え終えてから発火し、
# プラグインが直した中身を CraftEventFactory が世界へ出す。
# 登録が無ければ控えを取らないので、落とし物はその場で世界に入る
# (= vanilla のまま)。
#
# 経験値オーブも同じ控えに入る。setDroppedExp で量が変わっていなければ
# vanilla が作ったオーブをそのまま出し、変わっていれば作り直す。
#
# 未対応: 取り消しによる蘇生。取り消されたときは落とし物と経験値を vanilla のとおり出す。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/entity/LivingEntity.java.patch:809
file: net/minecraft/world/entity/LivingEntity.java
anchor:
    this.dropAllDeathLoot(serverLevel, source);
insert:
    final java.util.List<net.minecraft.world.entity.Entity.DefaultDrop> shifuDeathDrops =
            dev.shifu.event.ShifuEvents.beginDeathDrops();
insert-after:
    dev.shifu.event.ShifuEvents.entityDeath(serverLevel, this, source, shifuDeathDrops);

# EntityExplodeEvent / BlockExplodeEvent
#
# 壊す位置の並びが決まって並べ替えられた直後。Paper と同じ位置。
# プラグインが直した並びを targetBlocks に書き戻す。取り消されたら
# 壊さずに抜け、ServerLevel.explode の告知(packet)も飛ばす。
#
# 未対応: setYield。落ちる確率は戦利品表が爆発の半径から読むので、渡す先が無い。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/level/ServerExplosion.java.patch:215,
#            paper-server patches/sources/net/minecraft/server/level/ServerLevel.java.patch:893
file: net/minecraft/world/level/ServerExplosion.java
anchor:
    Util.shuffle(targetBlocks, this.level.random);
insert-after:
    if (!dev.shifu.event.ShifuEvents.explode(this, targetBlocks)) {
        return;
    }

file: net/minecraft/server/level/ServerLevel.java
anchor:
    int blockCount = explosion.explode();
insert-after:
    if (dev.shifu.event.ShifuEvents.explosionCancelled(explosion)) {
        return;
    }
