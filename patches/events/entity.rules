# エンティティのイベント。手で書いたもの。
#
# どれも「登録が無ければ null が返り、vanilla の行がそのまま走る」形。
# vanilla の行は 1 文字も変えず、前後で分岐するだけ。

# EntityRegainHealthEvent
#
# Paper は heal に理由の引数を足して呼び出し側から渡すが、Shifu は vanilla の
# 署名を変えないので理由は CUSTOM 固定になる。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/entity/LivingEntity.java.patch:441
file: net/minecraft/world/entity/LivingEntity.java
anchor:
    this.setHealth(health + heal);
insert:
    final org.bukkit.event.entity.EntityRegainHealthEvent shifuRegain =
            dev.shifu.event.ShifuEvents.entityRegainHealth(this, heal);
    if (shifuRegain == null) {
insert-after:
    } else if (!shifuRegain.isCancelled()) {
        this.setHealth((float) (this.getHealth() + shifuRegain.getAmount()));
    }

# FoodLevelChangeEvent
#
# 空腹による減少。食事の側(FoodData.eat)は Paper が新しい引数付きの版を
# 足して呼び出し側から呼ばせているので、ここでは入れていない。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/food/FoodData.java.patch:39
file: net/minecraft/world/food/FoodData.java
anchor:
    this.foodLevel = Math.max(this.foodLevel - 1, 0);
insert:
    final org.bukkit.event.entity.FoodLevelChangeEvent shifuFood =
            dev.shifu.event.ShifuEvents.foodLevelChange(player, Math.max(this.foodLevel - 1, 0));
    if (shifuFood == null) {
insert-after:
    } else if (!shifuFood.isCancelled()) {
        this.foodLevel = shifuFood.getFoodLevel();
    }

# EntityDamageEvent
#
# 発火は眠りを覚ます行の手前(ShifuEvents.entityDamageBefore)。vanilla と同じ式で
# actuallyHurt に渡る量を先に求め(盾は防いだ量だけを見て、耐久や反動は通さない)、
# 取り消されたら何もせずに false を返す。actuallyHurt の手前で発火していたときは、
# 取り消しても眠りの解除・盾の耐久・盾で弾いた攻撃者への反動・兜の耐久が済んでいた。
# Paper も盾を dryRun で見てから発火し、取り消しで抜ける。
#
# 通れば actuallyHurt を囲んだ所でイベントを受け取り、setDamage の値で呼ぶ。
# 2 箇所ある(無敵時間中の差分と、通常)。登録が無ければ null で、vanilla の行がそのまま走る。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/entity/LivingEntity.java.patch:506-560
file: net/minecraft/world/entity/LivingEntity.java
anchor:
    if (this.isSleeping()) {
    this.stopSleeping();
    }

    this.noActionTime = 0;
insert:
    if (!dev.shifu.event.ShifuEvents.entityDamageBefore(this, level, source, damage)) {
        return false;
    }

file: net/minecraft/world/entity/LivingEntity.java
anchor:
    this.actuallyHurt(level, source, damage - this.lastHurt);
insert:
    final org.bukkit.event.entity.EntityDamageEvent shifuHurtPartial = dev.shifu.event.ShifuEvents.takeDamage(this);
    if (shifuHurtPartial == null) {
insert-after:
    } else {
        this.actuallyHurt(level, source, (float) shifuHurtPartial.getDamage());
    }

file: net/minecraft/world/entity/LivingEntity.java
anchor:
    this.actuallyHurt(level, source, damage);
insert:
    final org.bukkit.event.entity.EntityDamageEvent shifuHurt = dev.shifu.event.ShifuEvents.takeDamage(this);
    if (shifuHurt == null) {
insert-after:
    } else {
