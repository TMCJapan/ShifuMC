# エンティティのイベント。手で書いたもの。
#
# どれも「登録が無ければ null が返り、vanilla の行がそのまま走る」形。
# vanilla の行は 1 文字も変えず、前後で分岐するだけ。

# EntityRegainHealthEvent
#
# Paper は heal に理由の引数を足して呼び出し側から渡すが、Shifu は vanilla の
# 署名を変えないので理由は CUSTOM 固定になる。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/entity/LivingEntity.java.patch:441
file: net/minecraft/world/food/FoodData.java
anchor:
    this.foodLevel = Math.max(this.foodLevel - 1, 0);
insert:
    final org.bukkit.event.entity.FoodLevelChangeEvent shifuFood =
            dev.shifu.event.ShifuEvents.foodLevelChange(player, Math.max(this.foodLevel - 1, 0));
    if (shifuFood == null) {
insert-after:
    } else if (!shifuFood.isCancelled()) {
        this.foodLevel = shifuFood.getFoodLevel();
    }

# EntityDamageEvent
#
# vanilla の actuallyHurt を囲む。2 箇所ある(無敵時間中の差分と、通常)。
# 登録が無ければ null が返り、vanilla の行がそのまま走る。
#
# 取り消したときは false を返す。この時点で vanilla は既に lastHurt と
# invulnerableTime を書いているので、その 2 つは元に戻らない。Paper は
# もっと手前で取り消すが、そこは vanilla の行の書き換えになるので入れない。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/entity/LivingEntity.java.patch:537,551
file: net/minecraft/world/entity/LivingEntity.java
anchor:
    this.actuallyHurt(level, damageSource, amount - this.lastHurt);
insert:
    final org.bukkit.event.entity.EntityDamageEvent shifuHurtPartial =
            dev.shifu.event.ShifuEvents.entityDamage(this, damageSource, amount - this.lastHurt);
    if (shifuHurtPartial == null) {
insert-after:
    } else if (!shifuHurtPartial.isCancelled()) {
        this.actuallyHurt(level, damageSource, (float) shifuHurtPartial.getDamage());
    } else {
        return false;
    }

file: net/minecraft/world/entity/LivingEntity.java
anchor:
    this.actuallyHurt(level, damageSource, amount);
insert:
    final org.bukkit.event.entity.EntityDamageEvent shifuHurt =
            dev.shifu.event.ShifuEvents.entityDamage(this, damageSource, amount);
    if (shifuHurt == null) {
insert-after:
    } else if (!shifuHurt.isCancelled()) {
        this.actuallyHurt(level, damageSource, (float) shifuHurt.getDamage());
    } else {
        return false;
    }

# EntityDeathEvent
#
# Paper は die() の前半をまるごと Runnable に包み、dropAllDeathLoot を
# イベントより前に動かして、取り消されたら蘇生する。前半の入れ替えは
# vanilla の行の書き換えになるので入れられない。
#
# Shifu は vanilla の順のまま dropAllDeathLoot を走らせ、その間だけ
# 世界に入ろうとする ItemEntity を控えに移す。控え終えてから発火し、
# プラグインが直した中身を CraftEventFactory が世界へ出す。
# 登録が無ければ控えを取らないので、落とし物はその場で世界に入る
# (= vanilla のまま)。
#
# 経験値オーブも同じ控えに入る。setDroppedExp で量が変わっていなければ
# vanilla が作ったオーブをそのまま出し、変わっていれば作り直す。
#
# 未対応: 取り消しによる蘇生。取り消されたときは落とし物と経験値を vanilla のとおり出す。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/entity/LivingEntity.java.patch:809