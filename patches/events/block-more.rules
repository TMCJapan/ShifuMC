file: net/minecraft/world/level/block/FireBlock.java
anchor:
    return this.canSurvive(state, world, pos) ? this.getStateWithAge(world, pos, state.getValue(AGE)) : Blocks.AIR.defaultBlockState();
insert:
    if (dev.shifu.event.BlockEvents.listeningFade() && !this.canSurvive(state, world, pos)
            && !dev.shifu.event.BlockEvents.fade(world, pos, Blocks.AIR.defaultBlockState())) {
        return this.getStateWithAge(world, pos, state.getValue(AGE));
    }

