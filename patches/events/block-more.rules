# ------------------------------------------------------------ 戦利品表を器に詰める
#
# LootGenerateEvent。Paper は vanilla の fill(Container, LootContext) を
# plugin を取る fillInventory へ回して、そちらで発火する。回すのは vanilla の行の
# 書き換えなので、Shifu は fill の同じ位置に置く。vanilla から来る方は plugin = false。
#
# 読んだ位置: Paper-Server src/main/java/net/minecraft/world/level/storage/loot/LootTable.java(fillInventory)
file: net/minecraft/world/level/storage/loot/LootTable.java
anchor:
    List<Integer> availableSlots = this.getAvailableSlots(inventory, random);
    this.shuffleAndSplitItems(randomItems, availableSlots.size(), random);
insert:
    final org.bukkit.event.world.LootGenerateEvent shifuLoot =
            dev.shifu.event.BlockEvents.lootGenerate(inventory, this, context, randomItems, false);
    if (shifuLoot != null) {
        if (shifuLoot.isCancelled()) {
            return;
        }

        randomItems = shifuLoot.getLoot().stream().map(org.bukkit.craftbukkit.inventory.CraftItemStack::asNMSCopy).collect(java.util.stream.Collectors.toList());
    }

# ------------------------------------------------------------ 木の育ちの控えの読み戻し
#
# 控えるのは generated/net-minecraft-world-level-tree-grow.rules(Level.setBlock)。
# 読み戻しが無いと、控えた位置には古いブロック(苗木)が残って見えるので、
# TreeFeature.getMaxFreeTreeHeight が「上が塞がっている」と判断して生成をやめる。
# StructureGrowEvent に登録があると苗木が 1 本も育たず、骨粉だけが減っていた。
#
# 読んだ位置: Paper-Server src/main/java/net/minecraft/world/level/Level.java:1150
file: net/minecraft/world/level/Level.java
anchor:
