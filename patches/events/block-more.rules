# EntityPortalEvent / PlayerPortalEvent(出口を探す前)
file: net/minecraft/world/level/block/NetherPortalBlock.java
anchor:
    return this.getExitPortal(newLevel, entity, portalEntryPos, approximateExitPos, toNether, newWorldBorder);
insert:
    if (dev.shifu.event.BlockEvents.listeningPortal()) {
        final org.bukkit.craftbukkit.event.PortalEventResult shifuPortal = dev.shifu.event.BlockEvents.portalDestination(entity, newLevel, approximateExitPos);
        if (shifuPortal == null) {
            return null;
        }
        newLevel = ((org.bukkit.craftbukkit.CraftWorld) shifuPortal.to().getWorld()).getHandle();
        newWorldBorder = newLevel.getWorldBorder();
        approximateExitPos = newWorldBorder.clampToBounds(shifuPortal.to().getX(), shifuPortal.to().getY(), shifuPortal.to().getZ());
    }

# PlayerInteractEvent(PHYSICAL)/ EntityInteractEvent(感圧板)
