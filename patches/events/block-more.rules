        return dev.shifu.event.BlockEvents.pressurePlateCount(level, pos, TOUCH_AABB.move(pos), clazz) > 0 ? 15 : 0;
    }

file: net/minecraft/world/level/block/WeightedPressurePlateBlock.java
anchor:
    int min = Math.min(getEntityCount(level, TOUCH_AABB.move(pos), Entity.class), this.maxWeight);
insert:
    if (dev.shifu.event.BlockEvents.listeningPressurePlate()) {
        final int shifuCount = Math.min(dev.shifu.event.BlockEvents.pressurePlateCount(level, pos, TOUCH_AABB.move(pos), Entity.class), this.maxWeight);
        return shifuCount > 0 ? Mth.ceil((float) Math.min(this.maxWeight, shifuCount) / this.maxWeight * 15.0F) : 0;
    }

