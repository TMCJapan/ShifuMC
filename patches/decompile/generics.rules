file: net/minecraft/server/players/OldUsersConverter.java
replace:
                        File file = new File(file, fileName + ".dat");
with:
                        File file = new File(playerDataFolder, fileName + ".dat");

# instanceof のパターンに実引数付きの型を書くと、javac 17 は「安全に cast できない」で止める。
# 型引数無しで判定してから cast する(cast は同じクラス間なので命令列は変わらない)
file: net/minecraft/commands/Commands.java
replace:
                if (argumentBuilder instanceof RequiredArgumentBuilder<SharedSuggestionProvider, ?> requiredArgumentBuilder
                    && requiredArgumentBuilder.getSuggestionsProvider() != null) {
                    requiredArgumentBuilder.suggests(SuggestionProviders.safelySwap(requiredArgumentBuilder.getSuggestionsProvider()));
with:
                if (argumentBuilder instanceof RequiredArgumentBuilder<?, ?> requiredArgumentBuilder0
                    && requiredArgumentBuilder0.getSuggestionsProvider() != null) {
                    RequiredArgumentBuilder<SharedSuggestionProvider, ?> requiredArgumentBuilder = (RequiredArgumentBuilder<SharedSuggestionProvider, ?>)requiredArgumentBuilder0;
                    requiredArgumentBuilder.suggests(SuggestionProviders.safelySwap(requiredArgumentBuilder.getSuggestionsProvider()));

