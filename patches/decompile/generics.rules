# 逆コンパイラが基本型を型変数に直接 cast している。javac は箱に入れないと通さない。
# 箱に入れるのは元から起きていること(List<T> に入れている)なので、結果は変わらない
file: net/minecraft/nbt/TagParser.java
replace:
                list.add((T)((NumericTag)value).getAsByte());
with:
                list.add((T)(Object)((NumericTag)value).getAsByte());

file: net/minecraft/nbt/TagParser.java
replace:
                list.add((T)((NumericTag)value).getAsLong());
with:
                list.add((T)(Object)((NumericTag)value).getAsLong());

file: net/minecraft/nbt/TagParser.java
replace:
                list.add((T)((NumericTag)value).getAsInt());
with:
                list.add((T)(Object)((NumericTag)value).getAsInt());

# 逆コンパイラが型引数を落としている。private の構築子はダイヤモンドで推論できない
file: net/minecraft/util/SortedArraySet.java
replace:
        return new SortedArraySet<>(initialCapacity, Comparator.naturalOrder());
with:
        return new SortedArraySet<T>(initialCapacity, Comparator.naturalOrder());

# MutableValue は Settings<T> の内部クラス。外側の実体を付けないと raw type になる
file: net/minecraft/server/dedicated/Settings.java
replace:
        return new Settings.MutableValue<>(key, object, stringifier);
with:
        return this.new MutableValue<V>(key, object, stringifier);

# ? を 2 つ書くと別々に capture される。T に揃える cast が要る
file: net/minecraft/world/level/GameRules.java
replace:
        consumer.visit(key, type);
        type.callVisitor(consumer, key);
with:
        consumer.visit((GameRules.Key<T>)key, (GameRules.Type<T>)type);
        ((GameRules.Type<T>)type).callVisitor(consumer, (GameRules.Key<T>)key);

# DataComponentPatch は 1.18.2 に無い

# toMap の K が Object に落ちて newEnumMap に渡らない
file: net/minecraft/world/entity/animal/Sheep.java
replace:
        Arrays.stream(DyeColor.values()).collect(Collectors.toMap(dyeColor -> (DyeColor)dyeColor, Sheep::createSheepColor))
with:
        Arrays.stream(DyeColor.values()).collect(Collectors.<DyeColor, DyeColor, float[]>toMap(dyeColor -> dyeColor, Sheep::createSheepColor))

# Mob の delayedLeashInfo(Either.right)は 1.18.2 に無い。引き綱は leashInfoTag を読む

# Map<ResourceLocation, Recipe<?>> から Map<ResourceLocation, Recipe<C>> へは直に cast できない(公式は raw の Map に cast している)
file: net/minecraft/world/item/crafting/RecipeManager.java
replace:
        return (Map<ResourceLocation, Recipe<C>>)this.recipes.getOrDefault(type, Collections.emptyMap());
with:
        return (Map<ResourceLocation, Recipe<C>>)(Map)this.recipes.getOrDefault(type, Collections.emptyMap());

# 逆コンパイラが要素の cast を raw な Recipe にしている。返り値の List<T> に届かない
file: net/minecraft/world/item/crafting/RecipeManager.java
replace:
        return this.byType(type).values().stream().map(recipe -> (Recipe)recipe).collect(Collectors.toList());
with:
        return this.byType(type).values().stream().map(recipe -> (T)recipe).collect(Collectors.toList());

# ItemInput の部品を並べる Stream.empty() は 1.18.2 に無い(serialize は NBT をそのまま書く)

# 猫と蛙の種類を直す EntityVariantFix(raw な Int2ObjectOpenHashMap)は 1.18.2 の DataFixers に無い

# RegistrySetBuilder と BuiltInRegistries は 1.18.2 に無い(登録は Registry / BuiltinRegistries)

# Paper が addEffect(MobEffectInstance, Cause) を足したので、null が両方に当たる
file: net/minecraft/world/entity/LivingEntity.java
replace:
    public final boolean addEffect(MobEffectInstance effect) {
        return this.addEffect(effect, null);
    }
with:
    public final boolean addEffect(MobEffectInstance effect) {
        return this.addEffect(effect, (Entity)null);
    }

# CommandNode<CommandSourceStack>.createBuilder() から見ると 1 段では届かない
file: net/minecraft/commands/Commands.java
replace:
                ArgumentBuilder<SharedSuggestionProvider, ?> argumentBuilder = commandNode.createBuilder();
with:
                ArgumentBuilder<SharedSuggestionProvider, ?> argumentBuilder = (ArgumentBuilder<SharedSuggestionProvider, ?>)(ArgumentBuilder<?, ?>)commandNode.createBuilder();

# 本の頁を Filterable<Component> に直す行(filterableFromOutgoing)は 1.18.2 に無い

# Object2IntMap.Entry のメソッド参照は受け手が Object になって当たらない。
# comparing の型引数を書く(comparingInt とラムダに書き換えると、ラムダが 1 つ増えて
# 公式の lambda$…$N の番号がずれる。公式はメソッド参照 getIntValue をそのまま渡している)
file: net/minecraft/server/level/ServerLevel.java
replace:
                .sorted(Comparator.comparing(Entry::getIntValue).reversed())
with:
                .sorted(Comparator.<Entry<String>, Integer>comparing(Entry::getIntValue).reversed())

# BlockPos の無名クラスの局所変数は、1.18.2 の逆コンパイラが i4〜i7 と別の名前にしているので直すものが無い

# ItemInput.getItemName の unwrapKey().map(...) は 1.18.2 に無い(Registry.ITEM.getKey で名前を引く)

# OldUsersConverter は、1.18.2 の逆コンパイラが file3 = new File(worldPlayersDirectory, …) と名前を残しているので直すものが無い

# instanceof のパターンに実引数付きの型を書くと、javac 17 は「安全に cast できない」で止める。
# パターンは型引数を ? にして、使う 2 か所に cast を書く(cast は同じクラス間なので
# checkcast は出ない。局所変数を足すと公式に無い番号の欄が 1 つ増える)
file: net/minecraft/commands/Commands.java
replace:
                if (argumentBuilder instanceof RequiredArgumentBuilder<SharedSuggestionProvider, ?> requiredArgumentBuilder
                    && requiredArgumentBuilder.getSuggestionsProvider() != null) {
                    requiredArgumentBuilder.suggests(SuggestionProviders.safelySwap(requiredArgumentBuilder.getSuggestionsProvider()));
with:
                if (argumentBuilder instanceof RequiredArgumentBuilder<?, ?> requiredArgumentBuilder
                    && requiredArgumentBuilder.getSuggestionsProvider() != null) {
                    ((RequiredArgumentBuilder<SharedSuggestionProvider, ?>) requiredArgumentBuilder).suggests(SuggestionProviders.safelySwap(((RequiredArgumentBuilder<SharedSuggestionProvider, ?>) requiredArgumentBuilder).getSuggestionsProvider()));

# ChunkMap.scheduleChunkLoad は 1.18.2 では supplyAsync の返り値に Either.left を返すだけで、exceptionallyAsync が無いので型が決まる

# 逆コンパイラが cast を落としている。Mojang の版は (Strategy<K>) を付けている
file: net/minecraft/Util.java
replace:
        return Util.IdentityStrategy.INSTANCE;
with:
        return (Strategy<K>)Util.IdentityStrategy.INSTANCE;
