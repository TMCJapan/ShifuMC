# 逆コンパイラが基本型を型変数に直接 cast している。javac は箱に入れないと通さない。
# 箱に入れるのは元から起きていること(List<T> に入れている)なので、結果は変わらない
file: net/minecraft/nbt/TagParser.java
replace:
                list.add((T)((NumericTag)value).getAsByte());
with:
                list.add((T)(Object)((NumericTag)value).getAsByte());

file: net/minecraft/nbt/TagParser.java
replace:
                list.add((T)((NumericTag)value).getAsLong());
with:
                list.add((T)(Object)((NumericTag)value).getAsLong());

file: net/minecraft/nbt/TagParser.java
replace:
                list.add((T)((NumericTag)value).getAsInt());
with:
                list.add((T)(Object)((NumericTag)value).getAsInt());

# 逆コンパイラが型引数を落としている。private の構築子はダイヤモンドで推論できない
file: net/minecraft/util/SortedArraySet.java
replace:
        return new SortedArraySet<>(initialCapacity, Comparator.naturalOrder());
with:
        return new SortedArraySet<T>(initialCapacity, Comparator.naturalOrder());

# MutableValue は Settings<T> の内部クラス。外側の実体を付けないと raw type になる
file: net/minecraft/server/dedicated/Settings.java
replace:
        return new Settings.MutableValue<>(key, object, stringifier);
with:
        return this.new MutableValue<V>(key, object, stringifier);

# ? を 2 つ書くと別々に capture される。T に揃える cast が要る
file: net/minecraft/world/level/GameRules.java
replace:
        consumer.visit(key, type);
        type.callVisitor(consumer, key);
with:
        consumer.visit((GameRules.Key<T>)key, (GameRules.Type<T>)type);
        ((GameRules.Type<T>)type).callVisitor(consumer, (GameRules.Key<T>)key);

