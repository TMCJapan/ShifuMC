with:
                DismountOrSkipMounting.<Piglin>create(8, PiglinAi::wantsToStopRiding)

# 逆コンパイラが基本型を型変数に直接 cast している。javac は箱に入れないと通さない。
# 箱に入れるのは元から起きていること(List<T> に入れている)なので、結果は変わらない
file: net/minecraft/nbt/TagParser.java
replace:
                list.add((T)((NumericTag)tag).getAsByte());
with:
                list.add((T)(Object)((NumericTag)tag).getAsByte());

file: net/minecraft/nbt/TagParser.java
replace:
                list.add((T)((NumericTag)tag).getAsLong());
with:
                list.add((T)(Object)((NumericTag)tag).getAsLong());

file: net/minecraft/nbt/TagParser.java
replace:
                list.add((T)((NumericTag)tag).getAsInt());
with:
                list.add((T)(Object)((NumericTag)tag).getAsInt());

# 逆コンパイラが型引数を落としている。private の構築子はダイヤモンドで推論できない
file: net/minecraft/util/SortedArraySet.java
replace:
        return new SortedArraySet<>(initialCapacity, Comparator.naturalOrder());
with:
        return new SortedArraySet<T>(initialCapacity, Comparator.naturalOrder());

# MutableValue は Settings<T> の内部クラス。外側の実体を付けないと raw type になる
file: net/minecraft/server/dedicated/Settings.java
replace:
        return new Settings.MutableValue<>(key, object, stringifier);
with:
        return this.new MutableValue<V>(key, object, stringifier);

# ? を 2 つ書くと別々に capture される。T に揃える cast が要る
file: net/minecraft/world/level/GameRules.java
replace:
        consumer.visit(key, type);
        type.callVisitor(consumer, key);
with:
        consumer.visit((GameRules.Key<T>)key, (GameRules.Type<T>)type);
        ((GameRules.Type<T>)type).callVisitor(consumer, (GameRules.Key<T>)key);

# dispatchedMap の V が capture になって、書き出す側の Map と合わない
file: net/minecraft/core/component/DataComponentPatch.java
replace:
    public static final Codec<DataComponentPatch> CODEC = Codec.dispatchedMap(DataComponentPatch.PatchKey.CODEC, DataComponentPatch.PatchKey::valueCodec)
with:
    public static final Codec<DataComponentPatch> CODEC = Codec.<DataComponentPatch.PatchKey, Object>dispatchedMap(DataComponentPatch.PatchKey.CODEC, DataComponentPatch.PatchKey::valueCodec)

# toMap の K が Object に落ちて newEnumMap に渡らない
file: net/minecraft/world/entity/animal/Sheep.java
replace:
        Arrays.stream(DyeColor.values()).collect(Collectors.toMap(color -> (DyeColor)color, Sheep::createSheepColor))
with:
        Arrays.stream(DyeColor.values()).collect(Collectors.<DyeColor, DyeColor, float[]>toMap(color -> color, Sheep::createSheepColor))

# Either.right の左側が Object に落ちる
