                .sorted(Comparator.comparing(Entry::getIntValue).reversed())
with:
                .sorted(Comparator.comparingInt((it.unimi.dsi.fastutil.objects.Object2IntMap.Entry<String> entry) -> entry.getIntValue()).reversed())

# 逆コンパイラが無名クラスの中の局所変数を外側と同じ名前にして、自分自身で初期化している。
# Mojang の版は i1 / j1 / k1 / l1。外側の i / j を読む形に戻す
file: net/minecraft/core/BlockPos.java
replace:
                        int i = this.index % i;
                        int j = this.index / i;
                        int k = j % j;
                        int l = j / j;
                        this.index++;
                        return this.cursor.set(startX + i, startY + k, startZ + l);
with:
                        int i1 = this.index % i;
                        int j1 = this.index / i;
                        int k1 = j1 % j;
                        int l1 = j1 / j;
                        this.index++;
                        return this.cursor.set(startX + i1, startY + k1, startZ + l1);

# unwrapKey().map(...) と orElseGet の型が揃わない。どちらも文字列に直してから繋ぐ
file: net/minecraft/commands/arguments/item/ItemInput.java
replace:
        return this.item.unwrapKey().map(ResourceKey::location).orElseGet(() -> "unknown[" + this.item + "]").toString();
with:
        return this.item.unwrapKey().<Object>map(ResourceKey::location).orElseGet(() -> "unknown[" + this.item + "]").toString();

# 逆コンパイラが引数の名前を落として、宣言中の変数を自分で読ませている。
# Mojang の版は new File(playerDataFolder, fileName + ".dat")
file: net/minecraft/server/players/OldUsersConverter.java
replace:
                        File file = new File(file, fileName + ".dat");
with:
                        File file = new File(playerDataFolder, fileName + ".dat");
