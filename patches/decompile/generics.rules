# 本の頁を Filterable<Component> に直す行(filterableFromOutgoing)は 1.19.4 に無い

# Object2IntMap.Entry のメソッド参照は受け手が Object になって当たらない。
# comparing の型引数を書く(comparingInt とラムダに書き換えると、ラムダが 1 つ増えて
# 公式の lambda$…$N の番号がずれる。公式はメソッド参照 getIntValue をそのまま渡している)
file: net/minecraft/server/level/ServerLevel.java
replace:
                .sorted(Comparator.comparing(Entry::getIntValue).reversed())
with:
                .sorted(Comparator.<Entry<String>, Integer>comparing(Entry::getIntValue).reversed())

# BlockPos の無名クラスの局所変数は、1.19.4 の逆コンパイラが i4〜i7 と別の名前にしているので直すものが無い

# unwrapKey().map(...) と orElseGet の型が揃わない。どちらも文字列に直してから繋ぐ
file: net/minecraft/commands/arguments/item/ItemInput.java
replace:
        return this.item.unwrapKey().map(ResourceKey::location).orElseGet(() -> "unknown[" + this.item + "]").toString();
with:
        return this.item.unwrapKey().<Object>map(ResourceKey::location).orElseGet(() -> "unknown[" + this.item + "]").toString();

# OldUsersConverter は、1.19.4 の逆コンパイラが file3 = new File(worldPlayersDirectory, …) と名前を残しているので直すものが無い

# instanceof のパターンに実引数付きの型を書くと、javac 17 は「安全に cast できない」で止める。
# パターンは型引数を ? にして、使う 2 か所に cast を書く(cast は同じクラス間なので
# checkcast は出ない。局所変数を足すと公式に無い番号の欄が 1 つ増える)
file: net/minecraft/commands/Commands.java
replace:
                if (argumentBuilder instanceof RequiredArgumentBuilder<SharedSuggestionProvider, ?> requiredArgumentBuilder
                    && requiredArgumentBuilder.getSuggestionsProvider() != null) {
                    requiredArgumentBuilder.suggests(SuggestionProviders.safelySwap(requiredArgumentBuilder.getSuggestionsProvider()));
with:
                if (argumentBuilder instanceof RequiredArgumentBuilder<?, ?> requiredArgumentBuilder
                    && requiredArgumentBuilder.getSuggestionsProvider() != null) {
                    ((RequiredArgumentBuilder<SharedSuggestionProvider, ?>) requiredArgumentBuilder).suggests(SuggestionProviders.safelySwap(((RequiredArgumentBuilder<SharedSuggestionProvider, ?>) requiredArgumentBuilder).getSuggestionsProvider()));

