                return Either.left(chunkAccess);
            } else {
                return Either.left(this.createEmptyChunk(pos));
with:
                return Either.<ChunkAccess, ChunkHolder.ChunkLoadingFailure>left(chunkAccess);
            } else {
                return Either.<ChunkAccess, ChunkHolder.ChunkLoadingFailure>left(this.createEmptyChunk(pos));

