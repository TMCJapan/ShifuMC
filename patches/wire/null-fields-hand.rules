
# 足したが誰も代入しない欄への配線(手書き)。生成器(tools/make_wires.py)が出せなかった
# もののうち、Paper が別のファイルや別の形で代入しているもの。vanilla の行は変えていない。

# Connection.protocolVersion / virtualHost。Paper は handleIntention の switch のあとで入れる。
# 読んだ位置: patches/sources/net/minecraft/server/network/ServerHandshakePacketListenerImpl.java.patch(NetworkClient implementation)
file: net/minecraft/server/network/ServerHandshakePacketListenerImpl.java
anchor:
                throw new UnsupportedOperationException("Invalid intention " + packet.intention());
        }
insert-after:
    this.connection.protocolVersion = packet.protocolVersion();
    this.connection.virtualHost = com.destroystokyo.paper.network.PaperNetworkClient.prepareVirtualHost(packet.hostName(), packet.port());

# ServerPlayer.loginTime(placeNewPlayer の先頭。OfflinePlayer#getLastPlayed が読む)
# 読んだ位置: patches/sources/net/minecraft/server/players/PlayerList.java.patch(Replace OfflinePlayer#getLastPlayed)
file: net/minecraft/server/players/PlayerList.java
anchor:
    GameProfile gameProfile = player.getGameProfile();
    GameProfileCache gameProfileCache = this.server.getProfileCache();
insert:
    player.loginTime = System.currentTimeMillis();

# MapItemSavedData.id。Paper は getMapData / setMapData で入れる。getMapData は return の式しか無いので、
# 同じ読み出しを先に 1 回して id を入れる(2 回目は cache に当たる)。
# 読んだ位置: patches/sources/net/minecraft/server/level/ServerLevel.java.patch(getMapData / setMapData)
file: net/minecraft/server/level/ServerLevel.java
anchor:
    return this.getServer().overworld().getDataStorage().get(MapItemSavedData.factory(), id.key());
insert:
    {
        final MapItemSavedData shifuMap = this.getServer().overworld().getDataStorage().get(MapItemSavedData.factory(), id.key());
        if (shifuMap != null && shifuMap.id == null) {
            shifuMap.id = id;
        }
    }

file: net/minecraft/server/level/ServerLevel.java
anchor:
    this.getServer().overworld().getDataStorage().set(id.key(), state);
insert:
    state.id = id;

