# Paper の API レジストリの初期化。Paper は vanilla のレジストリを作る場所で
# PaperRegistryAccess に登録する。これが無いと CraftServer の構築子が
# org.bukkit.Registry を初期化する時点で
# 「RegistryKeyImpl[key=minecraft:attribute] points to a registry that is not available yet」
# で落ちる。
#
# vanilla の行は 1 文字も変えていない。間に 1 行入れているだけ。

# 組み込みのレジストリ(patches/sources/.../BuiltInRegistries.java.patch @@ -392)
file: net/minecraft/core/registries/BuiltInRegistries.java
# 組み込みのレジストリを凍結するとき(同 @@ -399)。
# Paper は if の外、ラムダの末尾に置く。アンカーの終わりが if の閉じ括弧なので
# その後ろに入れる。
anchor:
    LOGGER.error("Unable to bootstrap registry '{}'", identifier);
    }
insert-after:
    io.papermc.paper.registry.PaperRegistryAccess.instance().lockReferenceHolders(ResourceKey.createRegistryKey(identifier));

# データパックから読むレジストリ(patches/sources/.../RegistryLoadTask.java.patch @@ -39)
file: net/minecraft/resources/RegistryLoadTask.java
# 読み直せるレジストリ(patches/sources/.../ReloadableServerRegistries.java.patch)
file: net/minecraft/server/ReloadableServerRegistries.java
anchor:
    Map<Identifier, T> map = new HashMap<>();
insert:
    io.papermc.paper.writableRegistry.PaperRegistryAccess.instance().registerReloadableRegistry(writableRegistry);
