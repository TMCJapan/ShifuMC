# ブロックエンティティの PersistentDataContainer(PublicBukkitValues)。
#
# 繋がないと NBT-API の NBTTileEntity が中身を読めず、
# Bukkit の BlockState#getPersistentDataContainer も空のまま保存されない。
#
# 読んだ位置(Paper 1.20.6):
#   Paper-Server src/main/java/net/minecraft/world/level/block/entity/BlockEntity.java:62,84,132,144

file: net/minecraft/world/level/block/entity/BlockEntity.java
anchor:
    public void load(CompoundTag nbt) {
insert-after:
    final net.minecraft.nbt.Tag shifuValues = nbt.get("PublicBukkitValues");

    if (shifuValues instanceof CompoundTag shifuCompound) {
        final CraftPersistentDataContainer shifuData = this.shifuPersistentData();
        shifuData.clear();
        shifuData.putAll(shifuCompound);
    } else if (this.persistentDataContainer != null) {
        this.persistentDataContainer.clear();
    }


file: net/minecraft/world/level/block/entity/BlockEntity.java
anchor:
    public final CompoundTag saveWithoutMetadata() {
    CompoundTag compoundTag = new CompoundTag();
    this.saveAdditional(compoundTag);
insert-after:
    if (this.persistentDataContainer != null && !this.persistentDataContainer.isEmpty()) {
        compoundTag.put("PublicBukkitValues", this.persistentDataContainer.toTagCompound());
    }
