# Bukkit 層の配線。vanilla の行は変えていない。

# Paper は構築子で cserver に CraftServer を入れる。1.20.6 の
# ServerCommonPacketListenerImpl は disconnect と PlayerKickEvent の発火で
# this.cserver を読むので、入れないと kick した瞬間に NPE になる。
file: net/minecraft/server/network/ServerGamePacketListenerImpl.java
anchor:
        this.connection = connection;
insert-after:
    this.cserver = server.server;


# Player.getCompassTarget() が読む欄。CraftBukkit は「ここでは直に入れず、
# packet を送るところで入れる」形にしている(CraftPlayer.setCompassTarget の注記)。
# 入れないと getCompassTarget() が null を返す。
file: net/minecraft/server/network/ServerGamePacketListenerImpl.java
anchor:
    public void send(Packet<?> packet, @Nullable PacketSendListener callbacks) {
insert-after:
    if (packet instanceof net.minecraft.network.protocol.game.ClientboundSetDefaultSpawnPositionPacket shifuSpawn && this.player != null) {
        this.player.compassTarget = org.bukkit.craftbukkit.util.CraftLocation.toBukkit(
                shifuSpawn.getPos(), this.player.level.getWorld());
    }
