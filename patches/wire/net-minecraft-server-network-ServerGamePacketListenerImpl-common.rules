# Bukkit 層の配線。vanilla の行は変えていない。

# Paper は構築子で cserver に CraftServer を入れる。1.18.2 は
# ServerGamePacketListenerImpl 自身がその欄を持ち、disconnect と PlayerKickEvent の
# 発火で this.cserver を読むので、入れないと kick した瞬間に NPE になる
# (ServerCommonPacketListenerImpl へ分かれるのは 1.20.2 から)。
file: net/minecraft/server/network/ServerGamePacketListenerImpl.java
anchor:
        this.connection = connection;
insert-after:
    this.cserver = server.server;


# Player.getCompassTarget() が読む欄。CraftBukkit は「ここでは直に入れず、
# packet を送るところで入れる」形にしている(CraftPlayer.setCompassTarget の注記)。
# 入れないと getCompassTarget() が null を返す。
# 1.18.2 の送りは GenericFutureListener を取る形。CraftLocation はまだ無いので
# Paper 1.18.2 と同じく Location を直に組む。
file: net/minecraft/server/network/ServerGamePacketListenerImpl.java
anchor:
    public void send(Packet<?> packet, @Nullable GenericFutureListener<? extends Future<? super Void>> listener) {
insert-after:
    if (packet instanceof net.minecraft.network.protocol.game.ClientboundSetDefaultSpawnPositionPacket shifuSpawn && this.player != null) {
        this.player.compassTarget = new org.bukkit.Location(this.player.level.getWorld(),
                shifuSpawn.getPos().getX(), shifuSpawn.getPos().getY(), shifuSpawn.getPos().getZ());
    }
