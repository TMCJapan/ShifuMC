
# Bukkit 層の配線。Paper は構築子で表示名などを入れる
# (patches/sources/net/minecraft/server/level/ServerPlayer.java.patch:112)。
# CraftPlayer.displayName() と ChatProcessor がここを読む。null のままだと
# チャットを送った瞬間に落ちる。vanilla の行は 1 文字も変えていない。
file: net/minecraft/server/level/ServerPlayer.java
anchor:
    this.advancements = server.getPlayerList().getPlayerAdvancements(this);
insert-after:
    this.displayName = this.getScoreboardName();
    this.adventure$displayName = net.kyori.adventure.text.Component.text(this.getScoreboardName());
    this.bukkitPickUpLoot = true;

# タブ一覧の表示名(Player.setPlayerListName)
#
# vanilla は常に null を返す。Paper は listName をそのまま返すように書き換えている。
# ここでは「入っていれば返す」を前に足す。誰も入れなければ null のままなので、
# vanilla と同じ経路になる。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/server/level/ServerPlayer.java.patch
file: net/minecraft/server/level/ServerPlayer.java
anchor:
    public Component getTabListDisplayName() {
insert-after:
    if (this.listName != null) {
        return this.listName;
    }

