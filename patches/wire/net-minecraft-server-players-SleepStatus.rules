# Bukkit 層の配線。vanilla の行は変えない。
#
# Player.setSleepingIgnored は ServerPlayer.fauxSleeping に入るが、vanilla は誰も読まない。
# Paper は SleepStatus の 2 箇所に `|| player.fauxSleeping` を足している。
# ここでは vanilla の行を残したまま、fauxSleeping の分を別の行で足す。
# 誰も setSleepingIgnored を呼ばなければ全員 false なので、vanilla と同じ経路になる。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/server/players/SleepStatus.java.patch

# 何割が深く寝たかの判定
file: net/minecraft/server/players/SleepStatus.java
anchor:
    return i >= this.sleepersNeeded(percentage);
insert:
    if (dev.shifu.event.PlayerEvents.anySleepIgnored(players)) {
        return dev.shifu.event.PlayerEvents.enoughDeepSleeping(players, i, this.sleepersNeeded(percentage));
    }

# 寝ている人数の数え上げ
file: net/minecraft/server/players/SleepStatus.java
anchor:
    if (serverPlayer.isSleeping()) {
    this.sleepingPlayers++;
    }
insert:
    if (!serverPlayer.isSleeping() && serverPlayer.fauxSleeping) {
        this.sleepingPlayers++;
    }
