# Bukkit 層の配線。vanilla の行は変えない。

# PlayerNaturallySpawnCreaturesEvent が絞った範囲を使う
#
# vanilla の判定はそのまま残し、発火に登録があるときだけ別の道を通る。
# Paper は anyPlayerCloseEnoughForSpawningInternal に reducedRange を足して分けているが、
# ここでは呼び出し側を囲んで分ける(vanilla の行を変えないため)。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/server/level/ChunkMap.java.patch
file: net/minecraft/server/level/ChunkMap.java
anchor:
    if (chunk != null && this.anyPlayerCloseEnoughForSpawningInternal(holder.getPos())) {
        output.add(chunk);
    }
insert:
    if (dev.shifu.event.EntityEvents.naturallySpawnCreaturesListening()) {
        if (chunk != null && this.shifuAnyPlayerCloseEnoughForSpawningReduced(holder.getPos())) {
            output.add(chunk);
        }
    } else {
insert-after:
    }

# チャンクの PersistentDataContainer(ChunkBukkitValues)を SerializableChunkData に結ぶ。
#
# record の成分は足せないので、作ったところで instance に結んでおき、
# read / write で外す(patches/wire/net-minecraft-world-level-chunk-storage-SerializableChunkData.rules)。
# 控えを入れるのはプラグインが書いたチャンクだけで、それ以外は何も残らない。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/world/level/chunk/storage/SerializableChunkData.java.patch
file: net/minecraft/server/level/ChunkMap.java
anchor:
    SerializableChunkData parsedData = SerializableChunkData.parse(this.level, this.level.palettedContainerFactory(), tag);
insert-after:
    SerializableChunkData.shifuRememberTag(parsedData, tag);

file: net/minecraft/server/level/ChunkMap.java
anchor:
    SerializableChunkData data = SerializableChunkData.copyOf(this.level, chunk);
insert-after:
    SerializableChunkData.shifuRememberChunk(data, chunk);
