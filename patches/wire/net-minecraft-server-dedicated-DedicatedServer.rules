

# stop のあと JVM を終える(stopServer の末尾)。理由は ShifuBootstrap.exitAfterServerThread。
# Paper は同じ位置で System.exit している(patches/sources/.../DedicatedServer.java.patch)。
file: net/minecraft/server/dedicated/DedicatedServer.java
anchor:
    super.stopServer();
    Util.shutdownExecutors();
insert-after:
    dev.shifu.event.ShifuBootstrap.exitAfterServerThread();

# 起動が終わったことを watchdog に伝える。ここまでは長くかかっても落とさない
file: net/minecraft/server/dedicated/DedicatedServer.java
anchor:
    LOGGER.info("Done ({})! For help, type \"help\"", string);
insert-after:
    org.spigotmc.WatchdogThread.tick();
    org.spigotmc.WatchdogThread.hasStarted = true;

# プラグインのログを log4j に流す。
#
# プラグインは java.util.logging を使う(JavaPlugin#getLogger)。Paper は根の
# JUL ロガーの handler を差し替えて log4j に渡している。これが無いと JUL の
# 既定の書式(「9月 04, 2026 5:55:37 午後 <クラス> <メソッド>」+「情報: 本文」の 2 行)で
# 標準エラーに出るだけになり、[HH:mm:ss INFO]: の書式にも logs/latest.log にも入らない。
# System.out / System.err も同じ理由で log4j に向ける。
#
# 中身は発火層に置く。ここで書くと for が int の局所変数を作り、initServer を @Local で
# 狙う mixin の候補を増やす。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/server/dedicated/DedicatedServer.java.patch:60-72
file: net/minecraft/server/dedicated/DedicatedServer.java
anchor:
    thread.setDaemon(true);
insert:
    dev.shifu.event.ShifuBootstrap.forwardPluginLogs();
