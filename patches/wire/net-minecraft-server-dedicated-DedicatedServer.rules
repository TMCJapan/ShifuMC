# Paper が vanilla のメソッドの中で行う代入。既存の行は変えていない。

# 案の位置で通す。Paper と同じく、設定(spigot.yml と Paper の設定)を
# 読んでからプラグインを読む(patches/sources/.../DedicatedServer.java.patch:100-107)。
# SpigotConfig.init は CraftServer.loadPlugins でも呼ばれるが、Paper の設定の既定値が
# SpigotWorldConfig を先に要求するので、ここでも先に読む。
file: net/minecraft/server/dedicated/DedicatedServer.java
anchor:
    this.setPlayerList(new DedicatedPlayerList(this, this.registries(), this.playerDataStorage));
insert-after:
    org.spigotmc.SpigotConfig.init((java.io.File) this.options.valueOf("spigot-settings"));
    dev.shifu.event.ShifuBootstrap.initializeConfigurations(this);
    this.server.loadPlugins();
    this.server.enablePlugins(org.bukkit.plugin.PluginLoadOrder.STARTUP);

# 案のとおり通す
#
# COMMANDS の発火は Paper と同じ順(enablePlugins の後、registerServerAliases の前)。
# plugin.yml に書いたコマンドは CommandMap を通るので、これが無くても動く。
# 実行時に Brigadier へ登録する側(Paper の Commands API、cloud-paper の
# PaperCommandManager など)はこの行事だけが入口で、無いと黙って何も登録されない。
# 読んだ位置: paper-server patches/sources/net/minecraft/server/MinecraftServer.java.patch:295-301
file: net/minecraft/server/dedicated/DedicatedServer.java
anchor:
    LOGGER.info("Done ({})! For help, type \"help\"", string3);
insert:
    this.server.enablePlugins(org.bukkit.plugin.PluginLoadOrder.POSTWORLD);
    io.papermc.paper.command.brigadier.PaperCommands.INSTANCE.setValid();
    io.papermc.paper.plugin.lifecycle.event.LifecycleEventRunner.INSTANCE.callReloadableRegistrarEvent(io.papermc.paper.plugin.lifecycle.event.types.LifecycleEvents.COMMANDS, io.papermc.paper.command.brigadier.PaperCommands.INSTANCE, org.bukkit.plugin.Plugin.class, io.papermc.paper.plugin.lifecycle.event.registrar.ReloadableRegistrarEvent.Cause.INITIAL);
    this.server.getCommandMap().registerServerAliases();
    ((org.bukkit.craftbukkit.help.SimpleHelpMap) this.server.getHelpMap()).initializeCommands();
    this.server.getPluginManager().callEvent(new org.bukkit.event.server.ServerLoadEvent(org.bukkit.event.server.ServerLoadEvent.LoadType.STARTUP));

# stop のあと JVM を終える(stopServer の末尾)。理由は ShifuBootstrap.exitAfterServerThread。
# Paper は同じ位置で System.exit している(patches/sources/.../DedicatedServer.java.patch)。
file: net/minecraft/server/dedicated/DedicatedServer.java
# Paper の watchdog を起動する
#
# WorldEdit は org.spigotmc.WatchdogThread を見つけると、長い操作の途中で tick() を
# 呼んで watchdog に生存を知らせる(PaperweightAdapter$SpigotWatchdog)。Shifu が
# thread を起動していないと instance が null で、//set が途中で止まる。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/server/dedicated/DedicatedServer.java.patch
#            worldedit@7.4.5 worldedit-bukkit/adapters/.../PaperweightAdapter.java:1228-1252
# WatchdogThread の作成は GlobalConfiguration.get() を読むので、設定が入ったあとに置く。
file: net/minecraft/server/dedicated/DedicatedServer.java
anchor:
    this.tickTimeLogger = new RemoteSampleLogger(TpsDebugDimensions.values().length, this.debugSubscribers(), RemoteDebugSampleType.TICK_TIME);
insert:
    org.spigotmc.WatchdogThread.doStart(org.spigotmc.SpigotConfig.timeoutTime, org.spigotmc.SpigotConfig.restartOnCrash);

# 起動が終わったことを watchdog に伝える。ここまでは長くかかっても落とさない
file: net/minecraft/server/dedicated/DedicatedServer.java
anchor:
    LOGGER.info("Done ({})! For help, type \"help\"", string3);
insert-after:
    org.spigotmc.WatchdogThread.tick();
    org.spigotmc.WatchdogThread.hasStarted = true;

# プラグインのログを log4j に流す。
#
# プラグインは java.util.logging を使う(JavaPlugin#getLogger)。Paper は根の
# JUL ロガーの handler を差し替えて log4j に渡している。これが無いと JUL の
# 既定の書式(「9月 04, 2026 5:55:37 午後 <クラス> <メソッド>」+「情報: 本文」の 2 行)で
# 標準エラーに出るだけになり、[HH:mm:ss INFO]: の書式にも logs/latest.log にも入らない。
# System.out / System.err も同じ理由で log4j に向ける。
#
# 中身は発火層に置く。ここで書くと for が int の局所変数を作り、initServer を @Local で
# 狙う mixin の候補を増やす。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/server/dedicated/DedicatedServer.java.patch:60-72
file: net/minecraft/server/dedicated/DedicatedServer.java
anchor:
    thread.setDaemon(true);
insert:
    dev.shifu.event.ShifuBootstrap.forwardPluginLogs();
