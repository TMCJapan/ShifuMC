
# PlayerNaturallySpawnCreaturesEvent
#
# 湧きの分類を選ぶ直前に、プレイヤーごとに 1 度出す。イベントは各 ServerPlayer に控えて、
# ChunkMap が湧かせる chunk を選ぶときに読む(collectSpawningChunks の配線)。
#
# 読んだ位置: paper-server patches/sources/net/minecraft/server/level/ServerChunkCache.java.patch
file: net/minecraft/server/level/ServerChunkCache.java
anchor:
    boolean flag = levelData.getGameTime() % 400L == 0L;
insert:
    dev.shifu.event.EntityEvents.naturallySpawnCreatures(this.level);

# PlayerNaturallySpawnCreaturesEvent が絞った範囲を使う
#
# vanilla の判定はそのまま残し、発火に登録があるときだけ別の道を通る。
# Paper は anyPlayerCloseEnoughForSpawning に reducedRange を足して分けているが、
# ここでは呼び出し側を囲んで分ける(vanilla の行を変えないため)。
file: net/minecraft/server/level/ServerChunkCache.java
anchor:
    if (this.level.isNaturalSpawningAllowed(pos) && this.chunkMap.anyPlayerCloseEnoughForSpawning(pos)) {
insert:
    if (dev.shifu.event.EntityEvents.naturallySpawnCreaturesListening()) {
        if (this.level.isNaturalSpawningAllowed(pos) && this.chunkMap.shifuAnyPlayerCloseEnoughForSpawningReduced(pos)) {
            levelChunk.incrementInhabitedTime(l);
            if (_boolean && (this.spawnEnemies || this.spawnFriendlies) && this.level.getWorldBorder().isWithinBounds(pos)) {
                NaturalSpawner.spawnForChunk(this.level, levelChunk, spawnState, this.spawnFriendlies, this.spawnEnemies, flag);
            }

            if (this.level.shouldTickBlocksAt(pos.toLong())) {
                this.level.tickChunk(levelChunk, _int);
            }
        }
    } else
