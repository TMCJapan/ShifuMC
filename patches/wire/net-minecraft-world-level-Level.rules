# Paper が vanilla のメソッドの中で行う代入。既存の行は変えていない。

# Paper は Level の構築子で this.world = new CraftWorld((ServerLevel) this, gen, biomeProvider, environment)
# 1.18.2 の Paper の世界ごとの設定は PaperWorldConfig(名前, SpigotWorldConfig)で、
# configuration パッケージ(createWorldContextMap)はまだ無い。
# 1.18.2 の構築子は registryAccess も damageSources も持たないので、先頭の 2 行に当てる。
file: net/minecraft/world/level/Level.java
anchor:
        this.profiler = profiler;
        this.levelData = properties;
insert:
    // Paper は構築子の頭で spigotConfig と paperConfig を作る。CraftWorld の構築子は paperConfig を読むので、
    // CraftWorld より先に作る。世界の名前は CraftBukkit の並べ方(overworld はそのまま、他は _nether / _the_end)。
    final net.minecraft.server.MinecraftServer shifuServer = net.minecraft.server.MinecraftServer.getServer();
    final String shifuLevelName = shifuServer.getWorldData().getLevelName();
    final String shifuBukkitName = registryRef == Level.OVERWORLD ? shifuLevelName
            : shifuLevelName + "_" + (registryRef == Level.NETHER ? "nether"
                    : registryRef == Level.END ? "the_end"
                            : registryRef.location().getNamespace() + "_" + registryRef.location().getPath());
    this.spigotConfig = new org.spigotmc.SpigotWorldConfig(shifuBukkitName);
    this.paperConfig = new com.destroystokyo.paper.PaperWorldConfig(shifuBukkitName, this.spigotConfig);
    // CraftWorld.getName() が読む。Shifu は 1 つのフォルダに 3 次元を置くため、ここで分けた名前を欄に入れる
    ((net.minecraft.server.level.ServerLevel) this).bukkitName = shifuBukkitName;
    // Anti-Xray は繋いでいない。CraftWorld が読むので、何もしない実装を入れておく
    this.chunkPacketBlockController = com.destroystokyo.paper.antixray.ChunkPacketBlockController.NO_OPERATION_INSTANCE;
    this.world = new org.bukkit.craftbukkit.CraftWorld((net.minecraft.server.level.ServerLevel) this, null, null, registryRef == Level.OVERWORLD ? org.bukkit.World.Environment.NORMAL : registryRef == Level.NETHER ? org.bukkit.World.Environment.NETHER : registryRef == Level.END ? org.bukkit.World.Environment.THE_END : org.bukkit.World.Environment.CUSTOM);
