// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// PlayerList.reloadAdvancementData
    // Paper は reloadResources を 3 つに割っている。vanilla の本体
    // (PlayerList.java:855)から、進捗を読み直す部分だけを写す。
    // vanilla の reloadResources は触らない。
    public void reloadAdvancementData() {
        for (PlayerAdvancements advancements : this.advancements.values()) {
            advancements.reload(this.server.getAdvancements());
        }
    }

// PlayerList.shifuVisibilityChanged
    // プラグインが誰かを誰かから隠したことがあるか(CraftPlayer の hideEntity などで invertedVisibilityEntities に入れた、
    // または CraftEntity.setVisibleByDefault(false))。立てるのは patches/adapter で、下ろさない。
    // 立っていなければ全員が全員を見えるので、vanilla の broadcastChatMessage の本体がそのまま走る(patches/wire)。
    public static volatile boolean shifuVisibilityChanged;

// PlayerList.shifuBroadcastChat
    // Paper の broadcastChatMessage(5 引数)の本体。vanilla の本体との違いは 2 つ。
    // sender が見えない viewer(CraftPlayer.canSee が false)には署名付きの文を送らず、署名の無い文
    // (ClientboundDisguisedChatPacket)で本文だけを送る。unsignedFunction があれば、コンソールへの記録と
    // 各 viewer への本文をその結果にする。vanilla の本体は触らない。ここへ来るのは上の旗が立っているとき
    // (patches/wire の差し込み)か、unsignedFunction があるとき(下の 4 引数版)だけ。
    // 読んだ位置: D:/.pw206/Paper-Server HEAD src/main/java/net/minecraft/server/players/PlayerList.java:1429
    public void shifuBroadcastChat(final PlayerChatMessage message, final Predicate<ServerPlayer> shouldSendFiltered,
                                   final @Nullable ServerPlayer sender, final ChatType.Bound chatType,
                                   final @Nullable Function<net.kyori.adventure.audience.Audience, Component> unsignedFunction) {
        final boolean secure = this.verifyChatTrusted(message);
        this.server.logChatMessage(unsignedFunction == null ? message.decoratedContent() : unsignedFunction.apply(this.server.console),
                chatType, secure ? null : "Not Secure");
        final OutgoingChatMessage outgoing = OutgoingChatMessage.create(message);
        boolean fullyFiltered = false;

        for (final ServerPlayer viewer : this.players) {
            final boolean filtered = shouldSendFiltered.test(viewer);
            // Paper の for の更新式で数えるので、見えない viewer の分も数える
            fullyFiltered |= filtered && message.isFullyFiltered();

            if (sender != null && !viewer.getBukkitEntity().canSee(sender.getBukkitEntity())) {
                viewer.connection.sendDisguisedChatMessage(unsignedFunction != null
                        ? unsignedFunction.apply(viewer.getBukkitEntity()) : outgoing.content(), chatType);
                continue;
            }

            viewer.sendChatMessage(outgoing, filtered, chatType, unsignedFunction == null ? null : unsignedFunction.apply(viewer.getBukkitEntity()));
        }

        if (fullyFiltered && sender != null) {
            sender.sendSystemMessage(CHAT_FILTERED_FULL);
        }
    }

// PlayerList.broadcastChatMessage
    // unsignedFunction は Paper の ChatProcessor が viewer ごとに ChatRenderer で描く関数
    // (AsyncChatEvent の renderer を替え、viewer は替えていないとき)。関数があれば Paper の本体(上の shifuBroadcastChat)に
    // 通す。null なら vanilla の版へ渡す(隠された sender は、そちらに入れた差し込みが shifuBroadcastChat へ回す)。
    // 以前は関数を捨てて vanilla の版へ渡していたので、全員に描く前の本文が届いていた。
    public void broadcastChatMessage(final PlayerChatMessage message, final ServerPlayer sender, final ChatType.Bound chatType,
                                     final @Nullable Function<net.kyori.adventure.audience.Audience, Component> unsignedFunction) {
        if (unsignedFunction == null) {
            this.broadcastChatMessage(message, sender, chatType);
            return;
        }

        this.shifuBroadcastChat(message, sender::shouldFilterMessageTo, sender, chatType, unsignedFunction);
    }

// PlayerList.getPlayerStats
    // Paper の版は `entityhuman.getStats()` を見て、無ければ下の UUID の版へ渡す。
    // その版は CraftBukkit が `stats` の表への put を消しているので、表が空のままになる。
    // vanilla の `ServerPlayer` の構築子はこの引数の版に結び付く(より特殊な方が選ばれる)ので、
    // そのまま足すと vanilla の `save(ServerPlayer)` が `ServerStatsCounter.save()` を呼べず、
    // 統計が 1 度も保存されない。vanilla の `getPlayerStats(Player)` へ渡す。
    public ServerStatsCounter getPlayerStats(ServerPlayer player) {
        return this.getPlayerStats((Player) player);
    }

// PlayerList.getPlayerStats
    // `CraftOfflinePlayer.getStatistic` が呼ぶ。入っていない人の統計をファイルから読むだけで、
    // `stats` の表には入れない(入れると、その人が入っていない間も保存の対象になる)。
    public ServerStatsCounter getPlayerStats(UUID uuid, String displayName) {
        ServerPlayer player = this.getPlayer(uuid);
        ServerStatsCounter stats = player == null ? null : player.getStats();

        if (stats == null) {
            File dir = this.server.getWorldPath(LevelResource.PLAYER_STATS_DIR).toFile();
            File file = new File(dir, String.valueOf(uuid) + ".json");

            if (!file.exists()) {
                File old = new File(dir, displayName + ".json");
                Path path = old.toPath();

                if (FileUtil.isPathNormalized(path) && FileUtil.isPathPortable(path) && path.startsWith(dir.getPath()) && old.isFile()) {
                    old.renameTo(file);
                }
            }

            stats = new ServerStatsCounter(this.server, file);
        }

        return stats;
    }
