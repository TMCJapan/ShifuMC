// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// ServerCommonPacketListenerImpl.disconnect
    // reason は PlayerKickEvent 用の理由を包んだもの。vanilla はイベントを発火せず、
    // DisconnectionDetails にも入れる場所が無いので渡さない。
    public void disconnect(final Component reason, final io.papermc.paper.connection.DisconnectionReason cause) {
        this.disconnect(reason);
    }
