// ServerLoginPacketListenerImpl.shifuStartClientVerification
    // AsyncPlayerPreLoginEvent のあと、発火層が vanilla の続き(startClientVerification は private)へ
    // 進めるための口。
    public void shifuStartClientVerification(final GameProfile profile) {
        this.startClientVerification(profile);
    }

// ServerLoginPacketListenerImpl.shifuConnection
    // 接続。発火層が住所と hostname を読む。
    public Connection shifuConnection() {
        return this.connection;
    }
