// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。
//
// 1.19.4 から消した塊:
//   removePlayerFromWorld — 1.19.4 の Paper は onDisconnect の中身を
//                           ServerCommonPacketListenerImpl.removePlayerFromWorld に切り出していた。
//                           Paper 1.18.2 にその名前は無く、代わりに
//                           onDisconnect(Component, kyori Component) を足している。
//                           呼ぶのは Paper 自身の disconnect だけで、Shifu の発火層からは
//                           呼ばないので何も置かない。chatMessageChain も 1.19 からのもの。

// ServerGamePacketListenerImpl.handleContainerClose
    public void handleContainerClose(final ServerboundContainerClosePacket packet,
                                     final org.bukkit.event.inventory.InventoryCloseEvent.Reason reason) {
        this.handleContainerClose(packet);
    }

// ServerGamePacketListenerImpl.disconnect
    // cause は PlayerKickEvent 用。vanilla はイベントを発火しないので渡さない。
    public void disconnect(final Component reason, final org.bukkit.event.player.PlayerKickEvent.Cause cause) {
        this.disconnect(reason);
    }

    public void disconnect(final net.kyori.adventure.text.Component reason, final org.bukkit.event.player.PlayerKickEvent.Cause cause) {
        this.disconnect(io.papermc.paper.adventure.PaperAdventure.asVanilla(reason), cause);
    }

// ServerGamePacketListenerImpl.hasMoved
    // Paper が PlayerMoveEvent のために持つ欄。直前に発火した to を控え、次の from にする。
    // 生成した規則(PlayerJumpEvent)もここを読む。
    // Paper 1.18.2 は lastYaw / lastPitch という名前だが、読むのはこのファイルと発火層だけなので
    // 1.19.4 の Shifu と同じ名前のままにしてある。
    private boolean hasMoved = false;

// ServerGamePacketListenerImpl.lastPosX
    private double lastPosX = Double.MAX_VALUE;

// ServerGamePacketListenerImpl.lastPosY
    private double lastPosY = Double.MAX_VALUE;

// ServerGamePacketListenerImpl.lastPosZ
    private double lastPosZ = Double.MAX_VALUE;

// ServerGamePacketListenerImpl.lastYRot
    private float lastYRot = Float.MAX_VALUE;

// ServerGamePacketListenerImpl.lastXRot
    private float lastXRot = Float.MAX_VALUE;

// ServerGamePacketListenerImpl.justTeleported
    private boolean justTeleported = false;

// ServerGamePacketListenerImpl.shifuRememberMove
    // 発火した to を控える。
    public void shifuRememberMove(final org.bukkit.Location to) {
        this.lastPosX = to.getX();
        this.lastPosY = to.getY();
        this.lastPosZ = to.getZ();
        this.lastYRot = to.getYaw();
        this.lastXRot = to.getPitch();
    }

// ServerGamePacketListenerImpl.shifuTakeJustTeleported
    // イベントの中でテレポートしたかの旗を読んで消す。
    public boolean shifuTakeJustTeleported() {
        final boolean teleported = this.justTeleported;
        this.justTeleported = false;

        return teleported;
    }

// ServerGamePacketListenerImpl.internalTeleport
    // Paper は vanilla の teleport を internalTeleport に改名して、teleport の側に
    // PlayerTeleportEvent を入れている。Shifu は vanilla の teleport をそのまま残し、
    // その中に発火を差し込んでいるので、発火しない印を付けてから vanilla の版へ渡す。
    // justTeleported は PlayerMoveEvent の中でプラグインがテレポートさせたかの判定に使う。
    // 1.18.2 の相対移動の旗は ClientboundPlayerPositionPacket.RelativeArgument
    // (net.minecraft.world.entity.RelativeMovement は 1.19.4 から)。
    public void internalTeleport(final double x, final double y, final double z,
                                 final float yRot, final float xRot,
                                 final java.util.Set<ClientboundPlayerPositionPacket.RelativeArgument> relatives) {
        dev.shifu.event.ShifuEvents.silentTeleport(this);
        this.justTeleported = true;
        this.teleport(x, y, z, yRot, xRot, relatives);
    }

    // Paper は「乗り物から降ろすか」(ClientboundPlayerPositionPacket の最後の引数)も取る。
    // vanilla の teleport にも同じ旗の版があるので、そこへ渡す。
    public void internalTeleport(final double x, final double y, final double z,
                                 final float yRot, final float xRot,
                                 final java.util.Set<ClientboundPlayerPositionPacket.RelativeArgument> relatives,
                                 final boolean shouldDismount) {
        dev.shifu.event.ShifuEvents.silentTeleport(this);
        this.justTeleported = true;
        this.teleport(x, y, z, yRot, xRot, relatives, shouldDismount);
    }

    // アダプタ層と発火層が呼ぶ短縮形。同じ目印の下に置く(別々に書くと後の方だけが残る)。
    public void internalTeleport(final org.bukkit.Location dest) {
        this.internalTeleport(dest.getX(), dest.getY(), dest.getZ(), dest.getYaw(), dest.getPitch(),
                java.util.Collections.emptySet());
    }

// ServerGamePacketListenerImpl.shifuMoveFrom
    // PlayerMoveEvent の from。まだ 1 度も発火していなければ、この packet を受ける前の位置。
    // Paper の handleMovePlayer の「if (!this.hasMoved) { ... }」と同じ。
    public org.bukkit.Location shifuMoveFrom(final double startX, final double startY, final double startZ,
                                             final float startYRot, final float startXRot) {
        if (!this.hasMoved) {
            this.lastPosX = startX;
            this.lastPosY = startY;
            this.lastPosZ = startZ;
            this.lastYRot = startYRot;
            this.lastXRot = startXRot;
            this.hasMoved = true;
        }

        return new org.bukkit.Location(this.player.level.getWorld(),
                this.lastPosX, this.lastPosY, this.lastPosZ, this.lastYRot, this.lastXRot);
    }

// ServerGamePacketListenerImpl.disconnect
    // Paper は String の版も持つ(CraftPlayer.kickPlayer、RestartCommand)。legacy の書式で読む
    public void disconnect(final String reason, final org.bukkit.event.player.PlayerKickEvent.Cause cause) {
        this.disconnect(net.kyori.adventure.text.serializer.legacy.LegacyComponentSerializer.legacySection().deserialize(reason), cause);
    }

// ServerGamePacketListenerImpl.shifuPerformUnsignedChatCommand
    // PlayerCommandPreprocessEvent で文が差し替えられたとき、差し替えた文を vanilla の
    // 私有メソッドへ通す(発火層からは private を呼べない)。1.18.2 の handleCommand(String) は
    // Commands.performCommand(CommandSourceStack, String) を呼ぶだけなので、同じ 1 行で走らせる。
    // 渡る文に先頭の「/」は無いが、vanilla の performCommand は有っても無くても同じに読む。
    public void shifuPerformUnsignedChatCommand(final String command) {
        this.server.getCommands().performCommand(this.player.createCommandSourceStack(), command);
    }
