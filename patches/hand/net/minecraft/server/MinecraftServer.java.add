// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// MinecraftServer.safeShutdown
    // Paper は vanilla の halt(boolean) を safeShutdown(boolean) に改名し、
    // 再起動用の旗を足した 2 引数の版を足している。vanilla に再起動の経路は無いので渡さない。
    public void safeShutdown(final boolean wait, final boolean isRestarting) {
        this.halt(wait);
    }

// MinecraftServer.reloadResources
    // cause は ServerResourcesReloadedEvent 用。読み直しが終わったところで出す。
    public CompletableFuture<Void> reloadResources(final Collection<String> packsToEnable,
                                                   final io.papermc.paper.event.server.ServerResourcesReloadedEvent.Cause cause) {
        return dev.shifu.event.ShifuEvents.reloaded(this.reloadResources(packsToEnable), cause, this);
    }

// MinecraftServer.setDifficulty
    // Paper は世界ごとに難易度を持つが、vanilla は 1 つしか持たない。
    // level と source は使わず、vanilla と同じくサーバー全体を変える。
    public void setDifficulty(final ServerLevel level, final Difficulty difficulty, final CommandSourceStack source,
                              final boolean ignoreLock) {
        this.setDifficulty(difficulty, ignoreLock);
    }

// MinecraftServer.motd
    // vanilla の motd は String で、フィールドの型は変えられない。値は vanilla の motd だけに置いて、
    // Paper が使う Component 版は出入り口で変換する。追加のフィールドは持たない。
    // DedicatedServer は getMotd/setMotd を server.properties へ向けて上書きしているので、
    // この 2 つを経由すれば vanilla と同じ場所を読み書きする。
    public net.kyori.adventure.text.Component motd() {
        return net.kyori.adventure.text.serializer.legacy.LegacyComponentSerializer.legacySection()
            .deserializeOr(this.getMotd(), net.kyori.adventure.text.Component.empty());
    }

    public void motd(final net.kyori.adventure.text.Component motd) {
        this.setMotd(net.kyori.adventure.text.serializer.legacy.LegacyComponentSerializer.legacySection().serialize(motd));
    }

// MinecraftServer.setDifficulty
    // Paper は世界ごとに難易度を持つ。vanilla は 1 つなので、どの世界かは落とす
    public void setDifficulty(ServerLevel level, Difficulty difficulty, boolean forceUpdate) {
        this.setDifficulty(difficulty, forceUpdate);
    }

// MinecraftServer.currentTickStart
    // ServerTickEndEvent が 1 tick の長さを出すのに要る。tick の頭で入れる(patches/events)
    public long currentTickStart;


// MinecraftServer.RollingAverage
    // Paper 1.19.4 の TPS の移動平均(Bukkit.getTPS() が読む)。Paper の内部クラスは
    // 生成器が写さないので、Paper-Server の MinecraftServer から写した。
    public static class RollingAverage {
        private final int size;
        private long time;
        private java.math.BigDecimal total;
        private int index = 0;
        private final java.math.BigDecimal[] samples;
        private final long[] times;

        RollingAverage(int size) {
            this.size = size;
            this.time = size * SEC_IN_NANO;
            this.total = dec(TPS).multiply(dec(SEC_IN_NANO)).multiply(dec(size));
            this.samples = new java.math.BigDecimal[size];
            this.times = new long[size];
            for (int i = 0; i < size; i++) {
                this.samples[i] = dec(TPS);
                this.times[i] = SEC_IN_NANO;
            }
        }

        private static java.math.BigDecimal dec(long t) {
            return new java.math.BigDecimal(t);
        }
        public void add(java.math.BigDecimal x, long t) {
            time -= times[index];
            total = total.subtract(samples[index].multiply(dec(times[index])));
            samples[index] = x;
            times[index] = t;
            time += t;
            total = total.add(x.multiply(dec(t)));
            if (++index == size) {
                index = 0;
            }
        }

        public double getAverage() {
            return total.divide(dec(time), 30, java.math.RoundingMode.HALF_UP).doubleValue();
        }
    }

// MinecraftServer.TickTimes
    // Paper 1.19.4 の tick 時間の記録(Bukkit.getTickTimes() が読む)。同上。
    public static class TickTimes {
        private final long[] times;

        public TickTimes(int length) {
            times = new long[length];
        }

        void add(int index, long time) {
            times[index % times.length] = time;
        }

        public long[] getTimes() {
            return times.clone();
        }

        public double getAverage() {
            long total = 0L;
            for (long value : times) {
                total += value;
            }
            return ((double) total / (double) times.length) * 1.0E-6D;
        }
    }

// MinecraftServer.TPS
    // Spigot の TPS 計測が使う定数。RollingAverage が読む
    public static final int TPS = 20;

// MinecraftServer.TICK_TIME
    public static final int TICK_TIME = 1000000000 / TPS;

// MinecraftServer.SAMPLE_INTERVAL
    private static final int SAMPLE_INTERVAL = 20;

// MinecraftServer.SEC_IN_NANO
    public static final long SEC_IN_NANO = 1000000000;

// MinecraftServer.addLevel
    // CraftServer.createWorld が呼ぶ。vanilla の levels は LinkedHashMap なので、そのまま入れる
    public void addLevel(final ServerLevel level) {
        this.levels.put(level.dimension(), level);
    }

// MinecraftServer.removeLevel
    public void removeLevel(final ServerLevel level) {
        this.levels.remove(level.dimension());
    }

// MinecraftServer.scheduleOnMain
    // Paper が BlockableEventLoop に足したもの(TickTask に包んでサーバースレッドの列に置く)。
    // Shifu の BlockableEventLoop は公式のバイトコードに戻るので、呼び手が名指す MinecraftServer に置く。
    // 呼び手は CraftWorld.getChunkAtAsync、CraftEntity.teleportAsync、antixray。
    // LinkCheck は所有クラス(MinecraftServer)が戻していないクラスなので見落とす(親にしか無い宣言)。
    // EssentialsX の /home(PaperLib の getChunkAtAsync)で NoSuchMethodError になり、tick loop ごと落ちていた。
    public void scheduleOnMain(final Runnable task) {
        this.tell(this.wrapRunnable(task));
    }
