// 自前で書いた追加。

// ChunkMap.shifuAnyPlayerCloseEnoughForSpawningReduced
    // anyPlayerCloseEnoughForSpawning と同じだが、PlayerNaturallySpawnCreaturesEvent が絞った範囲を使う。
    // 呼ぶのは ServerChunkCache.tickChunks から(発火に登録があるときだけ)。
    // 1.19.4 の vanilla は playerMap.getPlayers(chunk) で候補を絞ってから距離を見る。
    public boolean shifuAnyPlayerCloseEnoughForSpawningReduced(final ChunkPos pos) {
        final long packed = pos.toLong();
        if (!this.distanceManager.hasPlayersNearby(packed)) {
            return false;
        }

        for (final ServerPlayer player : this.playerMap.getPlayers(packed)) {
            final double range = dev.shifu.event.EntityEvents.spawnRangeSquared(player);

            if (range <= 0.0 || player.isSpectator()) {
                continue;
            }

            if (euclideanDistanceSquared(pos, player) < range) {
                return true;
            }
        }

        return false;
    }
