// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// ServerLevel.explode0
    // vanilla の explode(13 引数) は void。ServerExplosion を返す形と wasCanceled は Paper の追加なので、
    // ここには何も足さない。呼び出し元は CraftWorld.createExplosion だけで、そちらを vanilla の explode へ向けた。

// ServerLevel.findLightningTargetAround
    // returnNullWhenNoTarget は Paper の World.findLightningTarget 用。落雷点が無いときに null を返す旗だが、
    // vanilla の版は必ず位置を返すので渡さない。CraftWorld 側は null 判定を残したまま動く。
    public BlockPos findLightningTargetAround(final BlockPos pos, final boolean returnNullWhenNoTarget) {
        return this.findLightningTargetAround(pos);
    }

// ServerLevel.typeKey
    // 16 引数の構築子は this(...) で vanilla の版へ渡してから入れるので、final にできない。
    // vanilla の 10 引数の版から作られた世界では null のまま。
    private ResourceKey<LevelStem> typeKey;

// ServerLevel.uuid
    // Paper は世界ごとに別のフォルダを持つので uid.dat から作る。vanilla は 3 つの次元で
    // 1 つのフォルダを使うので、主世界の uid.dat から次元ごとに導く(配線で入れる)。
    // CraftWorld.getUID() が直に読む。
    public UUID uuid;

// ServerLevel.bukkitName
    // Bukkit から見た世界の名前。vanilla の PrimaryLevelData は 3 つの次元で 1 つなので、
    // getLevelName() は 3 つとも同じ。CraftBukkit と同じ規則(<名前>_nether など)で分ける。
    // CraftWorld.getName() が読む(patches/adapter)。
    public String bukkitName;

// ServerLevel.levelStorageAccess
    // Paper が構築子で入れる。CraftWorld と CraftServer が直に読む。
    public LevelStorageSource.LevelStorageAccess levelStorageAccess;

// ServerLevel.poiDataControllerNew
    // Paper のチャンク系は POI を自前の IO 糸で読み書きする。vanilla の SectionStorage は
    // IOWorker を使うので RegionFileStorage として渡せない。Shifu は Paper のチャンク系を
    // 繋いでいない(chunkTaskScheduler に何も入れていない)ので、ここに来たら落とす
    public final io.papermc.paper.chunk.system.io.RegionFileIOThread.ChunkDataController poiDataControllerNew
        = new io.papermc.paper.chunk.system.io.RegionFileIOThread.ChunkDataController(io.papermc.paper.chunk.system.io.RegionFileIOThread.RegionFileType.POI_DATA) {

        @Override
        public net.minecraft.world.level.chunk.storage.RegionFileStorage getCache() {
            throw new UnsupportedOperationException("Shifu: POI は vanilla の IOWorker が読み書きする");
        }

        @Override
        public void writeData(int chunkX, int chunkZ, net.minecraft.nbt.CompoundTag compound) {
            throw new UnsupportedOperationException("Shifu: POI は vanilla の IOWorker が読み書きする");
        }

        @Override
        public net.minecraft.nbt.CompoundTag readData(int chunkX, int chunkZ) {
            throw new UnsupportedOperationException("Shifu: POI は vanilla の IOWorker が読み書きする");
        }
    };

// ServerLevel.ServerLevel
    // Paper が増やした 3 引数を受ける版。CraftServer.createWorld から呼ばれる。
    // vanilla の 12 引数の版へ this(...) で渡してから、増えた分を欄へ入れる。
    // environment と biomeProvider は使わない。入れ先の world (CraftWorld) は Level の
    // 構築子の末尾(配線)で、次元から決めた environment を渡して作っている。
    public ServerLevel(final MinecraftServer server,
                       final Executor dispatcher,
                       final LevelStorageSource.LevelStorageAccess levelStorageAccess,
                       final ServerLevelData serverLevelData,
                       final ResourceKey<Level> dimension,
                       final LevelStem levelStem,
                       final ChunkProgressListener worldGenerationProgressListener,
                       final boolean isDebug,
                       final long biomeZoomSeed,
                       final List<CustomSpawner> customSpawners,
                       final boolean tickTime,
                       final @Nullable RandomSequences randomSequences,
                       final org.bukkit.World.Environment environment,
                       final org.bukkit.generator.ChunkGenerator generator,
                       final org.bukkit.generator.BiomeProvider biomeProvider) {
        this(server, dispatcher, levelStorageAccess, serverLevelData, dimension, levelStem,
                worldGenerationProgressListener, isDebug, biomeZoomSeed, customSpawners, tickTime, randomSequences);
        this.generator = generator;
    }

// ServerLevel.hasEntityMoveEvent
    // EntityMoveEvent に登録があるか。毎 tick 世界を回す前に入れる(patches/wire)
    public boolean hasEntityMoveEvent;

