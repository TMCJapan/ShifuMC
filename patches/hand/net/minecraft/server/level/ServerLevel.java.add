// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// ServerLevel.tryAddFreshEntityWithPassengers
    // reason は CreatureSpawnEvent 用。Paper は addEntity まで引数で運ぶが、Shifu は vanilla の
    // 署名を変えないので Entity.spawnReason の欄に置いてから vanilla の版へ渡す
    // (patches/events/entity-spawn.rules がその欄を読む)。
    public boolean tryAddFreshEntityWithPassengers(final Entity entity,
                                                   final org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason reason) {
        entity.spawnReason = reason;
        return this.tryAddFreshEntityWithPassengers(entity);
    }

// ServerLevel.addFreshEntity
    // Paper の addFreshEntity(entity, reason)。LevelWriter の既定は false を返すだけで、
    // Paper は ServerLevel で addEntity(entity, reason) に向けている。その版が無かったので
    // CraftWorld.spawn(=プラグインが出すエンティティ)が全部無視されていた。bot で実測した。
    public boolean addFreshEntity(final Entity entity,
                                  final org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason reason) {
        entity.spawnReason = reason;
        return this.addFreshEntity(entity);
    }

// ServerLevel.explode0
    // vanilla の explode(13 引数) は void。ServerExplosion を返す形と wasCanceled は Paper の追加なので、
    // ここには何も足さない。呼び出し元は CraftWorld.createExplosion だけで、そちらを vanilla の explode へ向けた。

// ServerLevel.sendParticlesSource
    // 可視性 API 用。vanilla の sendParticles(ServerPlayer, ...) を宛先ごとに呼ぶ。
    // vanilla の sendParticles(T, ...) は呼ばない(宛先の絞り込みと canSee の判定ができないため)。
    public <T extends ParticleOptions> int sendParticlesSource(
        final @Nullable Entity sender,
        final T options,
        final boolean overrideLimiter,
        final boolean alwaysShow,
        final double x,
        final double y,
        final double z,
        final int count,
        final double xDist,
        final double yDist,
        final double zDist,
        final double speed
    ) {
        return this.sendParticlesSource(this.players, sender, options, overrideLimiter, alwaysShow, x, y, z, count, xDist, yDist, zDist, speed);
    }

    public <T extends ParticleOptions> int sendParticlesSource(
        final List<ServerPlayer> receivers,
        final @Nullable Entity sender,
        final T options,
        final boolean overrideLimiter,
        final boolean alwaysShow,
        final double x,
        final double y,
        final double z,
        final int count,
        final double xDist,
        final double yDist,
        final double zDist,
        final double speed
    ) {
        int result = 0;

        for (int i = 0; i < receivers.size(); i++) {
            final ServerPlayer player = receivers.get(i);

            if (sender != null && !player.getBukkitEntity().canSee(sender.getBukkitEntity())) {
                continue;
            }

            if (this.sendParticles(player, options, overrideLimiter, alwaysShow, x, y, z, count, xDist, yDist, zDist, speed)) {
                result++;
            }
        }

        return result;
    }

// ServerLevel.findLightningTargetAround
    // returnNullWhenNoTarget は Paper の World.findLightningTarget 用。落雷点が無いときに null を返す旗だが、
    // vanilla の版は必ず位置を返すので渡さない。CraftWorld 側は null 判定を残したまま動く。
    public BlockPos findLightningTargetAround(final BlockPos pos, final boolean returnNullWhenNoTarget) {
        return this.findLightningTargetAround(pos);
    }

// ServerLevel.typeKey
    // 16 引数の構築子は this(...) で vanilla の版へ渡してから入れるので、final にできない。
    // vanilla の 10 引数の版から作られた世界では null のまま。
    private ResourceKey<LevelStem> typeKey;

// ServerLevel.uuid
    // Paper は世界ごとに別のフォルダを持つので uid.dat から作る。vanilla は 3 つの次元で
    // 1 つのフォルダを使うので、主世界の uid.dat から次元ごとに導く(配線で入れる)。
    // CraftWorld.getUID() が直に読む。
    public UUID uuid;

// ServerLevel.bukkitName
    // Bukkit から見た世界の名前。vanilla の PrimaryLevelData は 3 つの次元で 1 つなので、
    // getLevelName() は 3 つとも同じ。CraftBukkit と同じ規則(<名前>_nether など)で分ける。
    // CraftWorld.getName() が読む(patches/adapter)。
    public String bukkitName;

// ServerLevel.levelStorageAccess
    // Paper が構築子で入れる。CraftWorld と CraftServer が直に読む。
    public LevelStorageSource.LevelStorageAccess levelStorageAccess;

// ServerLevel.levelLoadListener
    // Paper が構築子で入れる。世界の読み込みの進み具合を出す。
    public net.minecraft.server.level.progress.LevelLoadListener levelLoadListener;

// ServerLevel.ServerLevel
    // Paper が増やした 3 引数を受ける版。CraftServer.createWorld から呼ばれる。
    // vanilla の 11 引数の版へ this(...) で渡してから、増えた分を欄へ入れる。
    // vanilla の構築子の行は 1 行も触っていない。
    //
    // environment と biomeProvider は使わない。入れ先は Level の world (CraftWorld) だが、
    // それは Level で private final に宣言されていて ServerLevel からは触れない。
    // Level の構築子の末尾(配線)で作るときに、次元から決めた environment を渡している。
    public ServerLevel(final MinecraftServer server,
                       final Executor dispatcher,
                       final LevelStorageSource.LevelStorageAccess levelStorageAccess,
                       final ServerLevelData serverLevelData,
                       final ResourceKey<Level> dimension,
                       final LevelStem levelStem,
                       final boolean isDebug,
                       final long biomeZoomSeed,
                       final List<CustomSpawner> customSpawners,
                       final boolean tickTime,
                       final @Nullable RandomSequences randomSequences,
                       final org.bukkit.World.Environment environment,
                       final org.bukkit.generator.@Nullable ChunkGenerator generator,
                       final org.bukkit.generator.@Nullable BiomeProvider biomeProvider) {
        this(server, dispatcher, levelStorageAccess, serverLevelData, dimension, levelStem,
                isDebug, biomeZoomSeed, customSpawners, tickTime, randomSequences);
        this.generator = generator;
    }

// ServerLevel.shifuCreateConfigs
    // Paper は Level の構築子で spigotConfig と paperConfig を作る。vanilla の構築子は
    // 触れないので、ServerLevel の構築子の末尾(配線)から呼ぶ。
    // SpigotConfig.init と initializeWorldDefaultsConfiguration が先に済んでいること
    // (DedicatedServer.initServer の配線)。
    // 読んだ位置: patches/sources/net/minecraft/world/level/Level.java.patch:89,
    //            patches/sources/net/minecraft/server/level/ServerLevel.java.patch:157
    public void shifuCreateConfigs(final LevelStorageSource.LevelStorageAccess levelStorageAccess) {
        this.spigotConfig = new org.spigotmc.SpigotWorldConfig(this.bukkitName);
        this.paperConfig = this.server.paperConfigurations.createWorldConfig(
                io.papermc.paper.configuration.PaperConfigurations.createWorldContextMap(
                        levelStorageAccess.levelDirectory.path(),
                        this.bukkitName,
                        this.dimension().identifier(),
                        this.spigotConfig,
                        this.server.registryAccess(),
                        this.serverLevelData.getGameRules()));
        // Paper は overworld の分を MinecraftServer.createLevels で、他の世界の分を initWorld で入れる。
        // CraftWorldBorder が読む。世界ごとの境界はどれも自分の世界を指す
        this.getWorldBorder().world = this;
    }

// ServerLevel.shifuSpawn
    // Bukkit の世界ごとのスポーン。vanilla の nether / end の LevelData は主世界のものを包んでいる(DerivedLevelData)ので、
    // そのまま書くと主世界のスポーンが次元ごと変わり、新しいプレイヤーが nether に参加する
    // (Multiverse が世界ごとに setSpawnLocation する)。主世界以外は CraftWorld がここに置いて読む(patches/adapter)。
    // 次元フォルダの shifu-spawn.properties に保存する。読み書きは shifuSpawnLock の中。
    public net.minecraft.world.level.storage.LevelData.RespawnData shifuSpawn;

// ServerLevel.shifuSpawnLoaded
    // ファイルを読み終えたか(ファイルが無い場合を含む)。読めなかったときは立てず、次の呼び出しで読み直す。
    // 読む前に立てていたので、読み損ねたあとは向き 0 で答えていた。
    private boolean shifuSpawnLoaded;

// ServerLevel.shifuSpawnDirty
    // 置いたがまだファイルに書いていない。書くのは世界の保存(save の !skipSave の中、patches/wire)で、
    // save-off の間は書かない。置いたその場で書いていたので save-off 中もファイルが変わっていた。
    private boolean shifuSpawnDirty;

// ServerLevel.shifuSpawnLock
    // 読み書きの鍵。getSpawnLocation は非同期のプラグインからも呼ばれる。遅延読み込みと置き換えが
    // 別スレッドで重なると、置いた値をファイルの古い値で上書きしうる。
    private final Object shifuSpawnLock = new Object();

// ServerLevel.shifuParseSpawn
    // shifu-spawn.properties の中身を {x, y, z, yaw, pitch} にする。1.21.11 は yaw / pitch、1.20.6 以前は angle(yaw と同じ値)を
    // 書いていたので、どちらの鍵でも読む(pitch が無ければ 0)。座標か向きが欠けている、または数として読めなければ null で、
    // 保存されたスポーンは無い扱いにする(欠けた鍵で Float.parseFloat(null) が NullPointerException になり、catch を抜けていた)。
    static double[] shifuParseSpawn(final java.util.Properties properties) {
        final String x = properties.getProperty("x");
        final String y = properties.getProperty("y");
        final String z = properties.getProperty("z");
        final String yaw = properties.getProperty("yaw", properties.getProperty("angle"));

        if (x == null || y == null || z == null || yaw == null) {
            return null;
        }

        try {
            return new double[] {
                    Integer.parseInt(x.trim()),
                    Integer.parseInt(y.trim()),
                    Integer.parseInt(z.trim()),
                    Float.parseFloat(yaw.trim()),
                    Float.parseFloat(properties.getProperty("pitch", "0").trim())};
        } catch (NumberFormatException exception) {
            return null;
        }
    }

// ServerLevel.shifuSpawnProperties
    // 書く中身。どの版でも読めるよう、yaw / pitch と angle(= yaw)を両方書く。
    static java.util.Properties shifuSpawnProperties(final int x, final int y, final int z, final float yaw, final float pitch) {
        final java.util.Properties properties = new java.util.Properties();
        properties.setProperty("x", Integer.toString(x));
        properties.setProperty("y", Integer.toString(y));
        properties.setProperty("z", Integer.toString(z));
        properties.setProperty("yaw", Float.toString(yaw));
        properties.setProperty("pitch", Float.toString(pitch));
        properties.setProperty("angle", Float.toString(yaw));
        return properties;
    }

// ServerLevel.shifuWriteSpawnFile
    // 一時ファイルに書いてから置き換える。途中で落ちても前の中身が残る。
    static void shifuWriteSpawnFile(final java.nio.file.Path file, final java.util.Properties properties) throws java.io.IOException {
        final java.nio.file.Path temp = file.resolveSibling(file.getFileName() + ".tmp");
        java.nio.file.Files.createDirectories(file.getParent());
        try (java.io.Writer out = java.nio.file.Files.newBufferedWriter(temp, java.nio.charset.StandardCharsets.UTF_8)) {
            properties.store(out, "Shifu dimension spawn");
        }
        java.nio.file.Files.move(temp, file, java.nio.file.StandardCopyOption.REPLACE_EXISTING);
    }

// ServerLevel.shifuReadSpawnFile
    // 中身が欠けていれば null(shifuParseSpawn)。
    static double[] shifuReadSpawnFile(final java.nio.file.Path file) throws java.io.IOException {
        final java.util.Properties properties = new java.util.Properties();
        try (java.io.Reader in = java.nio.file.Files.newBufferedReader(file, java.nio.charset.StandardCharsets.UTF_8)) {
            properties.load(in);
        }
        return shifuParseSpawn(properties);
    }

// ServerLevel.shifuGetSpawn
    public net.minecraft.world.level.storage.LevelData.RespawnData shifuGetSpawn() {
        synchronized (this.shifuSpawnLock) {
            this.shifuLoadSpawn();
            return this.shifuSpawn;
        }
    }

// ServerLevel.shifuSetSpawn
    public void shifuSetSpawn(final net.minecraft.world.level.storage.LevelData.RespawnData spawn) {
        synchronized (this.shifuSpawnLock) {
            this.shifuSpawn = spawn;
            this.shifuSpawnLoaded = true;
            this.shifuSpawnDirty = true;
        }
    }

// ServerLevel.shifuSaveSpawn
    // 世界の保存から呼ぶ(patches/wire)。置いていなければ何もしない。
    public void shifuSaveSpawn() {
        synchronized (this.shifuSpawnLock) {
            if (!this.shifuSpawnDirty) {
                return;
            }

            try {
                shifuWriteSpawnFile(this.shifuSpawnFile(), shifuSpawnProperties(
                        this.shifuSpawn.pos().getX(), this.shifuSpawn.pos().getY(), this.shifuSpawn.pos().getZ(), this.shifuSpawn.yaw(), this.shifuSpawn.pitch()));
                this.shifuSpawnDirty = false;
            } catch (java.io.IOException exception) {
                MinecraftServer.LOGGER.error("Could not save Shifu spawn for {}", this.dimension().identifier(), exception);
            }
        }
    }

// ServerLevel.shifuLoadSpawn
    // shifuSpawnLock の中で呼ぶ。
    private void shifuLoadSpawn() {
        if (this.shifuSpawnLoaded) {
            return;
        }

        final java.nio.file.Path file = this.shifuSpawnFile();

        try {
            if (java.nio.file.Files.isRegularFile(file)) {
                final double[] spawn = shifuReadSpawnFile(file);

                if (spawn == null) {
                    MinecraftServer.LOGGER.warn("Ignored incomplete Shifu spawn file {}", file);
                } else {
                    this.shifuSpawn = net.minecraft.world.level.storage.LevelData.RespawnData.of(
                            this.dimension(), new BlockPos((int) spawn[0], (int) spawn[1], (int) spawn[2]), (float) spawn[3], (float) spawn[4]);
                }
            }

            this.shifuSpawnLoaded = true;
        } catch (java.io.IOException exception) {
            MinecraftServer.LOGGER.error("Could not load Shifu spawn for {}", this.dimension().identifier(), exception);
        }
    }

// ServerLevel.shifuSpawnFile
    private java.nio.file.Path shifuSpawnFile() {
        return this.levelStorageAccess.getDimensionPath(this.dimension()).resolve("shifu-spawn.properties");
    }
