// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。
//
// 1.19.4 から消した塊:
//   explode0            — 1.18.2 の CraftWorld.createExplosion は vanilla の
//                         explode(Entity, double, double, double, float, boolean, BlockInteraction)
//                         をそのまま呼んで、返った Explosion の wasCanceled(Paper の欄)を読む。
//                         別の入口が要らない。
//   typeKey             — getTypeKey は convertable.dimensionType から答えるので、この欄は
//                         1.19.4 でも読まれていなかった。
//   levelStorageAccess  — Paper 1.18.2 にこの名前の欄は無い。CraftWorld と CraftServer は
//                         convertable を読む。
//   poiDataControllerNew / entityDataControllerNew
//                       — io.papermc.paper.chunk.system.io.RegionFileIOThread は Paper 1.19 の
//                         書き直したチャンク系のもの。Paper 1.18.2 は vanilla の IOWorker と
//                         EntityStorage のままで、この入口を持たない。
//   addWorldGenChunkEntities(Stream, ChunkPos)
//                       — Paper 1.18.2 の版は vanilla と同じ 1 引数。

// ServerLevel.findLightningTargetAround
    // returnNullWhenNoTarget は Paper の World.findLightningTarget 用。落雷点が無いときに null を返す旗だが、
    // vanilla の版は必ず位置を返すので渡さない。CraftWorld 側は null 判定を残したまま動く。
    public BlockPos findLightningTargetAround(final BlockPos pos, final boolean returnNullWhenNoTarget) {
        return this.findLightningTargetAround(pos);
    }

// ServerLevel.getTypeKey
    // Paper は世界ごとの LevelStorageAccess に次元を持たせ(createAccess(名前, 次元))、
    // getTypeKey はそれを返す。入れるのは CraftServer.createWorld だけで、
    // vanilla の Main は次元を渡さない版を呼ぶ。主世界と地獄と果ての 3 つはそちらから
    // 作られるので null になる。vanilla の MinecraftServer.createLevels は LevelStem の
    // 鍵と同じ location から ResourceKey<Level> を作るので、そこから戻せる。
    // 1.18.2 の鍵は net.minecraft.core.Registry.LEVEL_STEM_REGISTRY
    // (net.minecraft.core.registries.Registries は 1.19.3 から)。
    // ServerPlayer(果てへ移るか)と Entity と ChunkMap と CraftDimensionUtil が読む。
    public ResourceKey<net.minecraft.world.level.dimension.LevelStem> getTypeKey() {
        return this.convertable.dimensionType != null
                ? this.convertable.dimensionType
                : ResourceKey.create(Registry.LEVEL_STEM_REGISTRY, this.dimension().location());
    }

// ServerLevel.uuid
    // Paper は世界ごとに別のフォルダを持つので uid.dat から作る。vanilla は 3 つの次元で
    // 1 つのフォルダを使うので、次元ごとのフォルダから導く(配線で入れる)。
    // CraftWorld.getUID() が直に読む。
    public UUID uuid;

// ServerLevel.bukkitName
    // Bukkit から見た世界の名前。vanilla の PrimaryLevelData は 3 つの次元で 1 つなので、
    // getLevelName() は 3 つとも同じ。CraftBukkit と同じ規則(<名前>_nether など)で分ける。
    // CraftWorld.getName() が読む(patches/adapter)。入れるのは patches/wire。
    public String bukkitName;

// ServerLevel.hasEntityMoveEvent
    // EntityMoveEvent に登録があるか。毎 tick 世界を回す前に入れる(patches/wire)。
    // Paper 1.18.2 は MinecraftServer と LivingEntity から読む
    public boolean hasEntityMoveEvent;

// ServerLevel.addEntity
    // Paper 1.18.2 の版は最後に entityManager.addNewEntity(entity) を呼ぶ。そこは vanilla の
    // addEntity(Entity) と同じなので、前半の見張りだけを写して最後の 1 行を vanilla へ渡す。
    // CraftEventFactory.doEntityAddEventCalling の発火は入れない。
    private boolean addEntity(final Entity entity, final org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason spawnReason) {
        org.spigotmc.AsyncCatcher.catchOp("entity add");
        entity.generation = false;

        if (entity.valid) {
            MinecraftServer.LOGGER.error("Attempted Double World add on {}", entity, new Throwable());

            return true;
        }

        if (entity.spawnReason == null) {
            entity.spawnReason = spawnReason;
        }

        if (entity.isRemoved()) {
            return false;
        }

        // 発火は vanilla の addEntity(Entity) の中(patches/events/entity-spawn.rules)。
        // ここで出すと、vanilla が湧かせた分と二重になる
        return this.addEntity(entity);
    }

// ServerLevel.tryAddFreshEntityWithPassengers
    // Paper の版と同じ判定。載っているかは vanilla の entityManager で見る。
    public boolean tryAddFreshEntityWithPassengers(final Entity entity,
                                                   final org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason reason) {
        if (entity.getSelfAndPassengers().map(Entity::getUUID).anyMatch(this.entityManager::isLoaded)) {
            return false;
        }

        this.addFreshEntityWithPassengers(entity, reason);

        return true;
    }

// ServerLevel.ServerLevel
    // CraftServer.createWorld が呼ぶ 15 引数の版。Bukkit 側の 3 つを控えてから
    // vanilla の 12 引数の版へ渡す。主世界と地獄と果ての 3 つは vanilla の
    // MinecraftServer.createLevels が 12 引数の版で作る。
    // Paper は gen があるときに chunkGenerator を CustomChunkGenerator で包むが、
    // それは this(...) より前に this を要るので書けない。generator を欄に置くだけにする。
    public ServerLevel(final MinecraftServer server, final Executor workerExecutor,
                       final LevelStorageSource.LevelStorageAccess session, final ServerLevelData properties,
                       final ResourceKey<Level> worldKey, final Holder<DimensionType> dimensionType,
                       final ChunkProgressListener listener, final ChunkGenerator chunkGenerator,
                       final boolean debugWorld, final long seed,
                       final List<CustomSpawner> spawners, final boolean shouldTickTime,
                       final org.bukkit.World.Environment environment,
                       final org.bukkit.generator.ChunkGenerator generator,
                       final org.bukkit.generator.BiomeProvider biomeProvider) {
        this(server, workerExecutor, session, properties, worldKey, dimensionType, listener, chunkGenerator, debugWorld, seed, spawners, shouldTickTime);
        this.convertable = session;
        this.generator = generator;
    }

// ServerLevel.findNearestMapFeature
    // Paper は CraftWorld.locateNearestStructure のために、tag ではなく HolderSet を取る版を
    // 使う(StructureType から作った並びは tag ではないので TagKey に詰められない)。
    // vanilla の tag を取る版が tag を解いたあとに呼んでいるのと同じ ChunkGenerator の口へ渡す。
    @Nullable
    public BlockPos findNearestMapFeature(final HolderSet<ConfiguredStructureFeature<?, ?>> structures,
                                          final BlockPos pos, final int radius, final boolean skipExistingChunks) {
        if (!this.server.getWorldData().worldGenSettings().generateFeatures()) {
            return null;
        }

        final Pair<BlockPos, Holder<ConfiguredStructureFeature<?, ?>>> pair = this.getChunkSource()
                .getGenerator()
                .findNearestMapFeature(this, structures, pos, radius, skipExistingChunks);
        return pair != null ? pair.getFirst() : null;
    }

// ServerLevel.addFreshEntity
    // CraftBukkit は理由付きの版で湧かせる(CraftWorld.spawn、EntityType の spawn)。Paper 1.18.2 と同じく
    // 理由付きの addEntity へ渡す。vanilla の addFreshEntity(Entity) は変えない(1 引数の版は DEFAULT で来る)。
    // 同名の vanilla のメソッドがあるので shim は写さない。LevelWriter の default と対で置く
    public boolean addFreshEntity(final Entity entity, final org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason reason) {
        return this.addEntity(entity, reason);
    }

// ServerLevel.noCollision
    // Paper が CollisionGetter に足した 3 引数の版(loadChunks)。CollisionGetter は公式のバイトコードに戻るので
    // ServerLevel に置く。呼び手は PlayerList.respawn(cross-world のテレポート)。Shifu は vanilla の 2 引数へ渡す。
    public boolean noCollision(final net.minecraft.world.entity.Entity entity, final net.minecraft.world.phys.AABB box, final boolean loadChunks) {
        return this.noCollision(entity, box);
    }

// ServerLevel.shifuSpawn
    // Bukkit の世界ごとのスポーン。vanilla の nether / end の LevelData は主世界のものを包んでいる(DerivedLevelData)ので、
    // そのまま書くと主世界のスポーンが変わる(Multiverse が世界ごとに setSpawnLocation する)。
    // 主世界以外は CraftWorld.setSpawnLocation がここに置き、getSpawnLocation がここから読む(patches/adapter)。
    public BlockPos shifuSpawn;

// ServerLevel.shifuSpawnAngle
    public float shifuSpawnAngle;
