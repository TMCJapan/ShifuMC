// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// ChunkHolder.getAvailableChunkNow
    public @Nullable ChunkAccess getAvailableChunkNow() {
        return this.getLastAvailable();
    }

// ChunkHolder.getChunkHolderStatus
    public @Nullable ChunkStatus getChunkHolderStatus() {
        return this.getLastAvailableStatus();
    }

// ChunkHolder.getFullChunkNow
    public LevelChunk getFullChunkNow() {
        if (!this.isFullChunkReady() || !(this.getAvailableChunkNow() instanceof LevelChunk chunk)) {
            return null;
        }

        return chunk;
    }

// ChunkHolder.getFullChunkNowUnchecked
    public LevelChunk getFullChunkNowUnchecked() {
        return this.getAvailableChunkNow() instanceof LevelChunk chunk ? chunk : null;
    }
