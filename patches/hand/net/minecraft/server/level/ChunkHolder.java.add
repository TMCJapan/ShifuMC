// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// Paper の書き直したチャンク系(NewChunkHolder)を使う版の置き換え。
// Shifu は vanilla のチャンク系のままなので、vanilla の holder が持つ値で答える。

// ChunkHolder.isFullChunkReady
    public final boolean isFullChunkReady() {
        return this.getFullStatus().isOrAfter(ChunkHolder.FullChunkStatus.BORDER);
    }

// ChunkHolder.getAvailableChunkNow
    public @Nullable ChunkAccess getAvailableChunkNow() {
        return this.getLastAvailable();
    }

// ChunkHolder.getChunkHolderStatus
    public @Nullable ChunkStatus getChunkHolderStatus() {
        return this.getLastAvailableStatus();
    }

// ChunkHolder.getFullChunkNow
    public LevelChunk getFullChunkNow() {
        if (!this.isFullChunkReady() || !(this.getAvailableChunkNow() instanceof LevelChunk chunk)) {
            return null;
        }

        return chunk;
    }

// ChunkHolder.getFullChunkNowUnchecked
    public LevelChunk getFullChunkNowUnchecked() {
        return this.getAvailableChunkNow() instanceof LevelChunk chunk ? chunk : null;
    }

// ChunkHolder.ChunkHolder
    // Paper のチャンク系(NewChunkHolder)が作る版。vanilla は読み込み段階を int で持つので、
    // 何も読めていない値(MAX_CHUNK_DISTANCE + 1)で渡す。newChunkHolder は使わない
    public ChunkHolder(final ChunkPos pos, final LevelHeightAccessor world, final LevelLightEngine lightingProvider,
                       final ChunkHolder.PlayerProvider playersWatchingChunkProvider,
                       final io.papermc.paper.chunk.system.scheduling.NewChunkHolder newChunkHolder) {
        this(pos, ChunkMap.MAX_CHUNK_DISTANCE + 1, world, lightingProvider, null, playersWatchingChunkProvider);
    }

// ChunkHolder.getSendingChunk
    // Paper は自分の chunkMap 欄(Paper のチャンク系が入れる)から辿る。vanilla の holder は
    // ChunkMap を PlayerProvider として持っているので、そこから辿る
    public final LevelChunk getSendingChunk() {
        LevelChunk ret = ((ChunkMap) this.playerProvider).level.getChunkSource().getChunkAtIfLoadedImmediately(this.pos.x, this.pos.z);
        if (ret != null && ret.areNeighboursLoaded(1)) {
            return ret;
        }
        return null;
    }
