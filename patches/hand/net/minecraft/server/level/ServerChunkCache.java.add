// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// ServerChunkCache.close
    // save=false は保存せずに閉じる Paper の経路。vanilla は必ず保存するので渡さない。
    public void close(final boolean save) throws java.io.IOException {
        this.close();
    }

// ServerChunkCache.setSpawnSettings
    // vanilla は敵の湧きだけを持つ。友好 mob の旗は保持する場所が無いので渡さない。
    public void setSpawnSettings(final boolean spawnEnemies, final boolean spawnFriendlies) {
        this.setSpawnSettings(spawnEnemies);
    }

// ServerChunkCache.isPositionTicking
    // Paper は実体を受ける版を足している。vanilla は長整数の位置で見るので、そこへ渡す
    public boolean isPositionTicking(net.minecraft.world.entity.Entity entity) {
        return this.isPositionTicking(net.minecraft.world.level.ChunkPos.asLong(entity.blockPosition()));
    }
