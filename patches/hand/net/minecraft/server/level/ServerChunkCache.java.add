// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// ServerChunkCache.close
    // save=false は保存せずに閉じる Paper の経路。vanilla は必ず保存するので渡さない。
    public void close(final boolean save) throws java.io.IOException {
        this.close();
    }

// ServerChunkCache.setSpawnSettings
    // vanilla は敵の湧きだけを持つ。友好 mob の旗は保持する場所が無いので渡さない。
    public void setSpawnSettings(final boolean spawnEnemies, final boolean spawnFriendlies) {
        this.setSpawnSettings(spawnEnemies);
    }

// ServerChunkCache.getChunkAtIfCachedImmediately
    // Paper が足しているもの。FastAsyncWorldEdit が直に呼ぶ(呼べないと //set が
    // NoSuchMethodError で落ちる)。アダプタ層は使わないので shim の閉包には出てこない。
    // 中身は Paper と同じ(キャッシュを通さずに visible chunk を見る)。
    // 読んだ位置: paper-server patches/sources/net/minecraft/server/level/ServerChunkCache.java.patch:85
    public @Nullable LevelChunk getChunkAtIfCachedImmediately(final int x, final int z) {
        final ChunkHolder holder = this.chunkMap.getVisibleChunkIfPresent(ChunkPos.pack(x, z));

        if (holder == null) {
            return null;
        }

        return holder.getFullChunkNowUnchecked();
    }

// ServerChunkCache.getChunkAtIfLoadedImmediately
    // 同上。Paper は fullChunks の表から引くが、vanilla にその表は無いので
    // 「見えているホルダから完全なチャンクを取る」で代える。読む用途は同じ。
    public @Nullable LevelChunk getChunkAtIfLoadedImmediately(final int x, final int z) {
        return this.getChunkAtIfCachedImmediately(x, z);
    }
