// GameModeCommand.setGameMode
    // cause は PlayerGameModeChangeEvent の理由。発火層に置いてから vanilla の版へ渡す。
    public static boolean setGameMode(final CommandSourceStack source, final ServerPlayer player, final GameType type,
                                      final org.bukkit.event.player.PlayerGameModeChangeEvent.Cause cause) {
        dev.shifu.event.ShifuEvents.gameModeCause(player, cause);
        return GameModeCommand.setGameMode(source, player, type);
    }
