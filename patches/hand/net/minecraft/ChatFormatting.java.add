// ChatFormatting.getByHexValue
    // PaperAdventure.asVanilla が色を ChatFormatting に戻すときに呼ぶ。
    // 読んだ位置: D:/.pw194/Paper-Server(HEAD)src/main/java/net/minecraft/ChatFormatting.java:117
    @Nullable public static ChatFormatting getByHexValue(int i) {
        for (ChatFormatting value : values()) {
            if (value.getColor() != null && value.getColor() == i) {
                return value;
            }
        }

        return null;
    }
