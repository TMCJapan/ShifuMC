// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// Enchantment.shifuLunge
    // EntityLungeEvent で突きの強さが差し替えられたときに呼ぶ。vanilla の doPostPiercingAttack の
    // 本体をそのまま写し、強さだけ引数のものにする(vanilla の enchantmentLevel は引数なので
    // 代入できない)。差し替えが無ければ呼ばれず、vanilla の行が走る。
    // 読んだ位置: patches/sources/net/minecraft/world/item/enchantment/Enchantment.java.patch(EntityLungeEvent)
    public void shifuLunge(final ServerLevel serverLevel, final int level, final EnchantedItemInUse item, final Entity user) {
        applyEffects(
            this.getEffects(EnchantmentEffectComponents.POST_PIERCING_ATTACK),
            entityContext(serverLevel, level, user, user.position()),
            e -> e.apply(serverLevel, level, item, user, user.position())
        );
    }
