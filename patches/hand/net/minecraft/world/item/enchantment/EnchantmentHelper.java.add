// EnchantmentHelper.updateEnchantments
    // createComponentIfMissing はエンチャント成分が無いときに作るかどうかの旗。
    // vanilla の版は必ず作るので渡さない。
    public static ItemEnchantments updateEnchantments(final ItemStack itemStack,
                                                      final Consumer<ItemEnchantments.Mutable> consumer,
                                                      final boolean createComponentIfMissing) {
        return EnchantmentHelper.updateEnchantments(itemStack, consumer);
    }
