// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// SmithingTrimRecipe.copyDataComponents
    // SmithingTransformRecipe と同じ。宣言そのものをここに書いて初期値で埋める。
    // 値は vanilla の applyTrim と同じ「引き継ぐ」。
    private final boolean copyDataComponents = true;

// SmithingTrimRecipe.SmithingTrimRecipe
    // Paper の追加引数。vanilla の applyTrim は常に baseItem.copyWithCount(1) で引き継ぐので、
    // 受け取った値は使わず vanilla の 4 引数の構築子へ渡すだけにする。欄は final なので
    // this(...) の後では代入できない。初期化子の塊で埋めてある。
    public SmithingTrimRecipe(final Ingredient template, final Ingredient base, final Ingredient addition, final Holder<TrimPattern> pattern, final boolean copyDataComponents) {
        this(template, base, addition, pattern);
    }
