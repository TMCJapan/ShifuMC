// Merchant.processTrade
    // Paper は PlayerPurchaseEvent を挟む。vanilla にその段は無いので、そのまま知らせる
    default void processTrade(MerchantOffer merchantRecipe, @Nullable io.papermc.paper.event.player.PlayerPurchaseEvent event) {
        this.notifyTrade(merchantRecipe);
    }
