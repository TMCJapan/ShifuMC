// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// MerchantOffer.MerchantOffer
    // CraftMerchantRecipe が作る取引。値引きを無視する旗と Bukkit 側の写しを入れてから、
    // vanilla の 8 引数の版へ渡す
    public MerchantOffer(ItemCost baseCostA, Optional<ItemCost> costB, ItemStack result, int uses, int maxUses,
                         int experience, float priceMultiplier, int demand, final boolean ignoreDiscounts,
                         org.bukkit.craftbukkit.inventory.CraftMerchantRecipe bukkit) {
        this(baseCostA, costB, result, uses, maxUses, experience, priceMultiplier, demand);
        this.ignoreDiscounts = ignoreDiscounts;
        this.bukkitHandle = bukkit;
    }
