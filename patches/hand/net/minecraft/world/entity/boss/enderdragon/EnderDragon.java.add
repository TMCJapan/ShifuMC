// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// EnderDragon.getExpReward
    // Paper は tickDeath から経験値の計算を持ち上げて getExpReward に置く
    // (EnderDragon.java.patch:175,265)。持ち上げは vanilla の行を触るので、
    // ここでは同じ式を書くだけにする。vanilla の tickDeath はそのまま経験値を出す。
    // 読んだ位置: vanilla net/minecraft/world/entity/boss/enderdragon/EnderDragon.java:536
    public int getExpReward(ServerLevel level, Entity entity) {
        if (!level.getGameRules().get(GameRules.MOB_DROPS)) {
            return 0;
        }

        int i = 500;

        if (this.dragonFight != null && !this.dragonFight.hasPreviouslyKilledDragon()) {
            i = 12000;
        }

        return i;
    }
