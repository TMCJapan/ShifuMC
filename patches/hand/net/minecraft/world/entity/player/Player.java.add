// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// Player.startSleepInBed
    // force は Bukkit の Player#sleep(location, force) 用。vanilla に対応する経路が無いので
    // 渡さない。force=true でも vanilla と同じ判定を通る。
    public Either<Player.BedSleepingProblem, Unit> startSleepInBed(final BlockPos pos, final boolean force) {
        return this.startSleepInBed(pos);
    }
