// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// ExperienceOrb.ExperienceOrb
    // reason / triggerId / sourceId は Paper が足した記録用の引数で、玉の初期化には使わない。
    // vanilla の構築子は setPos / setDeltaMovement / setValue しかせずこの 3 つを読まないので、
    // vanilla の版を呼んでから欄に控えても結果は同じ。欄は make_shim が足したもの。
    public ExperienceOrb(final Level level, final double x, final double y, final double z, final int value, final org.bukkit.entity.ExperienceOrb.SpawnReason reason, final @Nullable Entity triggerId, final @Nullable Entity sourceId) {
        this(level, x, y, z, value);
        this.sourceEntityId = sourceId != null ? sourceId.getUUID() : null;
        this.triggerEntityId = triggerId != null ? triggerId.getUUID() : null;
        this.spawnReason = reason != null ? reason : org.bukkit.entity.ExperienceOrb.SpawnReason.UNKNOWN;
    }
