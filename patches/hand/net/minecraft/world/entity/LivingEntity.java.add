// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// LivingEntity.heal
    // Paper のパッチは EntityRegainHealthEvent を略名で書いていて、その import は
    // vanilla に無い。型を完全修飾にした形をここで書く。
    // EntityRegainHealthEvent を発火しないので、理由も旗も使わない。
    public void heal(final float heal,
                     final org.bukkit.event.entity.EntityRegainHealthEvent.RegainReason regainReason) {
        this.heal(heal, regainReason, false);
    }

    public void heal(final float heal,
                     final org.bukkit.event.entity.EntityRegainHealthEvent.RegainReason regainReason,
                     final boolean isFastRegen) {
        this.heal(heal);
    }

// LivingEntity.removeAllEffects
    // 理由を発火層に置いてから vanilla へ渡す。EntityPotionEffectEvent は vanilla の中で出る。
    public boolean removeAllEffects(final org.bukkit.event.entity.EntityPotionEffectEvent.Cause cause) {
        dev.shifu.event.EntityEvents.effectCause(cause);
        return this.removeAllEffects();
    }

// LivingEntity.setItemSlot
    // silent は装備音を出さないための旗。vanilla の setItemSlot は音を出さないので渡さない。
    public void setItemSlot(final EquipmentSlot slot, final ItemStack itemStack, final boolean silent) {
        this.setItemSlot(slot, itemStack);
    }

// LivingEntity.craftAttributes
    // Paper は構築子の中で this.attributes の次にこれを作るが、vanilla の構築子は触らない。
    // 欄の初期化子は構築子の本体より先に走るので、そこで作ると this.attributes がまだ null。
    // 空のままにして、初めて読まれたときに作る。読むのはアダプタ層の 2 箇所だけで、
    // どちらもエンティティが出来上がった後に呼ばれる。
    public org.bukkit.craftbukkit.attribute.CraftAttributeMap craftAttributes;

    public org.bukkit.craftbukkit.attribute.CraftAttributeMap shifuCraftAttributes() {
        if (this.craftAttributes == null) {
            this.craftAttributes = new org.bukkit.craftbukkit.attribute.CraftAttributeMap(this.getAttributes());
        }

        return this.craftAttributes;
    }

// LivingEntity.startUsingItem
    // FancyNpcs の版一致アダプタが呼ぶ。forceUpdate が偽なら vanilla の版と同じなので渡す。
    // 真のときは、手の品が空でも使用中でも使い始める(Paper の条件は `!empty && !using || forceUpdate`)。
    // その本体は vanilla の版の中身と同じ。Paper が足した食事の時間の補正(totalEatTimeTicks /
    // eatStartTime)は vanilla の tick が読まないので入れない。
    // 引数の数が違うので、vanilla の呼び出しがこちらへ来ることは無い。
    // 読んだ位置: D:/.pw194/Paper-Server(HEAD)src/main/java/net/minecraft/world/entity/LivingEntity.java:3778
    public void startUsingItem(InteractionHand hand, boolean forceUpdate) {
        if (!forceUpdate) {
            this.startUsingItem(hand);
            return;
        }

        ItemStack itemInHand = this.getItemInHand(hand);
        this.useItem = itemInHand;
        this.useItemRemaining = itemInHand.getUseDuration();

        if (!this.level.isClientSide) {
            this.setLivingEntityFlag(1, true);
            this.setLivingEntityFlag(2, hand == InteractionHand.OFF_HAND);
            this.gameEvent(GameEvent.ITEM_INTERACT_START);
        }
    }
