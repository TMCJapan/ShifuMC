// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// Mob.setTarget
    // 1.20.6 の CraftBukkit は 3 引数で呼ぶ(発火するかどうかを渡す)。
    // 発火は vanilla の中で出るので、渡さないときは理由を置かずに通す。
    public boolean setTarget(final LivingEntity target,
                             final org.bukkit.event.entity.EntityTargetEvent.TargetReason reason,
                             final boolean fireEvent) {
        if (fireEvent) {
            dev.shifu.event.EntityEvents.targetReason(reason);
        }

        this.setTarget(target);
        return true;
    }

// Mob.setTarget
    // 理由を発火層に置いてから vanilla の setTarget(LivingEntity) へ渡す。
    // EntityTargetLivingEntityEvent は vanilla の中で出る(patches/events/entity-core.rules)。
    // 返り値は「取り消されなかったか」だが、vanilla の版は返さないので常に true。
    // 下位クラスの上書きにはここからの呼び出しで届く。
    public boolean setTarget(final LivingEntity target,
                             final org.bukkit.event.entity.EntityTargetEvent.TargetReason reason) {
        dev.shifu.event.EntityEvents.targetReason(reason);
        this.setTarget(target);
        return true;
    }

// Mob.setPersistenceRequired
    // CraftLivingEntity.setRemoveWhenFarAway が真偽値で切り替える。
    // vanilla の版は引数を取らず、常に true にする。欄は persistenceRequired。
    // 読んだ位置: patches/sources/net/minecraft/world/entity/Mob.java.patch:40
    public void setPersistenceRequired(final boolean persistenceRequired) {
        this.persistenceRequired = persistenceRequired;
    }

// Mob.shifuCanPickup
    // equipItemIfPossible が「拾う」と判定するかを、状態を変えずに同じ順で計算する。
    // EntityPickupItemEvent の既定(拾えない物は取り消し済みで出す)に使う。
    public boolean shifuCanPickup(final ItemStack stack) {
        EquipmentSlot slot = getEquipmentSlotForItem(stack);
        ItemStack current = this.getItemBySlot(slot);
        boolean canReplace = this.canReplaceCurrentItem(stack, current);

        if (slot.isArmor() && !canReplace) {
            slot = EquipmentSlot.MAINHAND;
            current = this.getItemBySlot(slot);
            canReplace = current.isEmpty();
        }

        return canReplace && this.canHoldItem(stack);
    }

