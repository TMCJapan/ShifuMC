// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// MapItemSavedData.mapView
    // Paper は構築子で作る。vanilla の構築子は触らないので初期化子で作る。
    // 読んだ位置: patches/sources/net/minecraft/world/level/saveddata/maps/MapItemSavedData.java.patch
    public org.bukkit.craftbukkit.map.CraftMapView mapView = new org.bukkit.craftbukkit.map.CraftMapView(this);

// MapItemSavedData.setColorsDirty
    // Paper は「保存の印を付けるか」の旗を足して、CraftMapCanvas から false で呼ぶ
    // (Paper の "Fix unnecessary map data saves")。それは vanilla と挙動が変わるので、
    // 旗は見ずに vanilla の 2 引数版へ渡す。印は vanilla と同じく必ず付く。
    // 読んだ位置: patches/sources/net/minecraft/world/level/saveddata/maps/MapItemSavedData.java.patch
    public void setColorsDirty(final int x, final int y, final boolean markFileDirty) {
        this.setColorsDirty(x, y);
    }
