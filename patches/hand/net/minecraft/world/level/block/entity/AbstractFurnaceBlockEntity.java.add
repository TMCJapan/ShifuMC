// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// AbstractFurnaceBlockEntity.getTotalCookTime
    // recipeType と cookSpeedMultiplier は Paper の cook speed API 用。
    // vanilla の版は炉の種類から自分で引いて、倍率を持たない。
    // 置かれていない炉の写しから呼ぶと世界が null になる。そこは引けないので 200 を返す
    public static int getTotalCookTime(@Nullable final Level level,
                                       final RecipeType<? extends AbstractCookingRecipe> recipeType,
                                       final AbstractFurnaceBlockEntity entity,
                                       final double cookSpeedMultiplier) {
        return level == null ? 200 : AbstractFurnaceBlockEntity.getTotalCookTime(level, entity);
    }
