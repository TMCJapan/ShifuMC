// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// Level.world
    // make_shim が Paper のパッチから写した world は空の final。
    // Paper は ServerLevel 側の構築子で this.world = new CraftWorld(...) を代入するが、
    // vanilla の Level(WritableLevelData, ...) は触らないので代入する場所が無く、
    // 構築子の末尾で「変数 world は初期化されていない可能性があります」になる。
    // final を外して shim の方を止める。getWorld() は shim の版がそのまま残る。
    private org.bukkit.craftbukkit.CraftWorld world;

// Level.spigotConfig
    // world と同じ。Paper のパッチは構築子で this.spigotConfig = new SpigotWorldConfig(...) を
    // 代入するが、vanilla の構築子は触らないので空の final のままになる。final を外す。
    public org.spigotmc.SpigotWorldConfig spigotConfig; // Spigot

// Level.paperConfig
    // world と同じ。Paper のパッチは構築子で this.paperConfig = ... を代入するが、
    // vanilla の構築子は触らないので空の final のままになる。
    // 1.18.2 の世界ごとの設定は com.destroystokyo.paper.PaperWorldConfig(名前, SpigotWorldConfig)。
    // io.papermc.paper.configuration.WorldConfiguration と paperConfig() は 1.19 からのものなので、
    // 型を戻して読み出しメソッドは消した。代入は patches/wire/net-minecraft-world-level-Level.rules。
    public com.destroystokyo.paper.PaperWorldConfig paperConfig; // Paper

// Level.getHardCollidingEntities
    // Paper のチャンク系(EntityLookup / entitySliceManager)は Shifu に無い(null)。生成器が写した本体はそこを読んで
    // NPE になる(PlayerList.respawn の noCollision → Paper の CollisionUtil)。vanilla の getEntities で答える。
    // 「硬い当たり」は Paper が Entity に足した hardCollides()(ボートなど)で絞る。
    @Override
    public List<Entity> getHardCollidingEntities(Entity except, AABB box, Predicate<? super Entity> predicate) {
        final List<Entity> ret = new java.util.ArrayList<>();
        this.getHardCollidingEntities(except, box, predicate, ret);
        return ret;
    }

// Level.getEntities
    @Override
    public void getEntities(Entity except, AABB box, Predicate<? super Entity> predicate, List<Entity> into) {
        // Paper の CollisionUtil は predicate に null を渡す(EntityLookup は null を通す)。vanilla の getEntities は test() を呼ぶ
        into.addAll(this.getEntities(except, box, predicate == null ? e -> true : predicate));
    }

// Level.getHardCollidingEntities
    @Override
    public void getHardCollidingEntities(Entity except, AABB box, Predicate<? super Entity> predicate, List<Entity> into) {
        for (final Entity other : this.getEntities(except, box, predicate == null ? e -> true : predicate)) {
            if (other.hardCollides()) {
                into.add(other);
            }
        }
    }
