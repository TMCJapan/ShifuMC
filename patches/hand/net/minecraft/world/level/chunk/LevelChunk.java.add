// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// LevelChunk.level
    // vanilla の LevelChunk.level は Level 型。Paper はこれを ServerLevel 型に書き換えているが、
    // 型の変更は許可されていないので何も足さない。shim が入れると level が 2 つになり、
    // 併せて constructor の this.level = level(Level → ServerLevel)も通らなくなる。

// LevelChunk.onNeighbourChange
    // Paper のチャンク系(隣のチャンクの読み込み状態の控え)。Shifu は vanilla のチャンク系のままなので何もしない
    private void onNeighbourChange(final long bitsetBefore, final long bitsetAfter) {
    }

// LevelChunk.updateGeneralAreaCache
    // Paper の近くのプレイヤーの表。vanilla は持たないので何もしない
    public void updateGeneralAreaCache() {
    }

// LevelChunk.setBlockState
    // Paper が足した 4 引数の版。4 つめ(doPlace)が false のときだけ onPlace を飛ばす。
    // WorldEdit の PaperweightWorldNativeAccess が
    // sideEffectSet.shouldApply(SideEffect.UPDATE) を渡して呼ぶ。無いと //set が
    // NoSuchMethodError で落ちる。
    //
    // **doPlace が true のときは vanilla の 3 引数の版へそのまま渡す。**
    // 普段の経路(サーバー自身とプラグインの大半)は vanilla の命令列のまま動く。
    // false のときだけ、vanilla の本体から onPlace の 1 行を抜いたものを通る。
    // 中身は vanilla の setBlockState(pos, state, moved) の写しなので、
    // バージョンを移すときは向こうと突き合わせる。
    //
    // 目印は `// <型>.<名前>` の形でないと apply_shim_adds の MARK に当たらない。
    // 引数を書いていたときは塊が 1 つ前の updateGeneralAreaCache に吸われていて、
    // 生成器が同じ名前の shim を出すと宣言が 2 つになる。
    //
    // 読んだ位置: Paper-Server 9c28dabcf src/main/java/net/minecraft/world/level/chunk/LevelChunk.java:555
    @Nullable
    public BlockState setBlockState(BlockPos pos, BlockState state, boolean moved, boolean doPlace) {
        if (doPlace) {
            return this.setBlockState(pos, state, moved);
        }

        int y = pos.getY();
        LevelChunkSection section = this.getSection(this.getSectionIndex(y));
        boolean hasOnlyAir = section.hasOnlyAir();
        if (hasOnlyAir && state.isAir()) {
            return null;
        } else {
            int i = pos.getX() & 15;
            int i1 = y & 15;
            int i2 = pos.getZ() & 15;
            BlockState blockState = section.setBlockState(i, i1, i2, state);
            if (blockState == state) {
                return null;
            } else {
                Block block = state.getBlock();
                this.heightmaps.get(Heightmap.Types.MOTION_BLOCKING).update(i, y, i2, state);
                this.heightmaps.get(Heightmap.Types.MOTION_BLOCKING_NO_LEAVES).update(i, y, i2, state);
                this.heightmaps.get(Heightmap.Types.OCEAN_FLOOR).update(i, y, i2, state);
                this.heightmaps.get(Heightmap.Types.WORLD_SURFACE).update(i, y, i2, state);
                boolean hasOnlyAir1 = section.hasOnlyAir();
                if (hasOnlyAir != hasOnlyAir1) {
                    this.level.getChunkSource().getLightEngine().updateSectionStatus(pos, hasOnlyAir1);
                }

                boolean hasBlockEntity = blockState.hasBlockEntity();
                if (!this.level.isClientSide) {
                    blockState.onRemove(this.level, pos, state, moved);
                } else if (!blockState.is(block) && hasBlockEntity) {
                    this.removeBlockEntity(pos);
                }

                if (!section.getBlockState(i, i1, i2).is(block)) {
                    return null;
                } else {
                    if (state.hasBlockEntity()) {
                        BlockEntity blockEntity = this.getBlockEntity(pos, LevelChunk.EntityCreationType.CHECK);
                        if (blockEntity == null) {
                            blockEntity = ((EntityBlock)block).newBlockEntity(pos, state);
                            if (blockEntity != null) {
                                this.addAndRegisterBlockEntity(blockEntity);
                            }
                        } else {
                            blockEntity.setBlockState(state);
                            this.updateBlockEntityTicker(blockEntity);
                        }
                    }

                    this.unsaved = true;
                    return blockState;
                }
            }
        }
    }
