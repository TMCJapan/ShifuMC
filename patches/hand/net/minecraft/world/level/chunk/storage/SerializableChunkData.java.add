// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// SerializableChunkData.SHIFU_CHUNK_VALUES
    // チャンクの PersistentDataContainer(ChunkBukkitValues)の控え。
    //
    // Paper は record に成分 persistentDataContainer を足して parse / copyOf から
    // write / read まで運ぶ。record の成分は足せないので、作った側(ChunkMap)で
    // instance に結び、read / write で外す。
    // record の equals は成分を全部見るので、同一性で引く IdentityHashMap にする。
    // 入るのはプラグインが Chunk#getPersistentDataContainer() に書いたチャンクだけ。
    //
    // 読んだ位置: paper-server patches/sources/net/minecraft/world/level/chunk/storage/SerializableChunkData.java.patch
    private static final java.util.Map<SerializableChunkData, CompoundTag> SHIFU_CHUNK_VALUES =
            java.util.Collections.synchronizedMap(new java.util.IdentityHashMap<>());

// SerializableChunkData.shifuRememberTag
    // 読み込み。盤から読んだ tag の ChunkBukkitValues をこの instance に結ぶ。
    public static void shifuRememberTag(final @Nullable SerializableChunkData data, final CompoundTag tag) {
        if (data != null && tag.get("ChunkBukkitValues") instanceof CompoundTag values) {
            SHIFU_CHUNK_VALUES.put(data, values);
        }
    }

// SerializableChunkData.shifuRememberChunk
    // 保存。write は別のスレッドで走るので、呼ばれたスレッド(チャンクを持っている側)で写す。
    public static void shifuRememberChunk(final SerializableChunkData data, final ChunkAccess chunk) {
        if (!chunk.persistentDataContainer.isEmpty()) {
            SHIFU_CHUNK_VALUES.put(data, chunk.persistentDataContainer.toTagCompound());
        }
    }

// SerializableChunkData.shifuApplyTo
    // 読み込み。結んでおいた分をチャンクの入れ物へ入れる。
    public void shifuApplyTo(final ChunkAccess chunk) {
        final CompoundTag values = SHIFU_CHUNK_VALUES.remove(this);

        if (values != null) {
            chunk.persistentDataContainer.putAll(values);
        }
    }

// SerializableChunkData.shifuWriteTo
    // 保存。結んでおいた分を盤に書く tag へ入れる。無ければ tag は vanilla と同じ。
    public void shifuWriteTo(final CompoundTag tag) {
        final CompoundTag values = SHIFU_CHUNK_VALUES.remove(this);

        if (values != null) {
            tag.put("ChunkBukkitValues", values);
        }
    }
