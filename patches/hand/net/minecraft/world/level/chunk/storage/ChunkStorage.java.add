// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// ChunkStorage.upgradeChunkTag
    // Paper のチャンク系が呼ぶ版。位置と世界は vanilla の版が使わないので落とす
    public CompoundTag upgradeChunkTag(final ResourceKey<net.minecraft.world.level.dimension.LevelStem> levelStem, final Supplier<DimensionDataStorage> persistentStateManagerFactory,
                                       final CompoundTag nbt, final Optional<ResourceKey<Codec<? extends ChunkGenerator>>> generatorCodecKey,
                                       final ChunkPos pos, final @Nullable net.minecraft.world.level.LevelAccessor level) {
        return this.upgradeChunkTag(ResourceKey.create(net.minecraft.core.registries.Registries.DIMENSION, levelStem.location()),
                persistentStateManagerFactory, nbt, generatorCodecKey);
    }
