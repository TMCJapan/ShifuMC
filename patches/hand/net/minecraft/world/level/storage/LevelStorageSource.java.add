// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// LevelStorageAccess.LevelStorageAccess
    // CraftBukkit は次元ごとに別のフォルダを持つ。どの次元かを持たせるだけなので、
    // vanilla の 2 引数の版へ渡してから入れる
        LevelStorageAccess(final String directoryName, final Path path, final ResourceKey<LevelStem> dimensionType) throws IOException {
            this(directoryName, path);
            this.dimensionType = dimensionType;
        }
