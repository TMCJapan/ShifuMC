// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// CombatTracker.resetCombatState
    // Paper が recheckStatus の内側を切り出したもの。vanilla の recheckStatus は触らないので、
    // vanilla の本体(vanilla CombatTracker.java:147-159)の内側と同じ式をここに書く。
    // 呼ぶのは Bukkit の CombatTracker#resetCombatState だけ。
    public void resetCombatState() {
        boolean wasInCombat = this.inCombat;
        this.takingDamage = false;
        this.inCombat = false;
        this.combatEndTime = this.mob.tickCount;
        if (wasInCombat) {
            this.mob.onLeaveCombat();
        }

        this.entries.clear();
    }
