// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// ClientboundPlayerInfoUpdatePacket.ClientboundPlayerInfoUpdatePacket
    // 出来上がった Entry から作る版。vanilla の 2 つのコンストラクタはどちらも
    // ServerPlayer から Entry を作るので、Entry を直接受ける形が無い。
    // 代入するのは vanilla と同じ 2 つのフィールドだけ。
    public ClientboundPlayerInfoUpdatePacket(final EnumSet<ClientboundPlayerInfoUpdatePacket.Action> actions, final List<ClientboundPlayerInfoUpdatePacket.Entry> entries) {
        this.actions = actions;
        this.entries = entries;
    }

    public ClientboundPlayerInfoUpdatePacket(final EnumSet<ClientboundPlayerInfoUpdatePacket.Action> actions, final ClientboundPlayerInfoUpdatePacket.Entry entry) {
        this.actions = actions;
        this.entries = List.of(entry);
    }
