// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// ClientboundSectionBlocksUpdatePacket.ClientboundSectionBlocksUpdatePacket
    // CraftBukkit と Paper が足している構築子。vanilla の 4 引数の版は LevelChunkSection から状態を読むが、
    // こちらは呼び出し側が状態の並びを直に渡す(CraftPlayer.sendBlockChanges / sendMultiBlockChange)。
    public ClientboundSectionBlocksUpdatePacket(final SectionPos sectionPos, final ShortSet changes,
                                                final BlockState[] states, final boolean suppressLightUpdates) {
        this.sectionPos = sectionPos;
        this.suppressLightUpdates = suppressLightUpdates;
        this.positions = changes.toShortArray();
        this.states = states;
    }

    public ClientboundSectionBlocksUpdatePacket(final SectionPos sectionPos,
                                                final it.unimi.dsi.fastutil.shorts.Short2ObjectMap<BlockState> blockChanges,
                                                final boolean suppressLightUpdates) {
        this.sectionPos = sectionPos;
        this.suppressLightUpdates = suppressLightUpdates;
        this.positions = blockChanges.keySet().toShortArray();
        this.states = blockChanges.values().toArray(new BlockState[0]);
    }
