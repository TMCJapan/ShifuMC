// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。
//
// patches/access/implements.rules で PaperCommandSourceStack(API の CommandSourceStack)を
// 実装させている。その interface が要求するもののうち、default が無い 2 つをここに置く。

// CommandSourceStack.getHandle
    // PaperCommandSourceStack の実装。Paper のパッチと同じで、自分を返す。
    public CommandSourceStack getHandle() {
        return this;
    }

// CommandSourceStack.shifuApiSource
    // Paper の brigadier API に渡すときに包んだもの(dev.shifu.command.ApiSource)。
    // 同じ source を何度包んでも同じオブジェクトになるように、ここに覚えておく。
    // 型を Object にしているのは、vanilla のクラスからアダプタ層の型を参照しないため。
    public Object shifuApiSource;
