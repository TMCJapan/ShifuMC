// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// Commands.performCommand
    // throwCommandError は失敗を例外で返すための旗。vanilla の版は返さないので渡さない。
    public void performCommand(final ParseResults<CommandSourceStack> command, final String commandString,
                               final boolean throwCommandError) {
        this.performCommand(command, commandString);
    }

// Commands.performCommand
    // label は Paper がイベントに渡す元の文字列。vanilla の版は持たないので落とす。
    public void performCommand(final ParseResults<CommandSourceStack> command, final String commandString,
                               final String label) {
        this.performCommand(command, commandString);
    }

// Commands.performCommand
    public void performCommand(final ParseResults<CommandSourceStack> command, final String commandString,
                               final String label, final boolean throwCommandError) {
        this.performCommand(command, commandString);
    }

