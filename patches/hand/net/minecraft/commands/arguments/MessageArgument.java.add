// 自前で書いた追加。Paper の宣言だけを写し、本体は vanilla の版へ渡す。

// MessageArgument.resolveChatMessage
    // Paper の版は文を引数で受けるが、vanilla の版は context から読み直す。
    // 渡された message は使われない。
    public static void resolveChatMessage(final MessageArgument.Message message,
                                          final CommandContext<CommandSourceStack> context, final String name,
                                          final Consumer<PlayerChatMessage> task) throws CommandSyntaxException {
        MessageArgument.resolveChatMessage(context, name, task);
    }
