# vanilla の中の無名クラスへの追加。

# 書見台の中身。shim が Container に足した getLocation をここにも要る
file: net/minecraft/world/level/block/entity/LecternBlockEntity.java
anchor:
    public final Container bookAccess = new Container() {
    @Override
    public int getContainerSize() {
    return 1;
    }
insert-after:
        @Override
        public org.bukkit.Location getLocation() {
            if (LecternBlockEntity.this.level == null) return null;
            return org.bukkit.craftbukkit.util.CraftLocation.toBukkit(LecternBlockEntity.this.worldPosition, LecternBlockEntity.this.level.getWorld());
        }
