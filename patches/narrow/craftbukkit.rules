# CraftBukkit が vanilla の宣言の**型を狭める**もの。
#
# 追加では表せないので、宣言の行そのものを置き換える。狭めるだけなので、
# 入る値は同じ。命令列も変わらない(ジェネリクスと同じでコンパイル時の検査だけ)。
# 可視性を広げる patches/access と同じ扱いにする。
#
# 1.20.6 では CraftBukkit が「// CraftBukkit - type」の注記を付けている。

# LevelChunk.level は vanilla のまま Level 型で残す。CraftBukkit はここを ServerLevel に
# 狭めているが、狭めると Fabric の MOD の @Shadow が署名で当たらなくなる
# (carpet の LevelChunk_movableBEMixin が field_12858 = level を狙う)。
#
# 代わりに、Paper から写した本体の側で絞る。入る値は同じ(サーバー側の世界)で、
# vanilla の行は 1 行も触らない。
file: net/minecraft/world/level/chunk/LevelChunk.java
count: 2
replace:
        net.minecraft.server.level.ServerChunkCache chunkProvider = this.level.getChunkSource();
with:
        net.minecraft.server.level.ServerChunkCache chunkProvider = ((net.minecraft.server.level.ServerLevel) this.level).getChunkSource();

file: net/minecraft/world/level/chunk/LevelChunk.java
replace:
        this.level.getChunkSource().addLoadedChunk(this);
with:
        ((net.minecraft.server.level.ServerLevel) this.level).getChunkSource().addLoadedChunk(this);

file: net/minecraft/world/level/chunk/LevelChunk.java
replace:
        this.level.getChunkSource().removeLoadedChunk(this); // Paper
with:
        ((net.minecraft.server.level.ServerLevel) this.level).getChunkSource().removeLoadedChunk(this); // Paper

file: net/minecraft/world/level/chunk/LevelChunk.java
replace:
        this.level.startTickingChunk(this);
with:
        ((net.minecraft.server.level.ServerLevel) this.level).startTickingChunk(this);

file: net/minecraft/world/level/chunk/LevelChunk.java
count: 2
replace:
    this.level.getSeed()
with:
    ((net.minecraft.server.level.ServerLevel) this.level).getSeed()

# 抽象宣言を public にしたので、上書きしている 2 つも合わせる。
# 可視性だけで、行そのものは同じなので patches/access では 1 つに定まらない
file: net/minecraft/world/level/GameRules.java
replace:
        protected void deserialize(String value) {
            this.value = Boolean.parseBoolean(value);
        }
with:
        public void deserialize(String value) {
            this.value = Boolean.parseBoolean(value);
        }

file: net/minecraft/world/level/GameRules.java
replace:
        protected void deserialize(String value) {
            this.value = safeParse(value);
        }
with:
        public void deserialize(String value) {
            this.value = safeParse(value);
        }

# Paper は HangingEntity.offs を static にして、絵の当たり判定を作るときに
# 型の側から呼ぶ。中身は引数だけで決まるので、static にしても結果は同じ
file: net/minecraft/world/entity/decoration/HangingEntity.java
replace:
    private double offs(int i) {
with:
    private static double offs(int i) {

# Paper は Goal.Flag に UNKNOWN_BEHAVIOR を足す。MobGoalHelper と PaperCustomGoal が
# その名前で分岐する。列挙子は本体の末尾には足せないので、宣言の並びを置き換える。
# 位置は Paper と同じ先頭にする(ordinal を合わせる)。
# vanilla は Goal.Flag の ordinal を保存しないので、足しても記録の互換は変わらない
file: net/minecraft/world/entity/ai/goal/Goal.java
replace:
    public static enum Flag {
        MOVE,
with:
    public static enum Flag {
        UNKNOWN_BEHAVIOR, // Paper - add UNKNOWN_BEHAVIOR
        MOVE,

# Paper のチャンク系が型の側から呼ぶ。中身は引数だけで決まるので static にしても結果は同じ
file: net/minecraft/server/level/ChunkMap.java
replace:
    public ChunkStatus getDependencyStatus(ChunkStatus centerChunkTargetStatus, int distance) {
with:
    public static ChunkStatus getDependencyStatus(ChunkStatus centerChunkTargetStatus, int distance) { // Paper - static

# 親の pollTask を public に広げたので、上書きも合わせる。可視性だけ
file: net/minecraft/server/level/ServerChunkCache.java
replace:
        protected boolean pollTask() {
with:
        public boolean pollTask() {

# PlayerList.respawn(Paper から写した本体)。CraftBukkit の respawn は新しい ServerPlayer を作らず
# 同じオブジェクトを使い回す(entityplayer1 = entityplayer)。vanilla の restoreFrom(自分) は
# recipeBook.copyOverData(自分) で states を clear してから読んで NPE になる(CraftBukkit は
# ServerPlayer.restoreFrom のその 1 行をコメントアウトしている。Shifu の ServerPlayer は vanilla)。
# 別の世界へのテレポート(CraftPlayer.teleport → respawn)が "Failed to teleport entity" で止まっていた。
# 同じオブジェクトなら欄の写しは no-op なので、効果のある分だけ ShifuEvents.restoreSelf で行う。
file: net/minecraft/server/players/PlayerList.java
replace:
        entityplayer1.restoreFrom(entityplayer, flag);
with:
        if (entityplayer1 != entityplayer) { entityplayer1.restoreFrom(entityplayer, flag); } else { dev.shifu.event.ShifuEvents.restoreSelf(entityplayer); } // Shifu
